---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { getCollection } from 'astro:content';
import {
  Terminal,
  Github,
  ExternalLink,
  Cpu,
  Radio,
  Sliders,
  Code2,
  Sparkles,
  Zap,
  Activity,
  Layers,
} from 'lucide-astro';

const allLabProjects = await getCollection('lab');
const projects = allLabProjects.sort((a, b) => a.data.order - b.data.order);

const featuredProject = projects.find(p => p.data.featured);
const regularProjects = projects.filter(p => !p.data.featured);
---

<BaseLayout
  title="Laboratorium Technologiczne & Audio Engineering — Kacper Czeczot"
  description="Inżynieria dźwięku i oprogramowanie sceniczne czasu rzeczywistego: StageSync, silniki WebAudio/WebMIDI, narzędzia analizy partytur."
>
  <!-- Header -->
  <section class="relative pt-36 pb-20 md:pt-44 md:pb-24 overflow-hidden border-b border-[#e2ba64]/15 bg-[#070709]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <SectionHeader
        badge="Inżynieria Dźwięku & Stage Software"
        title="Laboratorium Technologiczne"
        subtitle="Autorskie silniki synchronizacji scenicznej czasu rzeczywistego, narzędzia do analizy partytur i eksperymenty WebAudio / MIDI."
        align="center"
      />
    </div>
  </section>

  <!-- FEATURED PROJECT: STAGESYNC -->
  {featuredProject && (
    <section class="py-24 bg-[#0a0a0e] border-b border-[#e2ba64]/15 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
        
        <div class="theatre-card rounded-3xl p-8 sm:p-12 border border-[#e2ba64]/30 relative overflow-hidden shadow-2xl">
          <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-[#e2ba64]/5 rounded-full blur-3xl pointer-events-none -z-10"></div>

          <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-8 pb-8 border-b border-[#e2ba64]/20">
            <div class="space-y-4 max-w-3xl">
              <div class="flex flex-wrap items-center gap-3">
                <span class="px-4 py-1.5 rounded-full text-xs font-display font-bold uppercase tracking-wider bg-[#070709] text-[#f6d289] border border-[#e2ba64]/40 flex items-center gap-2">
                  <Zap class="w-3.5 h-3.5 text-[#e2ba64]" />
                  Flagowy Projekt Badawczo-Sceniczny
                </span>
                <span class="text-xs font-display uppercase tracking-wider text-zinc-400 px-3.5 py-1.5 rounded-full bg-[#15141a] border border-[#e2ba64]/20">
                  Live Stage Control
                </span>
              </div>

              <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-extrabold text-white">
                {featuredProject.data.title}
              </h2>

              <p class="text-base sm:text-lg text-zinc-300 font-serif leading-relaxed font-light">
                {featuredProject.data.description}
              </p>

              <!-- Tags -->
              <div class="flex flex-wrap gap-2 pt-2">
                {featuredProject.data.tags.map(tag => (
                  <span class="px-3 py-1 rounded-xl bg-[#070709] border border-[#e2ba64]/20 text-xs font-display uppercase tracking-wider text-[#faecd0]">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <!-- Links -->
            <div class="flex flex-wrap sm:flex-col gap-3 flex-shrink-0">
              {featuredProject.data.githubUrl && (
                <a
                  href={featuredProject.data.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-center gap-2.5 px-6 py-3 rounded-2xl bg-[#070709] border border-[#e2ba64]/30 hover:border-[#e2ba64] text-[#faecd0] hover:text-white transition-all font-display text-xs tracking-wider uppercase font-semibold shadow-md"
                >
                  <Github class="w-4 h-4 text-[#e2ba64]" />
                  <span>Repozytorium GitHub</span>
                </a>
              )}
              {featuredProject.data.liveUrl && (
                <a
                  href={featuredProject.data.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-center gap-2.5 px-6 py-3 rounded-2xl bg-gradient-to-r from-[#f6d289] via-[#e2ba64] to-[#c59b41] hover:from-[#faecd0] hover:to-[#e2ba64] text-[#070709] font-display text-xs tracking-wider uppercase font-bold transition-all shadow-gold-glow"
                >
                  <ExternalLink class="w-4 h-4 text-[#070709]" />
                  <span>Uruchom Live Demo</span>
                </a>
              )}
            </div>
          </div>

          <!-- Architecture Highlights -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-8">
            <div class="p-6 rounded-2xl bg-[#070709]/80 border border-[#e2ba64]/20 space-y-2.5">
              <div class="flex items-center gap-2 text-[#f6d289] font-display text-xs font-bold uppercase tracking-wider">
                <Activity class="w-4 h-4 text-[#e2ba64]" />
                <span>Precyzja Czasu Rzeczywistego</span>
              </div>
              <p class="text-xs text-zinc-400 font-sans leading-relaxed">
                Sprzętowy zegar WebAudio z dokładnością sub-milisekundową do eliminacji opóźnień podczas występów orkiestrowych.
              </p>
            </div>

            <div class="p-6 rounded-2xl bg-[#070709]/80 border border-[#e2ba64]/20 space-y-2.5">
              <div class="flex items-center gap-2 text-[#f6d289] font-display text-xs font-bold uppercase tracking-wider">
                <Radio class="w-4 h-4 text-[#e2ba64]" />
                <span>Protokoły MIDI Clock & SPP</span>
              </div>
              <p class="text-xs text-zinc-400 font-sans leading-relaxed">
                Obsługa Song Position Pointer pozwalająca na natychmiastowe przewijanie i synchronizację zewnętrznych DAW i syntezatorów.
              </p>
            </div>

            <div class="p-6 rounded-2xl bg-[#070709]/80 border border-[#e2ba64]/20 space-y-2.5">
              <div class="flex items-center gap-2 text-[#f6d289] font-display text-xs font-bold uppercase tracking-wider">
                <Layers class="w-4 h-4 text-[#e2ba64]" />
                <span>Bezstratna Redundancja</span>
              </div>
              <p class="text-xs text-zinc-400 font-sans leading-relaxed">
                Równoległa praca dwóch stacji roboczych z automatycznym przełączaniem toru audio bez zakłóceń na żywo.
              </p>
            </div>
          </div>

        </div>

      </div>
    </section>
  )}

  <!-- REGULAR LAB PROJECTS GRID -->
  <section class="py-24 bg-[#070709] relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
      
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs font-display font-semibold uppercase tracking-widest text-[#e2ba64]">
          Ekosystem Narzędziowy
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-white">
          Pozostałe Projekty & <span class="text-gold">Narzędzia</span>
        </h2>
        <p class="text-zinc-300 font-serif italic text-base sm:text-lg font-light">
          Narzędzia wspomagające analizę nut, adaptacyjne metronomy oraz biblioteki manipulacji plikami muzycznymi.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {regularProjects.map((proj) => (
          <div class="theatre-card p-8 rounded-3xl border border-[#e2ba64]/20 hover:border-[#e2ba64]/50 transition-all flex flex-col justify-between group shadow-md">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="p-3.5 rounded-2xl bg-[#070709] border border-[#e2ba64]/30 text-[#f6d289] group-hover:scale-110 transition-transform">
                  <Terminal class="w-5 h-5" />
                </span>
                <div class="flex items-center gap-2">
                  {proj.data.githubUrl && (
                    <a
                      href={proj.data.githubUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="p-2.5 rounded-xl bg-[#070709] border border-[#e2ba64]/20 text-zinc-400 hover:text-white hover:border-[#e2ba64] transition-all"
                      aria-label="GitHub"
                    >
                      <Github class="w-4 h-4 text-[#e2ba64]" />
                    </a>
                  )}
                  {proj.data.liveUrl && (
                    <a
                      href={proj.data.liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="p-2.5 rounded-xl bg-[#070709] border border-[#e2ba64]/20 text-zinc-400 hover:text-[#f6d289] hover:border-[#e2ba64] transition-all"
                      aria-label="Live Demo"
                    >
                      <ExternalLink class="w-4 h-4 text-[#e2ba64]" />
                    </a>
                  )}
                </div>
              </div>

              <h3 class="text-2xl font-display font-bold text-white group-hover:text-[#f6d289] transition-colors">
                {proj.data.title}
              </h3>

              <p class="text-sm text-zinc-300 font-serif leading-relaxed text-base font-light">
                {proj.data.description}
              </p>

              <div class="flex flex-wrap gap-2 pt-2">
                {proj.data.tags.map(tag => (
                  <span class="px-3 py-1 rounded-lg bg-[#070709] border border-[#e2ba64]/20 text-[10px] font-display uppercase tracking-wider text-zinc-300">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <div class="pt-6 mt-6 border-t border-[#e2ba64]/15 flex items-center justify-between text-xs font-display uppercase tracking-wider font-semibold text-[#e2ba64] group-hover:text-[#f6d289]">
              <span>Moduł inżynieryjny</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>
</BaseLayout>
