---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { getCollection } from 'astro:content';
import {
  Terminal,
  Radio,
  Sliders,
  Code2,
  Sparkles,
  Zap,
  Activity,
  Layers,
  Smartphone,
  Wifi,
} from 'lucide-astro';

const allLabProjects = await getCollection('lab');
const featuredProject = allLabProjects.find(p => p.data.featured) || allLabProjects[0];
---

<BaseLayout
  title="StageSync — Inżynieria Dźwięku & Stage Software — Kacper Czeczot"
  description="Autorski system synchronizacji scenicznej StageSync: transport MIDI Clock + SPP, role wykonawcze dla muzyków, wykrywanie mDNS w sieci LAN."
>
  <!-- Header -->
  <section class="relative pt-36 pb-20 md:pt-44 md:pb-24 overflow-hidden border-b border-sky-500/15 bg-[#070d1a]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <SectionHeader
        badge="Inżynieria Sceniczna & Oprogramowanie Live"
        title="Laboratorium Technologiczne"
        subtitle="Autorski system synchronizacji scenicznej StageSync dedykowany do obsługi występów live."
        align="center"
      />
    </div>
  </section>

  <!-- FEATURED PROJECT: STAGESYNC -->
  {featuredProject && (
    <section class="py-24 bg-[#091224] relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
        
        <div class="ocean-card rounded-3xl p-8 sm:p-12 border border-sky-500/25 relative overflow-hidden shadow-ocean-card">
          <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-sky-500/5 rounded-full blur-3xl pointer-events-none -z-10"></div>

          <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-8 pb-8 border-b border-sky-500/15">
            <div class="space-y-4 max-w-3xl">
              <div class="flex flex-wrap items-center gap-3">
                <span class="px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-[#070d1a] text-sky-300 border border-sky-400/30 flex items-center gap-2 font-display">
                  <Zap class="w-3.5 h-3.5 text-sky-400" />
                  Projekt Autorski
                </span>
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-300 px-3.5 py-1.5 rounded-full bg-[#0f1d38] border border-sky-500/20 font-display">
                  Live Stage Control
                </span>
              </div>

              <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-extrabold text-white">
                {featuredProject.data.title}
              </h2>

              <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-sans">
                {featuredProject.data.description}
              </p>

              <!-- Tags -->
              <div class="flex flex-wrap gap-2 pt-2">
                {featuredProject.data.tags.map(tag => (
                  <span class="px-3.5 py-1.5 rounded-xl bg-[#070d1a] border border-sky-500/20 text-xs font-semibold text-sky-200 font-display shadow-xs">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Architecture Highlights -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 pt-8">
            <div class="p-6 rounded-2xl bg-[#070d1a]/80 border border-sky-500/20 space-y-2.5 shadow-xs">
              <div class="flex items-center gap-2 text-sky-300 font-display text-xs font-bold uppercase tracking-wider">
                <Wifi class="w-4 h-4 text-sky-400" />
                <span>Serwer + Mobile / mDNS</span>
              </div>
              <p class="text-xs text-slate-300 font-sans leading-relaxed">
                Centralny węzeł sterujący z automatycznym wykrywaniem paneli wykonawczych w lokalnej sieci Wi-Fi (mDNS).
              </p>
            </div>

            <div class="p-6 rounded-2xl bg-[#070d1a]/80 border border-sky-500/20 space-y-2.5 shadow-xs">
              <div class="flex items-center gap-2 text-sky-300 font-display text-xs font-bold uppercase tracking-wider">
                <Radio class="w-4 h-4 text-sky-400" />
                <span>MIDI Clock & SPP</span>
              </div>
              <p class="text-xs text-slate-300 font-sans leading-relaxed">
                Precyzyjny transport MIDI Clock z Song Position Pointer do natychmiastowej synchronizacji pozycji utworu.
              </p>
            </div>

            <div class="p-6 rounded-2xl bg-[#070d1a]/80 border border-sky-500/20 space-y-2.5 shadow-xs">
              <div class="flex items-center gap-2 text-sky-300 font-display text-xs font-bold uppercase tracking-wider">
                <Smartphone class="w-4 h-4 text-sky-400" />
                <span>Role dla Muzyków</span>
              </div>
              <p class="text-xs text-slate-300 font-sans leading-relaxed">
                Dedykowane widoki paneli dla poszczególnych muzyków: tekst z akordami, partytura oraz metronom perkusyjny.
              </p>
            </div>

            <div class="p-6 rounded-2xl bg-[#070d1a]/80 border border-sky-500/20 space-y-2.5 shadow-xs">
              <div class="flex items-center gap-2 text-sky-300 font-display text-xs font-bold uppercase tracking-wider">
                <Layers class="w-4 h-4 text-sky-400" />
                <span>Format Paczek .stagesync</span>
              </div>
              <p class="text-xs text-slate-300 font-sans leading-relaxed">
                Wygodny import i eksport kompletnych setlist koncertowych oraz mechanizm automatycznych kopii zapasowych.
              </p>
            </div>
          </div>

        </div>

      </div>
    </section>
  )}
</BaseLayout>
