---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { getCollection } from 'astro:content';
import {
  Terminal,
  Github,
  ExternalLink,
  Radio,
  Sliders,
  Code2,
  Sparkles,
  Zap,
  Activity,
  Layers,
} from 'lucide-astro';

const allLabProjects = await getCollection('lab');
const projects = allLabProjects.sort((a, b) => a.data.order - b.data.order);

const featuredProject = projects.find(p => p.data.featured);
const regularProjects = projects.filter(p => !p.data.featured);
---

<BaseLayout
  title="Laboratorium Technologiczne & Audio Engineering — Kacper Czeczot"
  description="Inżynieria dźwięku i oprogramowanie sceniczne czasu rzeczywistego: StageSync, silniki WebAudio/WebMIDI, narzędzia analizy partytur."
>
  <!-- Header -->
  <section class="relative pt-36 pb-20 md:pt-44 md:pb-24 overflow-hidden border-b border-slate-200 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <SectionHeader
        badge="Inżynieria Dźwięku & Stage Software"
        title="Laboratorium Technologiczne"
        subtitle="Autorskie silniki synchronizacji scenicznej czasu rzeczywistego, narzędzia do analizy partytur i eksperymenty WebAudio / MIDI."
        align="center"
      />
    </div>
  </section>

  <!-- FEATURED PROJECT: STAGESYNC -->
  {featuredProject && (
    <section class="py-24 bg-slate-50 border-b border-slate-200 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
        
        <div class="azure-card rounded-3xl p-8 sm:p-12 border border-slate-200 relative overflow-hidden shadow-card">
          <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-sky-100/50 rounded-full blur-3xl pointer-events-none -z-10"></div>

          <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-8 pb-8 border-b border-slate-100">
            <div class="space-y-4 max-w-3xl">
              <div class="flex flex-wrap items-center gap-3">
                <span class="px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-sky-50 text-sky-700 border border-sky-200 flex items-center gap-2 font-display">
                  <Zap class="w-3.5 h-3.5 text-sky-600" />
                  Projekt Badawczo-Sceniczny
                </span>
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 px-3.5 py-1.5 rounded-full bg-slate-100 border border-slate-200 font-display">
                  Live Stage Control
                </span>
              </div>

              <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-extrabold text-slate-900">
                {featuredProject.data.title}
              </h2>

              <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-sans">
                {featuredProject.data.description}
              </p>

              <!-- Tags -->
              <div class="flex flex-wrap gap-2 pt-2">
                {featuredProject.data.tags.map(tag => (
                  <span class="px-3 py-1 rounded-xl bg-white border border-slate-200 text-xs font-semibold text-slate-700 font-display shadow-xs">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <!-- Links -->
            <div class="flex flex-wrap sm:flex-col gap-3 flex-shrink-0">
              {featuredProject.data.githubUrl && (
                <a
                  href={featuredProject.data.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-center gap-2.5 px-6 py-3 rounded-2xl bg-white border border-slate-200 hover:border-sky-400 text-slate-800 hover:text-sky-600 transition-all font-display text-xs tracking-wider uppercase font-semibold shadow-xs"
                >
                  <Github class="w-4 h-4 text-sky-600" />
                  <span>Repozytorium GitHub</span>
                </a>
              )}
            </div>
          </div>

          <!-- Architecture Highlights -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-8">
            <div class="p-6 rounded-2xl bg-white border border-slate-200 space-y-2.5 shadow-xs">
              <div class="flex items-center gap-2 text-sky-700 font-display text-xs font-bold uppercase tracking-wider">
                <Activity class="w-4 h-4 text-sky-600" />
                <span>Precyzja Czasu Rzeczywistego</span>
              </div>
              <p class="text-xs text-slate-600 font-sans leading-relaxed">
                Sprzętowy zegar WebAudio z dokładnością sub-milisekundową do eliminacji opóźnień podczas występów na żywo.
              </p>
            </div>

            <div class="p-6 rounded-2xl bg-white border border-slate-200 space-y-2.5 shadow-xs">
              <div class="flex items-center gap-2 text-sky-700 font-display text-xs font-bold uppercase tracking-wider">
                <Radio class="w-4 h-4 text-sky-600" />
                <span>Protokoły MIDI Clock & SPP</span>
              </div>
              <p class="text-xs text-slate-600 font-sans leading-relaxed">
                Obsługa Song Position Pointer pozwalająca na natychmiastowe przewijanie i synchronizację zewnętrznych urządzeń.
              </p>
            </div>

            <div class="p-6 rounded-2xl bg-white border border-slate-200 space-y-2.5 shadow-xs">
              <div class="flex items-center gap-2 text-sky-700 font-display text-xs font-bold uppercase tracking-wider">
                <Layers class="w-4 h-4 text-sky-600" />
                <span>Bezstratna Redundancja</span>
              </div>
              <p class="text-xs text-slate-600 font-sans leading-relaxed">
                Równoległa praca dwóch stacji roboczych z automatycznym przełączaniem toru audio bez zakłóceń na żywo.
              </p>
            </div>
          </div>

        </div>

      </div>
    </section>
  )}

  <!-- REGULAR LAB PROJECTS GRID -->
  <section class="py-24 bg-white relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
      
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs font-semibold uppercase tracking-wider text-sky-700 font-display">
          Ekosystem Narzędziowy
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-slate-900">
          Pozostałe Projekty & <span class="text-azure">Narzędzia</span>
        </h2>
        <p class="text-slate-600 text-base sm:text-lg font-normal">
          Narzędzia wspomagające analizę nut, adaptacyjne metronomy oraz biblioteki manipulacji plikami muzycznymi.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {regularProjects.map((proj) => (
          <div class="azure-card p-8 rounded-3xl border border-slate-200 hover:border-sky-300 transition-all flex flex-col justify-between group shadow-card">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="p-3.5 rounded-2xl bg-sky-50 border border-sky-100 text-sky-600 group-hover:scale-110 group-hover:bg-sky-600 group-hover:text-white transition-all">
                  <Terminal class="w-5 h-5" />
                </span>
                <div class="flex items-center gap-2">
                  {proj.data.githubUrl && (
                    <a
                      href={proj.data.githubUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="p-2.5 rounded-xl bg-slate-100 border border-slate-200 text-slate-600 hover:text-sky-600 hover:border-sky-300 transition-all"
                      aria-label="GitHub"
                    >
                      <Github class="w-4 h-4" />
                    </a>
                  )}
                </div>
              </div>

              <h3 class="text-2xl font-display font-bold text-slate-900 group-hover:text-sky-600 transition-colors">
                {proj.data.title}
              </h3>

              <p class="text-sm text-slate-600 font-sans leading-relaxed">
                {proj.data.description}
              </p>

              <div class="flex flex-wrap gap-2 pt-2">
                {proj.data.tags.map(tag => (
                  <span class="px-3 py-1 rounded-lg bg-slate-100 border border-slate-200 text-xs font-semibold text-slate-700 font-display">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <div class="pt-6 mt-6 border-t border-slate-100 flex items-center justify-between text-xs uppercase tracking-wider font-bold text-sky-600 group-hover:text-sky-700">
              <span>Moduł inżynieryjny</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>
</BaseLayout>
