---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import {
  GraduationCap,
  Music,
  Piano,
  Mic2,
  Sliders,
  FileCode2,
  Award,
  BookOpen,
  Sparkles,
  Layers,
  CheckCircle2,
  AudioWaveform,
} from 'lucide-astro';

const education = [
  {
    period: 'Studia Wyższe Magisterskie',
    institution: 'Uniwersytet Warmińsko-Mazurski w Olsztynie',
    degree: 'Dyplom z Wyróżnieniem',
    specialization: 'Edukacja Artystyczna w Zakresie Sztuki Muzycznej — Dyrygentura',
    highlights: [
      'Główny dyplom dyrygencki z orkiestrą symfoniczną i chórem mieszanym w Filharmonii Warmińsko-Mazurskiej',
      'Prowadzenie zespołów wokalnych, chóralnych i orkiestrowych',
    ],
  },
  {
    period: 'Szkoła Muzyczna II Stopnia',
    institution: 'Państwowa Szkoła Muzyczna II st.',
    degree: 'Dyplom Muzyka Instrumentalisty',
    specialization: 'Klarnet & Fortepian',
    highlights: [
      'Wykonawstwo instrumentalne w klasie klarnetu i fortepianu',
      'Praktyka w zespołach orkiestrowych i kameralnych',
    ],
  },
  {
    period: 'Szkoła Muzyczna I Stopnia',
    institution: 'Państwowa Szkoła Muzyczna I st.',
    degree: 'Świadectwo Ukończenia',
    specialization: 'Klarnet & Fortepian',
    highlights: [
      'Podstawy wykonawstwa instrumentalnego i teorii muzyki',
    ],
  },
];

const mainInstruments = [
  {
    name: 'Dyrygentura',
    category: 'Dyscyplina Główna',
    desc: 'Kierownictwo muzyczne i prowadzenie orkiestr oraz chórów.',
    icon: Sparkles,
  },
  {
    name: 'Klarnet',
    category: 'Instrument Główny',
    desc: 'Wykonawstwo solowe, kameralne oraz orkiestrowe.',
    icon: Music,
  },
  {
    name: 'Fortepian',
    category: 'Instrument Główny',
    desc: 'Wykonawstwo instrumentalne i praca z partyturą.',
    icon: Piano,
  },
  {
    name: 'Śpiew / Wokal',
    category: 'Głos',
    desc: 'Śpiew solowy, spektakle muzyczne oraz partie chóralne (tenor).',
    icon: Mic2,
  },
];

const additionalInstruments = [
  {
    name: 'Organy Liturgiczne',
    desc: 'Akompaniament liturgiczny i oprawa uroczystości.',
  },
  {
    name: 'Perkusja / Kotły',
    desc: 'Instrumentarium perkusyjne w składach orkiestrowych.',
  },
];
---

<BaseLayout
  title="Bio & Edukacja — Kacper Czeczot"
  description="Sylwetka artystyczna dyrygenta i muzyka Kacpra Czeczota: wykształcenie muzyczne UWM z wyróżnieniem, PSM I i II st. oraz instrumentarium."
>
  <!-- Page Header -->
  <section class="relative pt-36 pb-20 md:pt-44 md:pb-24 overflow-hidden border-b border-sky-500/15 bg-[#070d1a]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <SectionHeader
        badge="Sylwetka & Doświadczenie"
        title="Bio & Edukacja"
        subtitle="Wykształcenie dyrygenckie, wykonawstwo instrumentalne oraz działalność sceniczna."
        align="center"
      />
    </div>
  </section>

  <!-- 1. ARTISTIC BIOGRAPHY -->
  <section class="py-24 bg-[#091224] border-b border-sky-500/15 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider bg-[#0f1d38] text-sky-200 border border-sky-400/30 font-display">
            <BookOpen class="w-3.5 h-3.5 text-sky-400" />
            <span>Biogram</span>
          </div>

          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-white leading-tight">
            Dyrygentura, wykonawstwo instrumentalne i scena
          </h2>

          <div class="space-y-4 text-slate-300 font-sans leading-relaxed text-base sm:text-lg">
            <p>
              Wykształcenie muzyczne w Państwowych Szkołach Muzycznych I i II stopnia w klasie klarnetu i fortepianu oraz na Uniwersytecie Warmińsko-Mazurskim w Olsztynie, ukończone dyplomem z wyróżnieniem w specjalności dyrygenckiej.
            </p>
            <p>
              Działalność sceniczna obejmuje ponad <strong class="text-sky-300 font-semibold">300 występów</strong> w ramach orkiestr dętych, chórów, spektakli teatralnych, musicalu oraz formacji estradowych.
            </p>
          </div>

          <div class="pt-3 flex flex-wrap gap-4 text-xs font-bold uppercase tracking-wider text-slate-300 font-display">
            <span class="flex items-center gap-2"><CheckCircle2 class="w-4 h-4 text-sky-400" /> Dyrygentura orkiestr i chórów</span>
            <span class="flex items-center gap-2"><CheckCircle2 class="w-4 h-4 text-sky-400" /> Klarnet i fortepian</span>
            <span class="flex items-center gap-2"><CheckCircle2 class="w-4 h-4 text-sky-400" /> Śpiew i teatr muzyczny</span>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="ocean-card p-8 rounded-3xl border border-sky-500/25 space-y-6 relative overflow-hidden shadow-ocean-card">
            <div class="flex items-center justify-between border-b border-sky-500/15 pb-4">
              <span class="font-display font-bold text-lg text-white">Obszary Działalności</span>
              <span class="text-xs font-bold uppercase tracking-wider text-sky-400 font-display">Fakty</span>
            </div>

            <div class="space-y-3.5 text-xs text-slate-300">
              <div class="p-4 rounded-2xl bg-[#070d1a] border border-sky-500/20 space-y-1 shadow-xs">
                <span class="text-sky-300 font-display font-bold uppercase tracking-wider block">DYRYGENTURA</span>
                <span class="text-slate-400 text-xs">Prowadzenie orkiestr dętych, symfonicznych i chórów.</span>
              </div>
              <div class="p-4 rounded-2xl bg-[#070d1a] border border-sky-500/20 space-y-1 shadow-xs">
                <span class="text-slate-200 font-display font-bold uppercase tracking-wider block">WYKONAWSTWO INSTRUMENTALNE & ŚPIEW</span>
                <span class="text-slate-400 text-xs">Klarnet, fortepian, śpiew sceniczny i chóralny, organy.</span>
              </div>
              <div class="p-4 rounded-2xl bg-[#070d1a] border border-sky-500/20 space-y-1 shadow-xs">
                <span class="text-sky-400 font-display font-bold uppercase tracking-wider block">PRODUKCJA & ARANŻACJE</span>
                <span class="text-slate-400 text-xs">Aranżacje partytur oraz realizacja dźwięku.</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. EDUCATION & QUALIFICATIONS TIMELINE -->
  <section class="py-24 bg-[#070d1a] border-b border-sky-500/15 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
      
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs font-semibold uppercase tracking-wider text-sky-400 font-display">
          Kwalifikacje
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-white">
          Edukacja <span class="text-blue-gradient">Muzyczna</span>
        </h2>
      </div>

      <div class="space-y-6 max-w-4xl mx-auto">
        {education.map((item) => (
          <div class="ocean-card rounded-3xl p-7 sm:p-9 border border-sky-500/20 hover:border-sky-400/50 transition-all relative group shadow-ocean-card">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-sky-500/15">
              <div class="space-y-1">
                <span class="text-xs font-bold uppercase tracking-wider text-sky-400 font-display">
                  {item.period}
                </span>
                <h3 class="text-xl sm:text-2xl font-display font-bold text-white group-hover:text-sky-300 transition-colors">
                  {item.institution}
                </h3>
              </div>
              <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-[#070d1a] text-sky-300 border border-sky-400/30 self-start sm:self-auto font-display">
                <Award class="w-3.5 h-3.5 text-sky-400" />
                {item.degree}
              </span>
            </div>

            <div class="pt-5 space-y-3.5">
              <p class="text-sm font-semibold uppercase tracking-wider text-slate-200 font-display">
                Specjalność: <span class="text-slate-300 font-normal font-sans normal-case">{item.specialization}</span>
              </p>
              <ul class="space-y-2 text-sm text-slate-300 font-sans">
                {item.highlights.map(h => (
                  <li class="flex items-start gap-2.5">
                    <span class="text-sky-400 mt-1">•</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 3. INSTRUMENTARIUM -->
  <section class="py-24 bg-[#091224] relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
      
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs font-semibold uppercase tracking-wider text-sky-400 font-display">
          Dyscypliny & Instrumentarium
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-white">
          Praktyka <span class="text-blue-gradient">Wykonawcza</span>
        </h2>
      </div>

      <!-- Main Instruments Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {mainInstruments.map((inst) => {
          const Icon = inst.icon;
          return (
            <div class="ocean-card p-7 rounded-3xl border border-sky-500/20 hover:border-sky-400/50 flex flex-col justify-between group hover:-translate-y-1.5 transition-all shadow-ocean-card">
              <div class="space-y-4">
                <div class="w-12 h-12 rounded-2xl bg-[#070d1a] border border-sky-400/25 text-sky-400 flex items-center justify-center group-hover:scale-110 group-hover:bg-sky-500 group-hover:text-white transition-all">
                  <Icon class="w-6 h-6" />
                </div>
                <div>
                  <span class="text-[11px] font-bold uppercase tracking-wider text-sky-300 block mb-1 font-display">
                    {inst.category}
                  </span>
                  <h3 class="text-xl font-display font-bold text-white group-hover:text-sky-300 transition-colors">
                    {inst.name}
                  </h3>
                </div>
                <p class="text-xs text-slate-300 leading-relaxed font-sans">
                  {inst.desc}
                </p>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Additional Instruments Box -->
      <div class="ocean-card p-8 sm:p-10 rounded-3xl border border-sky-500/20 max-w-5xl mx-auto shadow-ocean-card">
        <h3 class="text-xs font-bold uppercase tracking-wider text-white mb-6 flex items-center gap-2.5 font-display">
          <Layers class="w-4 h-4 text-sky-400" />
          <span>Instrumentarium Dodatkowe</span>
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {additionalInstruments.map((item) => (
            <div class="p-5 rounded-2xl bg-[#070d1a] border border-sky-500/20 space-y-1.5 shadow-xs">
              <h4 class="text-sm font-bold text-white font-display">{item.name}</h4>
              <p class="text-xs text-slate-300 font-sans leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
