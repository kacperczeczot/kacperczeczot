---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import {
  GraduationCap,
  Music,
  Piano,
  Mic2,
  Sliders,
  FileCode2,
  Award,
  BookOpen,
  Sparkles,
  Layers,
  CheckCircle2,
  Cpu,
  AudioWaveform,
  Disc3,
} from 'lucide-astro';

const education = [
  {
    period: 'Studia Wyższe Magisterskie',
    institution: 'Uniwersytet Warmińsko-Mazurski w Olsztynie',
    degree: 'Dyplom z Wyróżnieniem',
    specialization: 'Edukacja Artystyczna w Zakresie Sztuki Muzycznej / Dyrygentura i Prowadzenie Zespołów',
    highlights: [
      'Główny dyplom dyrygencki z orkiestrą symfoniczną i chórem mieszanym (ocena celująca z wyróżnieniem)',
      'Specjalizacja w zakresie metodyki prowadzenia chórów, orkiestr dętych i zespołów kameralnych',
      'Aktywna działalność w strukturach artystycznych uczelni oraz kierownictwo biblioteki nutowej',
    ],
  },
  {
    period: 'Państwowa Szkoła Muzyczna II Stopnia',
    institution: 'PSM II st. im. Fryderyka Chopina',
    degree: 'Dyplom Zawodowego Muzyka Instrumentalisty',
    specialization: 'Klasa Klarnetu & Fortepian Dodatkowy',
    highlights: [
      'Kompleksowe wykształcenie w zakresie literatury klarnetowej od klasycyzmu po wiek XX',
      'Praktyka w orkiestrze symfonicznej szkoły muzycznej oraz zespołach kameralnych dętych',
      'Harmonia klasyczna, kontrapunkt, kształcenie słuchu i analiza dzieła muzycznego',
    ],
  },
  {
    period: 'Państwowa Szkoła Muzyczna I Stopnia',
    institution: 'PSM I st.',
    degree: 'Świadectwo Ukończenia z Wyróżnieniem',
    specialization: 'Klasa Klarnetu & Fortepian',
    highlights: [
      'Fundamenty aparatu gry na klarnecie, intonacji i techniki palcowej',
      'Występy estradowe, konkursy regionalne i pierwsze doświadczenia orkiestrowe',
    ],
  },
];

const mainInstruments = [
  {
    name: 'Dyrygentura',
    category: 'Główna Dyscyplina',
    desc: 'Kierowanie aparatem symfonicznym, orkiestrami dętymi i chórami. Praca nad intonacją, agogiką, dynamiką i wyrazem dramaturgicznym partytury.',
    icon: Sparkles,
    accent: 'border-amber-500/40 text-amber-400',
  },
  {
    name: 'Klarnet (B & A)',
    category: 'Instrument Główny',
    desc: 'Klasyczny aparat wykonawczy, technika biegłościowa, partie solowe oraz orkiestrowe w repertuarze symfonicznym i kameralnym.',
    icon: Music,
    accent: 'border-sky-500/40 text-sky-400',
  },
  {
    name: 'Fortepian',
    category: 'Instrument Główny',
    desc: 'Baza harmoniczna, czytanie partytur fortepianowych i wyciągów orkiestrowych a vista, akompaniament chóralny i solowy.',
    icon: Piano,
    accent: 'border-fuchsia-500/40 text-fuchsia-400',
  },
  {
    name: 'Śpiew / Wokal (Tenor)',
    category: 'Głos Solowy & Chóralny',
    desc: 'Klasyczna emisja głosu, role solowe w operetkach i musicalach, wielogłosowa polifonia dawna oraz techniki studyjne.',
    icon: Mic2,
    accent: 'border-rose-500/40 text-rose-400',
  },
];

const additionalInstruments = [
  {
    name: 'Organy Liturgiczne & Piszczałkowe',
    desc: 'Akompaniament liturgiczny, improwizacja modalna, obsługa manuałów i pedału w obiektach sakralnych.',
  },
  {
    name: 'Perkusja & Kotły Symfoniczne',
    desc: 'Precyzja rytmiczna, technika gry na kotłach symfonicznych w orkiestrze, instrumentarium perkusyjne estrady.',
  },
  {
    name: 'Syntezatory & Klawisze MIDI',
    desc: 'Sterowniki MIDI, programowanie barw syntetycznych, integracja warstw cyfrowych w zespole live.',
  },
];

const studioWorkflows = [
  {
    category: 'Partytury & Notacja',
    software: ['MuseScore 4', 'Sibelius', 'MusicXML / LilyPond'],
    desc: 'Kompleksowe przygotowanie czytelnych głosów orkiestrowych, aranżacje symfoniczne, transkrypcje wielogłosowe i edycja partytur do druku.',
    icon: FileCode2,
  },
  {
    category: 'Produkcja Audio & Miks',
    software: ['Logic Pro', 'Pro Tools', 'Reaper', 'Universal Audio UAD'],
    desc: 'Wielośladowy zapis sesyjny, edycja intonacji (Melodyne), nasycenie analogowe, miks przestrzenny i mastering zgodny ze standardami emisyjnymi.',
    icon: Sliders,
  },
  {
    category: 'Sprzęt & Akustyka',
    software: ['Mikrofony Neumann / AKG', 'Preamps Heritage / UA', 'Kalibracja Sonarworks'],
    desc: 'Techniki mikrofonowe stereo (ORTF, Blumlein, MS), adaptacja akustyczna pomieszczeń i tor odsłuchowy o liniowej charakterystyce.',
    icon: AudioWaveform,
  },
];
---

<BaseLayout
  title="Bio, Kwalifikacje & Warsztat — Kacper"
  description="Sylwetka artystyczna dyrygenta i instrumentalisty: edukacja muzyczna na UWM z wyróżnieniem, PSM I i II stopnia, instrumentarium oraz zaplecze studyjno-aranżacyjne."
  accent="amber"
>
  <!-- Page Header -->
  <section class="relative pt-32 pb-16 md:pt-40 md:pb-20 overflow-hidden border-b border-zinc-800/80 bg-zinc-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <SectionHeader
        badge="Sylwetka & Doświadczenie"
        title="Bio, Edukacja & Warsztat Twórczy"
        subtitle="Droga artystyczna ukształtowana przez akademicką dyscyplinę dyrygencką, wszechstronne wykonawstwo instrumentalne oraz profesjonalną inżynierię dźwięku."
        align="center"
        accent="amber"
      />
    </div>
  </section>

  <!-- 1. ARTISTIC BIOGRAPHY -->
  <section class="py-20 bg-zinc-950/70 border-b border-zinc-800/80 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-bold uppercase tracking-wider bg-amber-500/10 text-amber-400 border border-amber-500/30">
            <BookOpen class="w-3.5 h-3.5" />
            <span>Biogram Artystyczny</span>
          </div>

          <h2 class="text-3xl sm:text-4xl font-display font-bold text-zinc-100 leading-tight">
            Od partytury symfonicznej po cyfrową architekturę dźwięku
          </h2>

          <div class="space-y-4 text-zinc-300 text-sm sm:text-base leading-relaxed font-sans">
            <p>
              Działalność muzyczną rozpocząłem od wczesnych lat szkolnych w klasie klarnetu i fortepianu, by z biegiem lat rozszerzyć horyzont o dyrygenturę symfoniczno-chóralną, śpiew sceniczny oraz zaawansowaną produkcję studyjną.
            </p>
            <p>
              Przez ponad 20 lat praktyki artystycznej wziąłem udział w ponad <strong class="text-amber-300">300 koncertach i spektaklach</strong> w kraju i za granicą. Kierowałem orkiestrami dętymi, przygotowywałem chóry do wielkich dzieł oratoryjnych, kreowałem role w spektaklach operetkowych i musicalowych, a także współtworzyłem energetyczne formacje estradowe.
            </p>
            <p class="text-zinc-400">
              Równolegle rozwijam pasję do technologii i inżynierii dźwięku — tworząc autorskie aranżacje partytur w środowiskach cyfrowych, realizując nagrania wielośladowe oraz projektując oprogramowanie sceniczne wspierające synchronizację występów live.
            </p>
          </div>

          <div class="pt-2 flex flex-wrap gap-4 text-xs font-mono text-zinc-400">
            <span class="flex items-center gap-1.5"><CheckCircle2 class="w-4 h-4 text-amber-400" /> Dyrygentura orkiestr i chórów</span>
            <span class="flex items-center gap-1.5"><CheckCircle2 class="w-4 h-4 text-amber-400" /> Aranżacja i edycja nutowa</span>
            <span class="flex items-center gap-1.5"><CheckCircle2 class="w-4 h-4 text-amber-400" /> Realizacja nagrań i miks DAW</span>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="glass-card p-6 sm:p-8 rounded-3xl border border-zinc-800 space-y-6 relative overflow-hidden shadow-2xl">
            <div class="flex items-center justify-between border-b border-zinc-800 pb-4">
              <span class="font-display font-bold text-lg text-zinc-100">Kluczowe Obszary</span>
              <span class="text-xs font-mono text-amber-400">Praktyka 360°</span>
            </div>

            <div class="space-y-4 text-xs font-mono text-zinc-300">
              <div class="p-3.5 rounded-2xl bg-zinc-900/80 border border-zinc-800">
                <span class="text-amber-400 font-bold block mb-1">DYRYGENTURA & APARAT WYKONAWCZY</span>
                <span class="text-zinc-400">Prowadzenie orkiestr symfonicznych, dętych i chórów mieszanych z naciskiem na spójność brzmieniową.</span>
              </div>
              <div class="p-3.5 rounded-2xl bg-zinc-900/80 border border-zinc-800">
                <span class="text-sky-400 font-bold block mb-1">WYKONAWSWO INSTRUMENTALNE & WOKALNE</span>
                <span class="text-zinc-400">Klarnet (B/A), fortepian, partie wokalne (tenor solowy/ansambl), organy liturgiczne.</span>
              </div>
              <div class="p-3.5 rounded-2xl bg-zinc-900/80 border border-zinc-800">
                <span class="text-cyan-400 font-bold block mb-1">PRODUKCJA STUDYJNA & SOFTWARE</span>
                <span class="text-zinc-400">Realizacja wielośladowa w Logic Pro / Pro Tools, transkrypcje MuseScore oraz silniki WebAudio/MIDI.</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. EDUCATION & QUALIFICATIONS TIMELINE -->
  <section class="py-20 bg-zinc-950 border-b border-zinc-800/80 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs font-mono font-semibold uppercase tracking-widest text-amber-400">
          Ścieżka Akademicka & Kwalifikacje
        </span>
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-zinc-100">
          Edukacja Muzyczna
        </h2>
        <p class="text-zinc-400 text-sm sm:text-base">
          Solidny fundament wykształcenia artystycznego poparty dyplomami z wyróżnieniem.
        </p>
      </div>

      <div class="space-y-6 max-w-4xl mx-auto">
        {education.map((item, idx) => (
          <div class="glass-card rounded-3xl p-6 sm:p-8 border border-zinc-800/80 hover:border-amber-500/40 transition-all relative group">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-zinc-800/80">
              <div class="space-y-1">
                <span class="text-xs font-mono font-bold uppercase tracking-wider text-amber-400">
                  {item.period}
                </span>
                <h3 class="text-xl sm:text-2xl font-display font-bold text-zinc-100 group-hover:text-amber-300 transition-colors">
                  {item.institution}
                </h3>
              </div>
              <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-mono font-bold bg-amber-500/10 text-amber-300 border border-amber-500/30 self-start sm:self-auto">
                <Award class="w-3.5 h-3.5" />
                {item.degree}
              </span>
            </div>

            <div class="pt-4 space-y-3">
              <p class="text-sm font-semibold text-zinc-300">
                Kierunek / Specjalność: <span class="text-zinc-100 font-normal">{item.specialization}</span>
              </p>
              <ul class="space-y-2 text-xs sm:text-sm text-zinc-400">
                {item.highlights.map(h => (
                  <li class="flex items-start gap-2">
                    <span class="text-amber-400 mt-1">•</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 3. INSTRUMENTARIUM -->
  <section class="py-20 bg-zinc-950/70 border-b border-zinc-800/80 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs font-mono font-semibold uppercase tracking-widest text-amber-400">
          Praktyka Wykonawcza
        </span>
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-zinc-100">
          Instrumentarium & Kompetencje
        </h2>
        <p class="text-zinc-400 text-sm sm:text-base">
          Główne filary warsztatu instrumentalnego, wokalnego i dyrygenckiego.
        </p>
      </div>

      <!-- Main Instruments Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {mainInstruments.map((inst) => {
          const Icon = inst.icon;
          return (
            <div class={`glass-card p-6 rounded-3xl border ${inst.accent} flex flex-col justify-between group hover:-translate-y-1 transition-all`}>
              <div class="space-y-4">
                <div class="w-12 h-12 rounded-2xl bg-zinc-900 border border-zinc-800 flex items-center justify-center group-hover:scale-110 transition-transform">
                  <Icon class="w-6 h-6" />
                </div>
                <div>
                  <span class="text-[10px] font-mono uppercase tracking-wider text-zinc-400 block mb-1">
                    {inst.category}
                  </span>
                  <h3 class="text-xl font-display font-bold text-zinc-100 group-hover:text-amber-300 transition-colors">
                    {inst.name}
                  </h3>
                </div>
                <p class="text-xs text-zinc-400 leading-relaxed font-sans">
                  {inst.desc}
                </p>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Additional Instruments Box -->
      <div class="glass-card p-8 rounded-3xl border border-zinc-800 max-w-5xl mx-auto">
        <h3 class="text-sm font-mono font-bold uppercase tracking-wider text-zinc-300 mb-6 flex items-center gap-2">
          <Layers class="w-4 h-4 text-amber-400" />
          <span>Instrumentarium Dodatkowe & Konteksty Wykonawcze</span>
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {additionalInstruments.map((item) => (
            <div class="p-4 rounded-2xl bg-zinc-900/60 border border-zinc-800/80 space-y-1.5">
              <h4 class="text-sm font-display font-bold text-zinc-200">{item.name}</h4>
              <p class="text-xs text-zinc-400 leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- 4. STUDIO, ARANŻACJE & PARTYTURY -->
  <section class="py-20 bg-zinc-950 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs font-mono font-semibold uppercase tracking-widest text-cyan-400">
          Środowisko Pracy
        </span>
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-zinc-100">
          Studio, Partytury & Realizacja Dźwięku
        </h2>
        <p class="text-zinc-400 text-sm sm:text-base">
          Nowoczesne oprogramowanie i technologia wspierająca proces od pierwszej nuty partytury do finalnego masteringu.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {studioWorkflows.map((item) => {
          const Icon = item.icon;
          return (
            <div class="glass-card p-8 rounded-3xl border border-zinc-800 hover:border-cyan-500/40 transition-all flex flex-col justify-between group">
              <div class="space-y-4">
                <div class="w-12 h-12 rounded-2xl bg-zinc-900 border border-zinc-800 text-cyan-400 flex items-center justify-center group-hover:scale-110 transition-transform">
                  <Icon class="w-6 h-6" />
                </div>
                <h3 class="text-xl font-display font-bold text-zinc-100 group-hover:text-cyan-300 transition-colors">
                  {item.category}
                </h3>
                <div class="flex flex-wrap gap-1.5">
                  {item.software.map(s => (
                    <span class="px-2.5 py-1 rounded-lg bg-zinc-950 border border-zinc-800 text-[10px] font-mono text-zinc-300">
                      {s}
                    </span>
                  ))}
                </div>
                <p class="text-xs text-zinc-400 leading-relaxed font-sans">
                  {item.desc}
                </p>
              </div>
            </div>
          );
        })}
      </div>

    </div>
  </section>
</BaseLayout>
