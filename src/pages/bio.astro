---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import {
  GraduationCap,
  Music,
  Piano,
  Mic2,
  Sliders,
  FileCode2,
  Award,
  BookOpen,
  Sparkles,
  Layers,
  CheckCircle2,
  AudioWaveform,
} from 'lucide-astro';

const education = [
  {
    period: 'Studia Wyższe Magisterskie',
    institution: 'Uniwersytet Warmińsko-Mazurski w Olsztynie',
    degree: 'Dyplom z Wyróżnieniem',
    specialization: 'Edukacja Artystyczna w Zakresie Sztuki Muzycznej / Dyrygentura i Prowadzenie Zespołów',
    highlights: [
      'Główny dyplom dyrygencki z orkiestrą symfoniczną i chórem mieszanym (dyplom z wyróżnieniem)',
      'Metodyka prowadzenia chórów, orkiestr dętych i zespołów kameralnych',
      'Działalność w strukturach artystycznych uczelni oraz prowadzenie biblioteki nutowej',
    ],
  },
  {
    period: 'Państwowa Szkoła Muzyczna II Stopnia',
    institution: 'PSM II st. im. Fryderyka Chopina',
    degree: 'Dyplom Zawodowego Muzyka Instrumentalisty',
    specialization: 'Klasa Klarnetu & Fortepian Dodatkowy',
    highlights: [
      'Literatura klarnetowa, gra w orkiestrze symfonicznej szkoły muzycznej oraz zespołach kameralnych dętych',
      'Harmonia klasyczna, kontrapunkt, kształcenie słuchu i analiza dzieła muzycznego',
    ],
  },
  {
    period: 'Państwowa Szkoła Muzyczna I Stopnia',
    institution: 'PSM I st.',
    degree: 'Świadectwo Ukończenia z Wyróżnieniem',
    specialization: 'Klasa Klarnetu & Fortepian',
    highlights: [
      'Aparat gry na klarnecie, intonacja, technika palcowa i pierwsze występy sceniczne',
    ],
  },
];

const mainInstruments = [
  {
    name: 'Dyrygentura',
    category: 'Główna Dyscyplina',
    desc: 'Prowadzenie orkiestr symfonicznych, dętych i chórów. Praca nad intonacją, dynamiką i wyrazem partytury.',
    icon: Sparkles,
  },
  {
    name: 'Klarnet',
    category: 'Instrument Główny',
    desc: 'Wykonawstwo solowe, kameralne oraz orkiestrowe w repertuarze symfonicznym i marszowym.',
    icon: Music,
  },
  {
    name: 'Fortepian',
    category: 'Instrument Główny',
    desc: 'Czytanie partytur i wyciągów fortepianowych, realizacja harmonii i akompaniament.',
    icon: Piano,
  },
  {
    name: 'Śpiew / Wokal',
    category: 'Głos Solowy & Chóralny',
    desc: 'Emisja głosu, partie solowe w spektaklach operetkowych i musicalowych oraz śpiew chóralny.',
    icon: Mic2,
  },
];

const additionalInstruments = [
  {
    name: 'Organy Liturgiczne',
    desc: 'Akompaniament liturgiczny i obsługa instrumentu w obiektach sakralnych.',
  },
  {
    name: 'Perkusja / Kotły',
    desc: 'Gra na kotłach i instrumentarium perkusyjnym w składach orkiestrowych.',
  },
  {
    name: 'Klawisze MIDI & Syntezatory',
    desc: 'Sterowanie barwami cyfrowymi i integracja warstw elektronicznych w składach na żywo.',
  },
];

const studioWorkflows = [
  {
    category: 'Partytury & Notacja',
    software: ['MuseScore', 'Sibelius', 'MusicXML'],
    desc: 'Aranżacje, transkrypcje i przygotowanie partytur oraz głosów wykonawczych dla zespołów.',
    icon: FileCode2,
  },
  {
    category: 'Produkcja Audio & Miks',
    software: ['Logic Pro', 'Pro Tools'],
    desc: 'Wielośladowy zapis sesyjny, edycja ścieżek, miks oraz mastering.',
    icon: Sliders,
  },
  {
    category: 'Realizacja Sceniczna',
    software: ['Miksery Cyfrowe', 'Odsłuchy IEM', 'MIDI Sync'],
    desc: 'Konfiguracja torów audio i synchronizacja sygnałów scenicznych podczas koncertów na żywo.',
    icon: AudioWaveform,
  },
];
---

<BaseLayout
  title="Bio, Edukacja & Warsztat Twórczy — Kacper Czeczot"
  description="Sylwetka artystyczna dyrygenta i instrumentalisty Kacpra Czeczota: wykształcenie muzyczne na UWM z wyróżnieniem, PSM I i II st., instrumentarium oraz warsztat partytur i produkcji studyjnej."
>
  <!-- Page Header -->
  <section class="relative pt-36 pb-20 md:pt-44 md:pb-24 overflow-hidden border-b border-[#e2ba64]/15 bg-[#070709]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <SectionHeader
        badge="Sylwetka & Doświadczenie"
        title="Bio, Edukacja & Warsztat Twórczy"
        subtitle="Droga artystyczna ukształtowana przez akademicką dyrygenturę, wykonawstwo instrumentalne oraz realizację dźwięku."
        align="center"
      />
    </div>
  </section>

  <!-- 1. ARTISTIC BIOGRAPHY -->
  <section class="py-24 bg-[#0a0a0e] border-b border-[#e2ba64]/15 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2.5 px-4 py-1 rounded-full text-xs font-display font-bold uppercase tracking-wider bg-[#15141a] text-[#f6d289] border border-[#e2ba64]/30">
            <BookOpen class="w-3.5 h-3.5 text-[#e2ba64]" />
            <span>Biogram Artystyczny</span>
          </div>

          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-white leading-tight">
            Dyrygentura, wykonawstwo sceniczne i praca studyjna
          </h2>

          <div class="space-y-4 text-zinc-300 font-serif leading-relaxed text-base sm:text-lg font-light">
            <p>
              Edukację muzyczną rozwijałem w szkołach muzycznych I i II stopnia w klasie klarnetu i fortepianu, a następnie na studiach wyższych magisterskich na Uniwersytecie Warmińsko-Mazurskim w Olsztynie, ukończonych dyplomem z wyróżnieniem w specjalności dyrygenckiej.
            </p>
            <p>
              Działalność sceniczna obejmuje ponad <strong class="text-[#f6d289] font-semibold">300 występów</strong>: prowadzenie orkiestr dętych, chórów akademickich i kameralnych, udział w spektaklach teatralno-operetkowych i musicalach, a także występy z formacjami estradowymi.
            </p>
            <p class="text-zinc-400 font-sans text-sm leading-relaxed">
              Równolegle zajmuję się pracą aranżacyjną (edycja partytur w programie MuseScore), realizacją nagrań wielośladowych w środowiskach Logic Pro i Pro Tools oraz inżynierią dźwięku scenicznego.
            </p>
          </div>

          <div class="pt-3 flex flex-wrap gap-4 text-xs font-display uppercase tracking-wider text-zinc-300">
            <span class="flex items-center gap-2"><CheckCircle2 class="w-4 h-4 text-[#e2ba64]" /> Dyrygentura orkiestr i chórów</span>
            <span class="flex items-center gap-2"><CheckCircle2 class="w-4 h-4 text-[#e2ba64]" /> Aranżacja i edycja partytur</span>
            <span class="flex items-center gap-2"><CheckCircle2 class="w-4 h-4 text-[#e2ba64]" /> Realizacja dźwięku DAW</span>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="theatre-card p-8 rounded-3xl border border-[#e2ba64]/30 space-y-6 relative overflow-hidden shadow-2xl">
            <div class="flex items-center justify-between border-b border-[#e2ba64]/20 pb-4">
              <span class="font-display font-bold text-lg text-white">Główne Obszary</span>
              <span class="text-xs font-display uppercase tracking-wider text-[#e2ba64]">Praktyka</span>
            </div>

            <div class="space-y-4 text-xs text-zinc-300">
              <div class="p-4 rounded-2xl bg-[#070709] border border-[#e2ba64]/20 space-y-1">
                <span class="text-[#f6d289] font-display font-bold uppercase tracking-wider block">DYRYGENTURA & APARAT WYKONAWCZY</span>
                <span class="text-zinc-400 font-serif italic text-sm">Prowadzenie orkiestr symfonicznych, dętych i chórów.</span>
              </div>
              <div class="p-4 rounded-2xl bg-[#070709] border border-[#e2ba64]/20 space-y-1">
                <span class="text-[#faecd0] font-display font-bold uppercase tracking-wider block">WYKONAWSTWO INSTRUMENTALNE & WOKAL</span>
                <span class="text-zinc-400 font-serif italic text-sm">Klarnet, fortepian, śpiew solowy i zespołowy, organy.</span>
              </div>
              <div class="p-4 rounded-2xl bg-[#070709] border border-[#e2ba64]/20 space-y-1">
                <span class="text-[#e2ba64] font-display font-bold uppercase tracking-wider block">STUDIO, PARTYTURY & SOFTWARE</span>
                <span class="text-zinc-400 font-serif italic text-sm">Logic Pro, Pro Tools, MuseScore oraz oprogramowanie sceniczne.</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. EDUCATION & QUALIFICATIONS TIMELINE -->
  <section class="py-24 bg-[#070709] border-b border-[#e2ba64]/15 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
      
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs font-display font-semibold uppercase tracking-widest text-[#e2ba64]">
          Ścieżka Akademicka & Kwalifikacje
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-white">
          Edukacja <span class="text-gold">Muzyczna</span>
        </h2>
        <p class="text-zinc-300 font-serif italic text-base sm:text-lg font-light">
          Ukończone uczelnie i szkoły muzyczne.
        </p>
      </div>

      <div class="space-y-6 max-w-4xl mx-auto">
        {education.map((item) => (
          <div class="theatre-card rounded-3xl p-7 sm:p-9 border border-[#e2ba64]/20 hover:border-[#e2ba64]/50 transition-all relative group shadow-lg">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-[#e2ba64]/15">
              <div class="space-y-1">
                <span class="text-xs font-display font-bold uppercase tracking-widest text-[#e2ba64]">
                  {item.period}
                </span>
                <h3 class="text-xl sm:text-2xl font-display font-bold text-white group-hover:text-[#f6d289] transition-colors">
                  {item.institution}
                </h3>
              </div>
              <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-display font-bold uppercase tracking-wider bg-[#070709] text-[#f6d289] border border-[#e2ba64]/30 self-start sm:self-auto">
                <Award class="w-3.5 h-3.5 text-[#e2ba64]" />
                {item.degree}
              </span>
            </div>

            <div class="pt-5 space-y-3.5">
              <p class="text-sm font-display uppercase tracking-wider text-zinc-300 font-semibold">
                Kierunek / Specjalność: <span class="text-[#faecd0] font-normal font-sans normal-case">{item.specialization}</span>
              </p>
              <ul class="space-y-2 text-xs sm:text-sm text-zinc-300 font-sans">
                {item.highlights.map(h => (
                  <li class="flex items-start gap-2.5">
                    <span class="text-[#e2ba64] mt-1">•</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 3. INSTRUMENTARIUM -->
  <section class="py-24 bg-[#0a0a0e] border-b border-[#e2ba64]/15 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
      
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs font-display font-semibold uppercase tracking-widest text-[#e2ba64]">
          Praktyka Wykonawcza
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-white">
          Instrumentarium & <span class="text-gold">Kompetencje</span>
        </h2>
        <p class="text-zinc-300 font-serif italic text-base sm:text-lg font-light">
          Główne i dodatkowe instrumenty oraz dyscypliny muzyczne.
        </p>
      </div>

      <!-- Main Instruments Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {mainInstruments.map((inst) => {
          const Icon = inst.icon;
          return (
            <div class="theatre-card p-7 rounded-3xl border border-[#e2ba64]/20 hover:border-[#e2ba64]/60 flex flex-col justify-between group hover:-translate-y-1.5 transition-all shadow-md">
              <div class="space-y-4">
                <div class="w-12 h-12 rounded-2xl bg-[#070709] border border-[#e2ba64]/30 text-[#f6d289] flex items-center justify-center group-hover:scale-110 group-hover:border-[#e2ba64] transition-all">
                  <Icon class="w-6 h-6" />
                </div>
                <div>
                  <span class="text-[10px] font-display uppercase tracking-widest text-[#e2ba64] block mb-1">
                    {inst.category}
                  </span>
                  <h3 class="text-xl font-display font-bold text-white group-hover:text-[#f6d289] transition-colors">
                    {inst.name}
                  </h3>
                </div>
                <p class="text-xs text-zinc-400 leading-relaxed font-sans">
                  {inst.desc}
                </p>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Additional Instruments Box -->
      <div class="theatre-card p-8 sm:p-10 rounded-3xl border border-[#e2ba64]/20 max-w-5xl mx-auto shadow-lg">
        <h3 class="text-xs font-display font-bold uppercase tracking-widest text-[#f6d289] mb-6 flex items-center gap-2.5">
          <Layers class="w-4 h-4 text-[#e2ba64]" />
          <span>Instrumentarium Dodatkowe</span>
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {additionalInstruments.map((item) => (
            <div class="p-5 rounded-2xl bg-[#070709]/80 border border-[#e2ba64]/15 space-y-1.5">
              <h4 class="text-sm font-display font-bold text-zinc-100">{item.name}</h4>
              <p class="text-xs text-zinc-400 font-serif italic text-sm leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- 4. STUDIO, ARANŻACJE & PARTYTURY -->
  <section class="py-24 bg-[#070709] relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
      
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs font-display font-semibold uppercase tracking-widest text-[#e2ba64]">
          Środowisko Pracy
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-white">
          Studio, Partytury & <span class="text-gold">Realizacja Dźwięku</span>
        </h2>
        <p class="text-zinc-300 font-serif italic text-base sm:text-lg font-light">
          Oprogramowanie do edycji partytur i produkcji muzycznej.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-7">
        {studioWorkflows.map((item) => {
          const Icon = item.icon;
          return (
            <div class="theatre-card p-8 rounded-3xl border border-[#e2ba64]/20 hover:border-[#e2ba64]/50 transition-all flex flex-col justify-between group shadow-md">
              <div class="space-y-4">
                <div class="w-12 h-12 rounded-2xl bg-[#070709] border border-[#e2ba64]/30 text-[#f6d289] flex items-center justify-center group-hover:scale-110 group-hover:border-[#e2ba64] transition-all">
                  <Icon class="w-6 h-6" />
                </div>
                <h3 class="text-xl font-display font-bold text-white group-hover:text-[#f6d289] transition-colors">
                  {item.category}
                </h3>
                <div class="flex flex-wrap gap-2">
                  {item.software.map(s => (
                    <span class="px-3 py-1 rounded-lg bg-[#070709] border border-[#e2ba64]/20 text-[10px] font-display uppercase tracking-wider text-zinc-300">
                      {s}
                    </span>
                  ))}
                </div>
                <p class="text-xs text-zinc-400 font-sans leading-relaxed">
                  {item.desc}
                </p>
              </div>
            </div>
          );
        })}
      </div>

    </div>
  </section>
</BaseLayout>
