---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import {
  GraduationCap,
  Music,
  Piano,
  Mic2,
  Sliders,
  FileCode2,
  Award,
  BookOpen,
  Sparkles,
  Layers,
  CheckCircle2,
} from 'lucide-astro';

const education = [
  {
    institution: 'Uniwersytet Warmińsko-Mazurski w Olsztynie (UWM)',
    degree: 'Dyplom z Wyróżnieniem',
    detail: 'Dyrygentura',
  },
  {
    institution: 'Państwowa Szkoła Muzyczna I i II stopnia (PSM)',
    degree: 'Edukacja Muzyczna',
    detail: 'Klarnet / Fortepian',
  },
];

const mainInstruments = [
  {
    name: 'Dyrygentura',
    category: 'Główna Dyscyplina',
    desc: 'Kierownictwo muzyczne i dyrygentura orkiestr oraz chórów.',
    icon: Sparkles,
  },
  {
    name: 'Klarnet',
    category: 'Instrument Główny',
    desc: 'Wykonawstwo solowe, kameralne oraz orkiestrowe.',
    icon: Music,
  },
  {
    name: 'Fortepian',
    category: 'Instrument Główny',
    desc: 'Wykonawstwo instrumentalne i praca z partyturą.',
    icon: Piano,
  },
  {
    name: 'Śpiew / Wokal',
    category: 'Głos',
    desc: 'Śpiew solowy, spektakle teatralno-muzyczne oraz chór.',
    icon: Mic2,
  },
];

const additionalInstruments = [
  {
    name: 'Organy Liturgiczne',
    desc: 'Akompaniament liturgiczny.',
  },
  {
    name: 'Perkusja / Kotły',
    desc: 'Składy orkiestrowe.',
  },
];
---

<BaseLayout
  title="Bio & Edukacja — Kacper Czeczot"
  description="Sylwetka artystyczna dyrygenta i muzyka Kacpra Czeczota."
>
  <!-- Page Header -->
  <section class="relative pt-36 pb-20 md:pt-44 md:pb-24 overflow-hidden border-b border-sky-500/15 bg-[#070d1a]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <SectionHeader
        badge="Sylwetka Artystyczna"
        title="Bio & Edukacja"
        subtitle="Dyrygentura, wykonawstwo instrumentalne oraz działalność sceniczna."
        align="center"
      />
    </div>
  </section>

  <!-- 1. BIOGRAM -->
  <section class="py-24 bg-[#091224] border-b border-sky-500/15 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto space-y-6">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider bg-[#0f1d38] text-sky-200 border border-sky-400/30 font-display">
          <BookOpen class="w-3.5 h-3.5 text-sky-400" />
          <span>Biogram Artystyczny</span>
        </div>

        <h2 class="text-3xl sm:text-4xl font-display font-bold text-white leading-tight">
          Dyrygentura i wykonawstwo sceniczne
        </h2>

        <div class="space-y-4 text-slate-300 font-sans leading-relaxed text-base sm:text-lg">
          <p>
            Działalność muzyczna obejmująca dyrygenturę orkiestrową i chóralną, wykonawstwo instrumentalne (klarnet, fortepian, organy liturgiczne) oraz śpiew sceniczny.
          </p>
          <p>
            Ponad <strong class="text-sky-300 font-semibold">300 występów scenicznych</strong> w ramach orkiestr dętych, chórów, teatru, musicalu i formacji estradowych.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. EDUKACJA -->
  <section class="py-24 bg-[#070d1a] border-b border-sky-500/15 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs font-semibold uppercase tracking-wider text-sky-400 font-display">
          Edukacja
        </span>
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-white">
          Edukacja <span class="text-blue-gradient">Muzyczna</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {education.map((item) => (
          <div class="ocean-card rounded-3xl p-7 border border-sky-500/20 shadow-ocean-card space-y-3">
            <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-[#070d1a] text-sky-300 border border-sky-400/30 font-display">
              <Award class="w-3.5 h-3.5 text-sky-400" />
              {item.degree}
            </span>
            <h3 class="text-lg font-display font-bold text-white">
              {item.institution}
            </h3>
            <p class="text-xs text-slate-400 font-sans">
              {item.detail}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 3. INSTRUMENTARIUM -->
  <section class="py-24 bg-[#091224] relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs font-semibold uppercase tracking-wider text-sky-400 font-display">
          Dyscypliny & Instrumentarium
        </span>
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-white">
          Praktyka <span class="text-blue-gradient">Wykonawcza</span>
        </h2>
      </div>

      <!-- Main Instruments Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {mainInstruments.map((inst) => {
          const Icon = inst.icon;
          return (
            <div class="ocean-card p-6 rounded-3xl border border-sky-500/20 flex flex-col justify-between group shadow-ocean-card">
              <div class="space-y-3">
                <div class="w-10 h-10 rounded-xl bg-[#070d1a] border border-sky-400/25 text-sky-400 flex items-center justify-center">
                  <Icon class="w-5 h-5" />
                </div>
                <div>
                  <span class="text-[10px] font-bold uppercase tracking-wider text-sky-300 block mb-1 font-display">
                    {inst.category}
                  </span>
                  <h3 class="text-lg font-display font-bold text-white">
                    {inst.name}
                  </h3>
                </div>
                <p class="text-xs text-slate-300 leading-relaxed font-sans">
                  {inst.desc}
                </p>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Additional Instruments Box -->
      <div class="ocean-card p-6 rounded-3xl border border-sky-500/20 max-w-3xl mx-auto shadow-ocean-card">
        <h3 class="text-xs font-bold uppercase tracking-wider text-white mb-4 flex items-center gap-2 font-display">
          <Layers class="w-4 h-4 text-sky-400" />
          <span>Instrumentarium Dodatkowe</span>
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {additionalInstruments.map((item) => (
            <div class="p-4 rounded-2xl bg-[#070d1a] border border-sky-500/20 space-y-1 shadow-xs">
              <h4 class="text-sm font-bold text-white font-display">{item.name}</h4>
              <p class="text-xs text-slate-300 font-sans">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
