---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const higherEducation = [
  {
    period: '2025 – obecnie',
    institution: 'Uniwersytet Warmińsko-Mazurski w Olsztynie — Wydział Sztuki',
    degree: 'Studia II stopnia (Magisterskie)',
    specialization: 'Edukacja artystyczna w zakresie sztuki muzycznej',
    highlights: [
      'Kontynuacja ścieżki dyrygenckiej i akademickiej',
    ],
  },
  {
    period: '2023 – obecnie',
    institution: 'Uniwersytet Warmińsko-Mazurski w Olsztynie — Wydział Sztuki',
    degree: 'Studia I stopnia (Licencjackie, równoległe)',
    specialization: 'Produkcja Muzyczna i Realizacja Dźwięku',
    highlights: [
      'Inżynieria dźwięku, realizacja sesyjna i produkcja muzyczna',
    ],
  },
  {
    period: '2021 – 2025',
    institution: 'Uniwersytet Warmińsko-Mazurski w Olsztynie — Wydział Sztuki',
    degree: 'Dyplom z Wyróżnieniem (Licencjat)',
    specialization: 'Edukacja artystyczna w zakresie sztuki muzycznej',
    highlights: [
      'Tytuł Najlepszego Absolwenta Wydziału Sztuki UWM (za rok akademicki 2024/2025)',
      'Nagroda Dziekana za wybitne artystyczne dzieło dyplomowe (Koncert „Finale” w Filharmonii Warmińsko-Mazurskiej)',
      'Praca dyplomowa: „Analiza i rozwiązywanie problemów wykonawczych na podstawie utworów z repertuaru dyplomowego”',
    ],
  },
];

const musicSchoolEducation = [
  {
    period: '2018 – 2022',
    institution: 'Państwowa Szkoła Muzyczna I i II st. im. Andrzeja Krzanowskiego w Mławie',
    degree: 'Dyplom z Wyróżnieniem — Tytuł zawodowy: Muzyk',
    specialization: 'Wydział Wokalny (klasa śpiewu Michała Gogolewskiego)',
    highlights: [
      'Ukończenie wydziału wokalnego z wyróżnieniem',
      'Przewodniczący Samorządu Uczniowskiego PSM (2019–2022) i założyciel Orkiestry Samorządu',
    ],
  },
  {
    period: '2010 – 2016',
    institution: 'Państwowa Szkoła Muzyczna I i II st. im. Andrzeja Krzanowskiego w Mławie',
    degree: 'Świadectwo z Wyróżnieniem (I Stopień)',
    specialization: 'Fortepian (klasa Ireneusza Weredy)',
    highlights: [
      'Fortepian główny (2012–2016) oraz skrzypce (2010–2012)',
    ],
  },
];

const individualAwards = [
  {
    year: '2025',
    title: 'Najlepszy Absolwent Wydziału Sztuki UWM',
    issuer: 'Uniwersytet Warmińsko-Mazurski w Olsztynie',
  },
  {
    year: '2025',
    title: 'Nagroda Dziekana za Wybitne Dzieło Dyplomowe',
    issuer: 'Koncert Dyplomowy „Finale” w Filharmonii Warmińsko-Mazurskiej',
  },
  {
    year: '2025',
    title: 'Złoty i Srebrny Dyplom — Canco Mediterrania (Hiszpania)',
    issuer: 'XIV Międzynarodowy Festiwal Chóralny (z Chórem UWM)',
  },
  {
    year: '2024',
    title: 'I Miejsce — Karnolsky Summer Camp (Bułgaria)',
    issuer: 'Kategoria instrumentalna (z MMOD w Chorzelach, klarnet)',
  },
  {
    year: '2023',
    title: 'Złoty Dyplom — Festiwal „O, Warmio moja miła”',
    issuer: 'Z Chórem Ars Vocale Instytutu Muzyki',
  },
];

const mainInstruments = [
  {
    name: 'Dyrygentura',
    category: 'Główna dyscyplina',
    desc: 'Dyrygentura orkiestrowa (dęta i symfoniczna) oraz chóralna. Przygotowanie aparatu wykonawczego i prowadzenie koncertów.',
  },
  {
    name: 'Klarnet',
    category: 'Instrument główny',
    desc: 'Wykonawstwo w orkiestrach dętych i składach kameralnych.',
  },
  {
    name: 'Fortepian',
    category: 'Instrument główny',
    desc: 'Wykształcenie w klasie fortepianu, akompaniament oraz praca z wyciągami fortepianowymi.',
  },
  {
    name: 'Śpiew / Wokal (Tenor)',
    category: 'Głos solowy & chóralny',
    desc: 'Dyplom z wokalistyki z wyróżnieniem. Role operetkowe, musicalowe oraz partie tenorowe w chórach.',
  },
];

const additionalInstruments = [
  { name: 'Organy liturgiczne', desc: 'Oprawa muzyczna i akompaniament liturgiczny.' },
  { name: 'Perkusja / Kotły', desc: 'Sekcja perkusyjna w składach orkiestrowych.' },
  { name: 'Skrzypce / Akordeon', desc: 'Edukacja wczesnoszkolna i instrumentarium dodatkowe.' },
];

const posts = [
  { title: 'Orkiestra GOK w Opinogórze Górnej', detail: 'Główny Dyrygent (od grudnia 2025)' },
  { title: 'Orkiestra Dęta OSP Rębowo / Chociszewo', detail: 'Zastępca Dyrygenta i Instruktor (od 2024)' },
  { title: 'Chór im. prof. W. Wawrzyczka UWM', detail: 'Tenor, Dyrygent, Bibliotekarz (70+ występów, od 2022)' },
];
---

<BaseLayout
  title="Bio, Edukacja & Osiągnięcia — Kacper Czeczot"
  description="Zweryfikowana sylwetka artystyczna: wykształcenie na UWM i w PSM w Mławie z wyróżnieniem, nagrody, instrumentarium oraz dorobek dyrygencki."
>
  <section class="relative pt-36 pb-16 md:pt-44 md:pb-20 border-b border-white/10 bg-[#070d1a]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        badge="Sylwetka & Doświadczenie"
        title="Bio, Edukacja & Osiągnięcia"
        subtitle="Wykształcenie dyrygenckie, wokalne i instrumentalne poparte dyplomami z wyróżnieniem oraz nagrodami akademickimi i festiwalowymi."
        align="left"
      />
    </div>
  </section>

  <article class="bg-[#070d1a]">
    <section class="py-20 border-b border-white/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
          <div class="lg:col-span-7 space-y-6">
            <p class="text-xs font-sans uppercase tracking-[0.28em] text-sky-400">Biogram artystyczny</p>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-semibold text-white leading-tight">
              Dyrygentura, wykonawstwo sceniczne i produkcja dźwięku
            </h2>
            <div class="space-y-5 text-slate-300 font-sans font-light leading-relaxed text-base sm:text-lg">
              <p>
                Absolwent studiów licencjackich z wyróżnieniem oraz Najlepszy Absolwent Wydziału Sztuki Uniwersytetu Warmińsko-Mazurskiego w Olsztynie (2024/2025). Kontynuuje studia magisterskie na kierunku Edukacja artystyczna w zakresie sztuki muzycznej oraz równoległe studia licencjackie na kierunku Produkcja Muzyczna i Realizacja Dźwięku.
              </p>
              <p>
                Absolwent Państwowej Szkoły Muzycznej I i II st. im. A. Krzanowskiego w Mławie (I stopień w klasie fortepianu z wyróżnieniem, II stopień na wydziale wokalnym z tytułem zawodowym muzyka z wyróżnieniem).
              </p>
            </div>
          </div>

          <figure class="lg:col-span-5 space-y-3">
            <div class="border border-white/10 overflow-hidden">
              <img
                src={`${base}/images/bio-stage.svg`}
                alt="Kadr ze spektaklu operetkowego — scena teatralna"
                class="w-full aspect-[3/2] object-cover"
              />
            </div>
            <figcaption class="text-[11px] font-sans uppercase tracking-widest text-slate-500">
              Scena teatralna · Operetka / musical
            </figcaption>
          </figure>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start mt-16">
          <figure class="lg:col-span-5 order-2 lg:order-1 space-y-3">
            <div class="border border-white/10 overflow-hidden max-w-md">
              <img
                src={`${base}/images/bio-score.svg`}
                alt="Detal partytury orkiestrowej"
                class="w-full aspect-square object-cover"
              />
            </div>
            <figcaption class="text-[11px] font-sans uppercase tracking-widest text-slate-500">
              Warsztat aranżacyjny · Partytura
            </figcaption>
          </figure>

          <div class="lg:col-span-7 order-1 lg:order-2 space-y-5 text-slate-300 font-sans font-light leading-relaxed text-base sm:text-lg">
            <p>
              Działalność sceniczna obejmuje ponad <strong class="text-sky-200 font-medium">300 udokumentowanych występów</strong>: prowadzenie orkiestr dętych (Główny Dyrygent w Opinogórze Górnej, Zastępca Dyrygenta w Rębowie i Chociszewie), śpiew w chórach akademickich i filharmonicznych (m.in. Chór im. prof. W. Wawrzyczka UWM, Cantores Varmienses, Ars Vocale), role solowe w spektaklach operetkowych i musicalu „Pora Jeziora” (Filharmonia Warmińsko-Mazurska, Opera Krakowska).
            </p>
            <ul class="divide-y divide-white/10 border-t border-b border-white/10 text-sm">
              {posts.map((post) => (
                <li class="py-4 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                  <span class="font-display text-lg text-white">{post.title}</span>
                  <span class="text-xs uppercase tracking-wider text-slate-500 font-sans">{post.detail}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 border-b border-white/10">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
        <div class="space-y-8">
          <div class="space-y-2">
            <p class="text-xs font-sans uppercase tracking-[0.28em] text-sky-400">Szkolnictwo wyższe</p>
            <h3 class="text-2xl sm:text-3xl font-display font-semibold text-white">
              Uniwersytet Warmińsko-Mazurski w Olsztynie
            </h3>
          </div>
          <div class="divide-y divide-white/10 border-t border-b border-white/10">
            {higherEducation.map((item) => (
              <div class="py-7 space-y-3">
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
                  <div>
                    <p class="text-xs font-sans uppercase tracking-widest text-sky-400">{item.period}</p>
                    <h4 class="text-xl font-display text-white mt-1">{item.degree}</h4>
                  </div>
                  <p class="text-xs text-slate-400 font-sans sm:text-right max-w-xs">{item.specialization}</p>
                </div>
                <ul class="space-y-1.5 text-sm text-slate-400 font-sans font-light">
                  {item.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>

        <div class="space-y-8">
          <div class="space-y-2">
            <p class="text-xs font-sans uppercase tracking-[0.28em] text-sky-400">Szkoła muzyczna</p>
            <h3 class="text-2xl sm:text-3xl font-display font-semibold text-white">
              PSM im. A. Krzanowskiego w Mławie
            </h3>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-white/10">
            {musicSchoolEducation.map((item) => (
              <div class="bg-[#070d1a] p-7 space-y-3 border border-white/10">
                <p class="text-xs font-sans uppercase tracking-widest text-sky-400">{item.period}</p>
                <h4 class="text-lg font-display text-white">{item.degree}</h4>
                <p class="text-xs text-sky-200/70">{item.specialization}</p>
                <ul class="space-y-1 text-sm text-slate-400 font-sans font-light pt-2 border-t border-white/10">
                  {item.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 border-b border-white/10">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
        <div class="space-y-2">
          <p class="text-xs font-sans uppercase tracking-[0.28em] text-sky-400">Osiągnięcia</p>
          <h2 class="text-3xl sm:text-4xl font-display font-semibold text-white">Nagrody & wyróżnienia</h2>
        </div>
        <ul class="divide-y divide-white/10 border-t border-b border-white/10">
          {individualAwards.map((award) => (
            <li class="py-5 grid grid-cols-[4.5rem_1fr] gap-6 items-baseline">
              <span class="text-sm font-sans text-sky-400 tabular-nums">{award.year}</span>
              <div>
                <h4 class="font-display text-xl text-white">{award.title}</h4>
                <p class="text-sm text-slate-500 font-sans mt-1">{award.issuer}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
        <div class="space-y-2">
          <p class="text-xs font-sans uppercase tracking-[0.28em] text-sky-400">Dyscypliny</p>
          <h2 class="text-3xl sm:text-4xl font-display font-semibold text-white">Instrumentarium & warsztat</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-white/10 border border-white/10">
          {mainInstruments.map((inst) => (
            <div class="bg-[#070d1a] p-7 space-y-3">
              <p class="text-[11px] font-sans uppercase tracking-widest text-sky-400">{inst.category}</p>
              <h3 class="text-2xl font-display text-white">{inst.name}</h3>
              <p class="text-sm text-slate-400 font-sans font-light leading-relaxed">{inst.desc}</p>
            </div>
          ))}
        </div>

        <div class="border border-white/10 p-7 space-y-5">
          <h3 class="text-xs font-sans uppercase tracking-[0.22em] text-white">Instrumentarium dodatkowe</h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            {additionalInstruments.map((item) => (
              <div class="space-y-1 border-l border-white/10 pl-4">
                <h4 class="text-base font-display text-white">{item.name}</h4>
                <p class="text-xs text-slate-400 font-sans font-light">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
