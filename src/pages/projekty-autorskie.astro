---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import YoutubeEmbed from '../components/YoutubeEmbed.astro';
import { getCollection } from 'astro:content';
import { Music, Users, Award, Sparkles, Sliders, Disc, Film } from 'lucide-astro';

const allWorks = await getCollection('works');
const works = allWorks.sort((a, b) => a.data.order - b.data.order);

const finaleWork = works.find(w => w.slug === 'koncert-finale');
const echoWork = works.find(w => w.slug === 'echo-epok');
---

<BaseLayout
  title="Dzieła Autorskie & Projekty Dyplomowe — Kacper Czeczot"
  description="Nagrania wideo dzieł dyplomowych: Koncert Dyplomowy „Finale” (dyrygentura symfoniczno-chóralna) oraz „Echo Epok” (produkcja muzyczna wielośladowa)."
>
  <!-- Page Header -->
  <section class="relative pt-36 pb-20 md:pt-44 md:pb-24 overflow-hidden border-b border-[#e2ba64]/15 bg-[#070709]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <SectionHeader
        badge="Dzieła Autorskie & Dyplomowe"
        title="Prezentacja Dzieł"
        subtitle="Nagrania koncertowe i studyjne dokumentujące dyrygenturę symfoniczno-chóralną oraz autorską produkcję muzyczną."
        align="center"
      />
    </div>
  </section>

  <!-- WORK 1: KONCERT DYPLOMOWY „FINALE” -->
  {finaleWork && (
    <section class="py-24 relative bg-[#0a0a0e] border-b border-[#e2ba64]/15">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
        
        <!-- Header Info Card -->
        <div class="theatre-card rounded-3xl p-8 sm:p-12 relative overflow-hidden border border-[#e2ba64]/30 shadow-2xl">
          <div class="absolute top-0 right-0 w-96 h-96 bg-[#e2ba64]/5 rounded-full blur-3xl pointer-events-none -z-10"></div>
          
          <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-8 border-b border-[#e2ba64]/20">
            <div class="space-y-3">
              <div class="flex flex-wrap items-center gap-3">
                <span class="px-4 py-1.5 rounded-full text-xs font-display font-bold uppercase tracking-wider bg-[#070709] text-[#f6d289] border border-[#e2ba64]/40 flex items-center gap-2">
                  <Music class="w-3.5 h-3.5 text-[#e2ba64]" />
                  Dyrygentura Symfoniczno-Chóralna
                </span>
                <span class="text-xs font-display uppercase tracking-wider text-zinc-400 px-3.5 py-1.5 rounded-full bg-[#15141a] border border-[#e2ba64]/20">
                  Rok: {finaleWork.data.year}
                </span>
              </div>
              <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-extrabold text-white">
                {finaleWork.data.title}
              </h2>
              <p class="text-lg font-serif italic text-[#faecd0] font-light">
                {finaleWork.data.subtitle}
              </p>
            </div>

            <!-- Badges -->
            <div class="flex flex-wrap sm:flex-nowrap gap-4">
              <div class="px-6 py-4 rounded-2xl bg-[#070709] border border-[#e2ba64]/30 text-center flex-1 sm:flex-none min-w-[140px]">
                <div class="font-display font-bold text-2xl sm:text-3xl text-gold">UWM</div>
                <div class="text-[11px] font-display uppercase tracking-wider text-zinc-400 mt-0.5">Koncert Dyplomowy</div>
              </div>
              <div class="px-6 py-4 rounded-2xl bg-[#070709] border border-[#e2ba64]/30 text-center flex-1 sm:flex-none min-w-[140px]">
                <div class="font-display font-bold text-2xl sm:text-3xl text-[#faecd0]">3</div>
                <div class="text-[11px] font-display uppercase tracking-wider text-zinc-400 mt-0.5">Części Wideo</div>
              </div>
            </div>
          </div>

          <!-- Description & Apparatus Details -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 pt-8">
            <div class="lg:col-span-7 space-y-4 text-zinc-300 font-serif leading-relaxed text-base sm:text-lg font-light">
              <p>{finaleWork.data.description}</p>
            </div>

            <div class="lg:col-span-5 space-y-4 bg-[#070709]/90 p-6 rounded-2xl border border-[#e2ba64]/25">
              <h3 class="text-xs font-display font-bold uppercase tracking-widest text-[#f6d289] flex items-center gap-2">
                <Users class="w-4 h-4 text-[#e2ba64]" />
                <span>Aparat Wykonawczy</span>
              </h3>
              <ul class="space-y-2.5 text-xs font-sans text-zinc-300">
                <li class="flex items-center justify-between py-1.5 border-b border-[#e2ba64]/10">
                  <span class="text-zinc-400 font-serif italic text-sm">Orkiestra:</span>
                  <span class="text-zinc-100 font-display font-semibold">Orkiestra Symfoniczna</span>
                </li>
                <li class="flex items-center justify-between py-1.5 border-b border-[#e2ba64]/10">
                  <span class="text-zinc-400 font-serif italic text-sm">Chór:</span>
                  <span class="text-zinc-100 font-display font-semibold">Chór Mieszany</span>
                </li>
                <li class="flex items-center justify-between py-1.5">
                  <span class="text-zinc-400 font-serif italic text-sm">Kierownictwo i Dyrygentura:</span>
                  <span class="text-[#e2ba64] font-display font-bold">Kacper Czeczot</span>
                </li>
              </ul>
            </div>
          </div>

        </div>

        <!-- 3-Video Grid (Parts I, II, III) -->
        <div class="space-y-6">
          <div class="flex items-center justify-between">
            <h3 class="font-display font-bold text-xl sm:text-2xl text-white flex items-center gap-3">
              <Film class="w-5 h-5 text-[#e2ba64]" />
              <span>Zapis Wideo — Trzy Części Koncertu</span>
            </h3>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {finaleWork.data.youtubeVideos.map((video, idx) => (
              <YoutubeEmbed
                youtubeId={video.youtubeId}
                title={video.title}
                partNumber={idx + 1}
              />
            ))}
          </div>
        </div>

      </div>
    </section>
  )}

  <!-- WORK 2: PROJEKT DYPLOMOWY „ECHO EPOK” -->
  {echoWork && (
    <section class="py-24 relative bg-[#070709]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
        
        <!-- Header Info Card -->
        <div class="theatre-card rounded-3xl p-8 sm:p-12 relative overflow-hidden border border-[#e2ba64]/30 shadow-2xl">
          <div class="absolute top-0 right-0 w-96 h-96 bg-[#e2ba64]/5 rounded-full blur-3xl pointer-events-none -z-10"></div>
          
          <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-8 border-b border-[#e2ba64]/20">
            <div class="space-y-3">
              <div class="flex flex-wrap items-center gap-3">
                <span class="px-4 py-1.5 rounded-full text-xs font-display font-bold uppercase tracking-wider bg-[#070709] text-[#f6d289] border border-[#e2ba64]/40 flex items-center gap-2">
                  <Sliders class="w-3.5 h-3.5 text-[#e2ba64]" />
                  Produkcja Muzyczna & Realizacja Dźwięku
                </span>
                <span class="text-xs font-display uppercase tracking-wider text-zinc-400 px-3.5 py-1.5 rounded-full bg-[#15141a] border border-[#e2ba64]/20">
                  Rok: {echoWork.data.year}
                </span>
              </div>
              <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-extrabold text-white">
                {echoWork.data.title}
              </h2>
              <p class="text-lg font-serif italic text-[#faecd0] font-light">
                {echoWork.data.subtitle}
              </p>
            </div>

            <div class="flex flex-wrap sm:flex-nowrap gap-4">
              <div class="px-6 py-4 rounded-2xl bg-[#070709] border border-[#e2ba64]/30 text-center flex-1 sm:flex-none min-w-[140px]">
                <div class="font-display font-bold text-2xl sm:text-3xl text-gold">Autorskie</div>
                <div class="text-[11px] font-display uppercase tracking-wider text-zinc-400 mt-0.5">Dzieło Dyplomowe</div>
              </div>
            </div>
          </div>

          <!-- Description -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 pt-8">
            <div class="lg:col-span-7 space-y-4 text-zinc-300 font-serif leading-relaxed text-base sm:text-lg font-light">
              <p>{echoWork.data.description}</p>
            </div>

            <div class="lg:col-span-5 space-y-4 bg-[#070709]/90 p-6 rounded-2xl border border-[#e2ba64]/25">
              <h3 class="text-xs font-display font-bold uppercase tracking-widest text-[#f6d289] flex items-center gap-2">
                <Music class="w-4 h-4 text-[#e2ba64]" />
                <span>Środowisko Realizacyjne</span>
              </h3>
              <ul class="space-y-2.5 text-xs font-sans text-zinc-300">
                <li class="flex items-center justify-between py-1.5 border-b border-[#e2ba64]/10">
                  <span class="text-zinc-400 font-serif italic text-sm">DAW & Miks:</span>
                  <span class="text-zinc-100 font-display font-semibold">Logic Pro / Pro Tools</span>
                </li>
                <li class="flex items-center justify-between py-1.5">
                  <span class="text-zinc-400 font-serif italic text-sm">Realizacja:</span>
                  <span class="text-[#e2ba64] font-display font-bold">Kacper Czeczot</span>
                </li>
              </ul>
            </div>
          </div>

        </div>

        <!-- Full-width Cinema Video Embed -->
        <div class="space-y-6">
          <div class="flex items-center justify-between">
            <h3 class="font-display font-bold text-xl sm:text-2xl text-white flex items-center gap-3">
              <Disc class="w-5 h-5 text-[#e2ba64]" />
              <span>Zapis Wideo — Sesja Nagraniowa</span>
            </h3>
          </div>

          <div class="max-w-4xl mx-auto">
            {echoWork.data.youtubeVideos.map((video) => (
              <YoutubeEmbed
                youtubeId={video.youtubeId}
                title={video.title}
                featured={true}
              />
            ))}
          </div>
        </div>

      </div>
    </section>
  )}
</BaseLayout>
