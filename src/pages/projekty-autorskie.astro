---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import YoutubeEmbed from '../components/YoutubeEmbed.astro';
import { getCollection } from 'astro:content';
import { cmsImage } from '../utils/cms';

const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);

const typeLabel = {
  conducting: 'Dyrygentura symfoniczno-chóralna',
  production: 'Produkcja muzyczna',
};
---

<BaseLayout
  title="Dzieła Autorskie & Projekty Dyplomowe — Kacper Czeczot"
  description="Dzieła dyplomowe Kacpra Czeczota: Koncert Dyplomowy „Finale” (dyrygentura) oraz „Echo Epok” (produkcja muzyczna i realizacja dźwięku)."
>
  <section class="relative pt-36 pb-16 md:pt-44 md:pb-20 border-b border-white/10 bg-ocean-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        badge="Dzieła Autorskie & Dyplomowe"
        title="Dzieła Autorskie"
        subtitle="Dyrygentura symfoniczno-chóralna oraz autorska produkcja muzyczna."
        align="left"
      />
    </div>
  </section>

  {works.map((work, workIndex) => (
    <section class={`py-20 ${workIndex < works.length - 1 ? 'border-b border-white/10' : ''}`}>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
          <div class="lg:col-span-8 space-y-5">
            <p class="text-xs font-sans uppercase tracking-[0.28em] text-sky-400">
              {typeLabel[work.data.type] || work.data.type} · {work.data.year}
            </p>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-semibold text-white">
              {work.data.title}
            </h2>
            <p class="text-lg font-sans text-sky-200/90 font-medium">{work.data.subtitle}</p>
            <p class="text-slate-300 font-sans font-light leading-relaxed text-base sm:text-lg">
              {work.data.description}
            </p>
            {work.data.videoUrl && (
              <p>
                <a
                  href={work.data.videoUrl}
                  class="text-sky-300 hover:text-sky-200 font-sans text-sm uppercase tracking-widest"
                  target="_blank"
                  rel="noreferrer"
                >
                  Zapis wideo →
                </a>
              </p>
            )}
          </div>

          <div class="lg:col-span-4 space-y-5">
            {cmsImage(work.data.cover) && (
              <img
                src={cmsImage(work.data.cover)}
                alt={`Okładka: ${work.data.title}`}
                class="w-full aspect-[16/10] object-cover rounded-2xl border border-white/10"
              />
            )}
            {work.data.metrics.length > 0 && (
              <div class="bg-ocean-900/80 border border-white/10 rounded-2xl p-6 shadow-xl space-y-4">
                <h4 class="text-xs font-sans uppercase tracking-[0.2em] font-semibold text-sky-400">Metryka Dzieła</h4>
                <dl class="divide-y divide-white/10 text-sm">
                  {work.data.metrics.map((row, idx) => (
                    <div class={`flex justify-between gap-4 py-3 ${idx === 0 ? 'first:pt-0' : ''} ${idx === work.data.metrics.length - 1 ? 'last:pb-0' : ''}`}>
                      <dt class="text-slate-400 uppercase tracking-wider text-[11px] font-sans">{row.label}</dt>
                      <dd class={`font-display text-right ${idx === work.data.metrics.length - 1 ? 'text-sky-300' : 'text-white'}`}>
                        {row.url ? (
                          <a
                            href={row.url}
                            class="text-sky-300 hover:text-sky-200 underline underline-offset-4 decoration-sky-500/40 hover:decoration-sky-300"
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {row.value}
                          </a>
                        ) : (
                          row.value
                        )}
                      </dd>
                    </div>
                  ))}
                </dl>
              </div>
            )}
          </div>
        </div>

        {work.data.youtubeVideos.length > 0 && (
          <div class={`space-y-6 ${work.data.youtubeVideos.length === 1 ? 'max-w-4xl' : ''}`}>
            <h3 class="font-display text-2xl text-white">{work.data.videoHeading || 'Zapis wideo'}</h3>
            {work.data.youtubeVideos.length === 1 ? (
              work.data.youtubeVideos.map((video) => (
                <YoutubeEmbed
                  youtubeId={video.youtubeId}
                  title={video.title}
                  featured={true}
                />
              ))
            ) : (
              <div class={`grid grid-cols-1 ${work.data.youtubeVideos.length >= 3 ? 'md:grid-cols-3' : 'md:grid-cols-2'} gap-4`}>
                {work.data.youtubeVideos.map((video, idx) => (
                  <YoutubeEmbed
                    youtubeId={video.youtubeId}
                    title={video.title}
                    partNumber={idx + 1}
                  />
                ))}
              </div>
            )}
          </div>
        )}
      </div>
    </section>
  ))}
</BaseLayout>
