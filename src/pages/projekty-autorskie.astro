---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import YoutubeEmbed from '../components/YoutubeEmbed.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const allWorks = await getCollection('works');
const works = allWorks.sort((a, b) => a.data.order - b.data.order);

const finaleWork = works.find(w => w.slug === 'koncert-finale');
const echoWork = works.find(w => w.slug === 'echo-epok');
---

<BaseLayout
  title="Dzieła Autorskie & Projekty Dyplomowe — Kacper Czeczot"
  description="Dzieła dyplomowe Kacpra Czeczota: Koncert Dyplomowy „Finale” (dyrygentura symfoniczno-chóralna) oraz „Echo Epok” (produkcja muzyczna)."
>
  <section class="relative pt-36 pb-16 md:pt-44 md:pb-20 border-b border-white/10 bg-[#070d1a]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        badge="Dzieła Autorskie & Dyplomowe"
        title="Dzieła Autorskie"
        subtitle="Dyrygentura symfoniczno-chóralna oraz autorska produkcja muzyczna."
        align="left"
      />
    </div>
  </section>

  {finaleWork && (
    <section class="py-20 border-b border-white/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
          <div class="lg:col-span-6 space-y-5">
            <p class="text-xs font-sans uppercase tracking-[0.28em] text-sky-400">
              Dyrygentura symfoniczno-chóralna · {finaleWork.data.year}
            </p>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-semibold text-white">
              {finaleWork.data.title}
            </h2>
            <p class="text-lg font-sans text-sky-200/90 font-medium">{finaleWork.data.subtitle}</p>
            <p class="text-slate-300 font-sans font-light leading-relaxed text-base sm:text-lg">
              {finaleWork.data.description}
            </p>
            <dl class="divide-y divide-white/10 border-t border-b border-white/10 text-sm">
              <div class="flex justify-between gap-4 py-3">
                <dt class="text-slate-500 uppercase tracking-wider text-[11px] font-sans">Orkiestra</dt>
                <dd class="text-white font-display">Orkiestra symfoniczna</dd>
              </div>
              <div class="flex justify-between gap-4 py-3">
                <dt class="text-slate-500 uppercase tracking-wider text-[11px] font-sans">Chór</dt>
                <dd class="text-white font-display text-right">Chór im. prof. Wiktora Wawrzyczka UWM</dd>
              </div>
              <div class="flex justify-between gap-4 py-3">
                <dt class="text-slate-500 uppercase tracking-wider text-[11px] font-sans">Dyrygentura</dt>
                <dd class="text-sky-300 font-display">Kacper Czeczot</dd>
              </div>
            </dl>
          </div>
          <figure class="lg:col-span-6 space-y-3">
            <div class="border border-white/10 overflow-hidden">
              <img
                src={`${base}/images/work-finale.svg`}
                alt="Orkiestra i chór w filharmonii — Koncert Finale"
                class="w-full aspect-video object-cover"
              />
            </div>
            <figcaption class="text-[11px] font-sans uppercase tracking-widest text-slate-500">
              Filharmonia · Orkiestra i chór · {finaleWork.data.youtubeVideos.length} części koncertu
            </figcaption>
          </figure>
        </div>

        <div class="space-y-6">
          <h3 class="font-display text-2xl text-white">Zapis wideo</h3>
          <div class={`grid grid-cols-1 ${finaleWork.data.youtubeVideos.length >= 3 ? 'md:grid-cols-3' : 'md:grid-cols-2'} gap-4`}>
            {finaleWork.data.youtubeVideos.map((video, idx) => (
              <YoutubeEmbed
                youtubeId={video.youtubeId}
                title={video.title}
                partNumber={idx + 1}
              />
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  {echoWork && (
    <section class="py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
          <figure class="lg:col-span-6 space-y-3">
            <div class="border border-white/10 overflow-hidden">
              <img
                src={`${base}/images/work-echo-epok.svg`}
                alt="Studio nagraniowe i realizacja dźwięku — Echo Epok"
                class="w-full aspect-video object-cover"
              />
            </div>
            <figcaption class="text-[11px] font-sans uppercase tracking-widest text-slate-500">
              Realizacja dźwięku · Instrumentarium · Sesja wielośladowa
            </figcaption>
          </figure>
          <div class="lg:col-span-6 space-y-5">
            <p class="text-xs font-sans uppercase tracking-[0.28em] text-sky-400">
              Produkcja muzyczna · {echoWork.data.year}
            </p>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-semibold text-white">
              {echoWork.data.title}
            </h2>
            <p class="text-lg font-sans text-sky-200/90 font-medium">{echoWork.data.subtitle}</p>
            <p class="text-slate-300 font-sans font-light leading-relaxed text-base sm:text-lg">
              {echoWork.data.description}
            </p>
            <dl class="divide-y divide-white/10 border-t border-b border-white/10 text-sm">
              <div class="flex justify-between gap-4 py-3">
                <dt class="text-slate-500 uppercase tracking-wider text-[11px] font-sans">Forma</dt>
                <dd class="text-white font-display text-right">Zapis wielośladowy jednoosobowy</dd>
              </div>
              <div class="flex justify-between gap-4 py-3">
                <dt class="text-slate-500 uppercase tracking-wider text-[11px] font-sans">Realizacja</dt>
                <dd class="text-sky-300 font-display">Kacper Czeczot</dd>
              </div>
            </dl>
          </div>
        </div>

        <div class="space-y-6 max-w-4xl">
          <h3 class="font-display text-2xl text-white">Zapis wideo — sesja nagraniowa</h3>
          {echoWork.data.youtubeVideos.map((video) => (
            <YoutubeEmbed
              youtubeId={video.youtubeId}
              title={video.title}
              featured={true}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
