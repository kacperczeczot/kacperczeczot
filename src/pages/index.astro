---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import RadialGraph from '../components/RadialGraph.astro';
import { Radio, User, Terminal, ArrowRight, Sparkles } from 'lucide-astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const pillarsSummary = [
  {
    title: 'Dzieła Autorskie & Dyplomowe',
    description: 'Koncert dyplomowy „Finale” na orkiestrę symfoniczną i chór mieszany oraz autorski projekt muzyczny „Echo Epok”.',
    link: `${base}/projekty-autorskie`,
    icon: Radio,
    badge: 'Dyrygentura & Produkcja',
  },
  {
    title: 'Bio, Edukacja & Warsztat',
    description: 'Ścieżka akademicka na UWM z wyróżnieniem, PSM I i II stopnia, wszechstronne instrumentarium oraz warsztat studyjny.',
    link: `${base}/bio`,
    icon: User,
    badge: 'Sylwetka & Doświadczenie',
  },
  {
    title: 'Laboratorium Technologiczne',
    description: 'Przestrzeń inżynierii dźwięku i oprogramowania scenicznego: silnik StageSync (WebAudio, MIDI Clock/SPP) oraz narzędzia analizy partytur.',
    link: `${base}/lab`,
    icon: Terminal,
    badge: 'Inżynieria Dźwięku & Software',
  },
];
---

<BaseLayout
  title="Kacper Czeczot — Dyrygent, Muzyk & Reżyser Dźwięku"
  description="Oficjalne portfolio artystyczne Kacpra Czeczota: dyrygentura symfoniczna i chóralna, wykonawstwo sceniczne, dzieła autorskie oraz warsztat twórczy."
>
  <!-- Main Artist Hero Section -->
  <Hero />

  <!-- Interactive Radial Constellation Section -->
  <RadialGraph />

  <!-- Artistic Pathways Section -->
  <section class="py-24 border-t border-slate-200 bg-slate-50 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <span class="text-xs font-semibold uppercase tracking-wider text-sky-700 font-display">
          Domeny Działalności
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-slate-900">
          Wymiary <span class="text-azure">Twórczości</span>
        </h2>
        <p class="text-slate-600 text-base sm:text-lg font-normal">
          Poznaj szczegółowo dorobek dyrygencki, dzieła autorskie oraz zaplecze studyjno-laboratoryjne.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {pillarsSummary.map((item) => {
          const Icon = item.icon;
          return (
            <a
              href={item.link}
              class="azure-card group rounded-3xl p-8 flex flex-col justify-between azure-card-hover relative overflow-hidden"
            >
              <div class="relative space-y-5">
                <div class="flex items-center justify-between">
                  <span class="p-3.5 rounded-2xl bg-sky-50 border border-sky-100 text-sky-600 group-hover:scale-110 group-hover:bg-sky-600 group-hover:text-white transition-all">
                    <Icon class="w-6 h-6" />
                  </span>
                  <span class="text-[11px] font-semibold uppercase tracking-wider text-sky-700 px-3 py-1 rounded-full bg-sky-50 border border-sky-200 font-display">
                    {item.badge}
                  </span>
                </div>

                <h3 class="text-2xl font-display font-bold text-slate-900 group-hover:text-sky-600 transition-colors leading-tight">
                  {item.title}
                </h3>

                <p class="text-sm text-slate-600 font-sans leading-relaxed">
                  {item.description}
                </p>
              </div>

              <div class="relative pt-6 mt-6 border-t border-slate-100 flex items-center justify-between text-xs font-bold uppercase tracking-wider text-sky-600 group-hover:text-sky-700">
                <span>Przejdź do sekcji</span>
                <ArrowRight class="w-4 h-4 group-hover:translate-x-1.5 transition-transform" />
              </div>
            </a>
          );
        })}
      </div>

    </div>
  </section>
</BaseLayout>
