---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import RadialGraph from '../components/RadialGraph.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const directory = [
  {
    index: '01',
    category: 'Dyrygentura & Produkcja',
    title: 'Dzieła Autorskie & Dyplomowe',
    description: 'Koncert dyplomowy „Finale” na orkiestrę symfoniczną i chór mieszany oraz autorski projekt muzyczny „Echo Epok”.',
    link: `${base}/projekty-autorskie`,
    image: `${base}/images/work-finale.svg`,
    imageAlt: 'Kadr orkiestry i chóru w filharmonii — Koncert Finale',
  },
  {
    index: '02',
    category: 'Sylwetka & Doświadczenie',
    title: 'Bio, Edukacja & Warsztat',
    description: 'Ścieżka akademicka na UWM z wyróżnieniem, PSM I i II stopnia, instrumentarium oraz warsztat studyjny.',
    link: `${base}/bio`,
    image: `${base}/images/bio-stage.svg`,
    imageAlt: 'Kadr ze spektaklu operetkowego — scena teatralna',
  },
  {
    index: '03',
    category: 'Inżynieria Dźwięku & Software',
    title: 'Laboratorium Technologiczne',
    description: 'Przestrzeń inżynierii dźwięku i oprogramowania scenicznego: silnik StageSync oraz narzędzia analizy partytur.',
    link: `${base}/lab`,
    image: `${base}/images/work-echo-epok.svg`,
    imageAlt: 'Reżyserka dźwięku i instrumentarium studyjne',
  },
];
---

<BaseLayout
  title="Kacper Czeczot — Dyrygent, Muzyk & Reżyser Dźwięku"
  description="Oficjalne portfolio artystyczne Kacpra Czeczota: dyrygentura symfoniczna i chóralna, wykonawstwo sceniczne, dzieła autorskie oraz warsztat twórczy."
>
  <Hero />

  <RadialGraph />

  <section class="py-24 border-t border-white/10 bg-[#070d1a]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <header class="mb-12 max-w-2xl space-y-3">
        <p class="text-xs font-sans uppercase tracking-[0.28em] text-sky-400">Domeny działalności</p>
        <h2 class="text-4xl sm:text-5xl font-display font-semibold text-white leading-tight">
          Wymiary twórczości
        </h2>
        <p class="text-slate-400 font-sans font-light leading-relaxed">
          Katalog dorobku dyrygenckiego, dzieł autorskich i zaplecza studyjnego.
        </p>
      </header>

      <nav aria-label="Katalog sekcji" class="border-t border-white/10">
        {directory.map((item) => (
          <a
            href={item.link}
            class="group grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 py-10 border-b border-white/10 editorial-hover px-0 lg:px-2"
          >
            <div class="lg:col-span-7 flex gap-5 sm:gap-8">
              <span class="text-xs font-sans text-slate-500 pt-2 tabular-nums">{item.index}</span>
              <div class="space-y-3 min-w-0">
                <p class="text-xs tracking-widest text-sky-400 font-sans uppercase">{item.category}</p>
                <h3 class="text-2xl sm:text-3xl lg:text-4xl font-display text-white group-hover:text-sky-300 transition-colors leading-tight">
                  {item.title}
                </h3>
                <p class="text-sm sm:text-base text-slate-400 font-sans font-light leading-relaxed max-w-xl">
                  {item.description}
                </p>
                <p class="pt-2 text-[11px] font-sans uppercase tracking-[0.2em] text-sky-400/80 flex items-center gap-2">
                  <span>Zobacz więcej</span>
                  <span aria-hidden="true" class="transition-transform duration-500 group-hover:translate-x-1">→</span>
                </p>
              </div>
            </div>

            <div class="lg:col-span-5 hidden lg:block">
              <div class="overflow-hidden border border-white/10 aspect-video bg-[#0b1528]">
                <img
                  src={item.image}
                  alt={item.imageAlt}
                  class="w-full h-full object-cover opacity-80 group-hover:scale-105 group-hover:opacity-100 transition-all duration-500"
                />
              </div>
            </div>
          </a>
        ))}
      </nav>
    </div>
  </section>
</BaseLayout>
