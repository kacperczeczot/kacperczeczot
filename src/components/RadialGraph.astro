                        <img src={fullPhotoUrl} alt={ens.data.name} class="w-full h-full object-cover opacity-85 hover:opacity-100 transition-opacity" loading="lazy" />
                      </button>
                    );
                  })}
                </div>
              )}
            </div>
          ))
        ))}
      </div>

    </div>

  </div>
</section>

<!-- Scoped Styles -->
<style>
  .interactive-bubble {
    will-change: transform;
  }
</style>

<!-- Client Script for 3-Level Interactive Zoom and True Individual Proximity Physics -->
<script define:vars={{ categoriesPayload }}>
  const container = document.getElementById('zoomable-canvas-container');
  const level1 = document.getElementById('canvas-level-1');
  const level2 = document.getElementById('canvas-level-2');
  const level3 = document.getElementById('canvas-level-3');

  const btnBackTo1 = document.getElementById('btn-back-to-level-1');
  const btnBackTo2 = document.getElementById('btn-back-to-level-2');
  const btnBackTo2Text = document.getElementById('btn-back-to-level-2-text');
  const btnLevel3ToRoot = document.getElementById('btn-level-3-to-root');

  const level2CatBadge = document.getElementById('level-2-cat-badge');
  const level2CatTitle = document.getElementById('level-2-cat-title');
  const level2BubblesContainer = document.getElementById('level-2-bubbles-container');

  const level3RoleBadge = document.getElementById('level-3-role-badge');
  const level3Name = document.getElementById('level-3-ensemble-name');
  const level3ConcertCount = document.getElementById('level-3-concert-count');
  const level3Highlights = document.getElementById('level-3-highlights-list');
  const level3Desc = document.getElementById('level-3-description-text');
  const level3Photos = document.getElementById('level-3-photos-grid');

  let currentLevel = 1;
  let activeCategory = null;
  let activeEnsemble = null;

  // Magnetic Parallax Physics State
  let mouseClientX = -9999;
  let mouseClientY = -9999;
  let isMouseInside = false;

  let physicsNodes = [];

  function registerPhysicsNodes(elements, containerRect) {
    physicsNodes = [];
    if (!elements || elements.length === 0 || !containerRect) return;

    elements.forEach((el, index) => {
      const rect = el.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;

      physicsNodes.push({
        element: el,
        baseCenterX: centerX,
        baseCenterY: centerY,
        currentX: 0,
        currentY: 0,
        targetX: 0,
        targetY: 0,
        // Individual spring speed and magnetic depth per bubble
        lerpFactor: 0.065 + (index % 3) * 0.015,
        parallaxDepth: el.id === 'bubble-center' ? 6 : (8 + (index % 3) * 2),
        maxMagneticPull: el.id === 'bubble-center' ? 12 : (18 + (index % 3) * 3),
      });
    });
  }

  function initPhysicsForCurrentLevel() {
    if (!container) return;
    const containerRect = container.getBoundingClientRect();

    if (currentLevel === 1 && level1) {
      const elements = level1.querySelectorAll('[data-physics-bubble]');
      registerPhysicsNodes(elements, containerRect);
    } else if (currentLevel === 2 && level2BubblesContainer) {
      const elements = level2BubblesContainer.querySelectorAll('[data-ensemble-bubble]');
      registerPhysicsNodes(elements, containerRect);
    } else {
      physicsNodes = [];
    }
  }

  // Continuous Magnetic Attraction & Parallax Loop
  const MAGNETIC_RADIUS = 380; // Smooth magnetic attraction range

  function updatePhysicsLoop() {
    if (physicsNodes.length > 0 && container) {
      const containerRect = container.getBoundingClientRect();
      const containerCenterX = containerRect.left + containerRect.width / 2;
      const containerCenterY = containerRect.top + containerRect.height / 2;

      // Normalized mouse offset from canvas center (-1 to 1)
      const normX = Math.max(-1, Math.min(1, (mouseClientX - containerCenterX) / (containerRect.width / 2)));
      const normY = Math.max(-1, Math.min(1, (mouseClientY - containerCenterY) / (containerRect.height / 2)));

      physicsNodes.forEach((node) => {
        if (isMouseInside) {
          // 1. Continuous Parallax Float across entire canvas
          const globalX = normX * node.parallaxDepth;
          const globalY = normY * node.parallaxDepth;

          // 2. Local Magnetic Pull towards cursor as it gets closer
          const dx = mouseClientX - node.baseCenterX;
          const dy = mouseClientY - node.baseCenterY;
          const dist = Math.hypot(dx, dy);

          let magneticX = 0;
          let magneticY = 0;

          if (dist < MAGNETIC_RADIUS && dist > 1) {
            // Smooth quadratic falloff towards cursor
            const falloff = Math.pow(1 - dist / MAGNETIC_RADIUS, 1.8);
            const pull = falloff * node.maxMagneticPull;
            const angle = Math.atan2(dy, dx);
            magneticX = Math.cos(angle) * pull;
            magneticY = Math.sin(angle) * pull;
          }

          node.targetX = globalX + magneticX;
          node.targetY = globalY + magneticY;
        } else {
          node.targetX = 0;
          node.targetY = 0;
        }

        // Smooth standard spring damping (lerp)
        node.currentX += (node.targetX - node.currentX) * node.lerpFactor;
        node.currentY += (node.targetY - node.currentY) * node.lerpFactor;

        node.element.style.transform = `translate(calc(-50% + ${node.currentX.toFixed(2)}px), calc(-50% + ${node.currentY.toFixed(2)}px))`;
      });
    }

    requestAnimationFrame(updatePhysicsLoop);
  }

  if (container) {
    container.addEventListener('mousemove', (e) => {
      mouseClientX = e.clientX;
      mouseClientY = e.clientY;
      isMouseInside = true;
    });

    container.addEventListener('mouseenter', (e) => {
      mouseClientX = e.clientX;
      mouseClientY = e.clientY;
      isMouseInside = true;
      initPhysicsForCurrentLevel();
    });

    container.addEventListener('mouseleave', () => {
      isMouseInside = false;
      mouseClientX = -9999;
      mouseClientY = -9999;
    });

    window.addEventListener('resize', () => {
      initPhysicsForCurrentLevel();
    });

    requestAnimationFrame(updatePhysicsLoop);
    setTimeout(initPhysicsForCurrentLevel, 200);
  }

  // Level 1 -> Level 2: Expand Category into Organic Constellation
  function goToLevel2(catId) {
    const category = categoriesPayload.find((c) => c.id === catId);
    if (!category || !level1 || !level2 || !level2BubblesContainer) return;

    activeCategory = category;
    currentLevel = 2;

    level2CatBadge.textContent = `${category.count}`;
    level2CatTitle.textContent = category.name;
    if (btnBackTo2Text) btnBackTo2Text.textContent = `Wróć do: ${category.name}`;

    // Populate Level 2 Ensemble Bubbles in Dynamic Organic Constellation
    level2BubblesContainer.innerHTML = '';
    const ensembles = category.ensembles;
    const count = ensembles.length;

    // Constellation layout positions
    // For 3 ensembles: Organic Triangle (Top-center, Bottom-left, Bottom-right)
    // For 2 ensembles: Diagonal Staggered Balance (Left-up, Right-down)
    const positions = count === 3
      ? [
          { left: '50%', top: '34%', size: 'w-48 h-48 sm:w-52 sm:h-52' }, // Główny na górze
          { left: '28%', top: '66%', size: 'w-44 h-44 sm:w-48 sm:h-48' }, // Lewy na dole
          { left: '72%', top: '64%', size: 'w-44 h-44 sm:w-48 sm:h-48' }, // Prawy na dole
        ]
      : [
          { left: '34%', top: '44%', size: 'w-48 h-48 sm:w-52 sm:h-52' }, // Lewy wyżej
          { left: '66%', top: '56%', size: 'w-48 h-48 sm:w-52 sm:h-52' }, // Prawy niżej
        ];

    ensembles.forEach((ens, index) => {
      const pos = positions[index] || { left: '50%', top: '50%', size: 'w-48 h-48' };
      const bubble = document.createElement('div');
      bubble.setAttribute('data-ensemble-bubble', ens.slug);
      bubble.setAttribute('role', 'button');
      bubble.setAttribute('tabindex', '0');
      bubble.className = 'interactive-bubble absolute cursor-pointer group z-30 focus:outline-none';
      bubble.style.left = pos.left;
      bubble.style.top = pos.top;
      bubble.style.transform = 'translate(-50%, -50%)';

      bubble.innerHTML = `
        <div class="relative flex flex-col items-center justify-center ${pos.size} rounded-full backdrop-blur-xl bg-gradient-to-br from-sky-900/70 via-sky-950/85 to-[#070d1a]/95 border-2 border-sky-400/40 hover:border-sky-300 hover:scale-105 shadow-[0_0_30px_rgba(14,165,233,0.3)] hover:shadow-[0_0_45px_rgba(56,189,248,0.55)] transition-all duration-300 p-4 text-center">
          
          <span class="text-xs font-sans font-bold uppercase tracking-wider text-sky-300 px-3 py-1 rounded-full bg-[#070d1a]/90 border border-sky-400/30 mb-1.5 max-w-[90%] truncate">
            ${ens.role}
          </span>

          <h4 class="font-display font-bold text-base sm:text-lg text-white group-hover:text-sky-200 transition-colors leading-snug px-2 line-clamp-2">
            ${ens.name}
          </h4>

          <span class="text-xs sm:text-sm font-sans text-sky-200/80 font-medium mt-1">
            ${ens.concertCount}
          </span>
        </div>
      `;

      bubble.addEventListener('click', () => {
        goToLevel3(ens);
      });

      level2BubblesContainer.appendChild(bubble);
    });

    // Smooth level transitions
    level1.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
    level1.classList.add('opacity-0', 'scale-110', 'pointer-events-none');

    level2.classList.remove('opacity-0', 'scale-90', 'pointer-events-none');
    level2.classList.add('opacity-100', 'scale-100', 'pointer-events-auto');

    setTimeout(initPhysicsForCurrentLevel, 50);
  }

  // Level 2 -> Level 1: Back to Categories
  function goToLevel1() {
    currentLevel = 1;
    activeCategory = null;

    if (level2) {
      level2.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
      level2.classList.add('opacity-0', 'scale-90', 'pointer-events-none');
    }

    if (level3) {
      level3.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
      level3.classList.add('opacity-0', 'scale-90', 'pointer-events-none');
    }

    if (level1) {
      level1.classList.remove('opacity-0', 'scale-110', 'pointer-events-none');
      level1.classList.add('opacity-100', 'scale-100', 'pointer-events-auto');
    }

    setTimeout(initPhysicsForCurrentLevel, 50);
  }

  // Level 2 -> Level 3: Expand Ensemble Details inside diagram
  function goToLevel3(ensemble) {
    if (!level2 || !level3 || !ensemble) return;
    activeEnsemble = ensemble;
    currentLevel = 3;

    if (level3RoleBadge) level3RoleBadge.textContent = ensemble.role;
    if (level3Name) level3Name.textContent = ensemble.name;
    if (level3ConcertCount) level3ConcertCount.textContent = ensemble.concertCount;
    if (level3Desc) level3Desc.textContent = ensemble.body || 'Działalność wykonawcza i dyrygencka.';

    if (level3Highlights) {
      level3Highlights.innerHTML = '';
      (ensemble.highlights || []).forEach((h) => {
        const li = document.createElement('li');
        li.className = 'flex items-start gap-2 text-slate-300';
        li.innerHTML = `<span class="text-sky-400 font-bold">✦</span><span>${h}</span>`;
        level3Highlights.appendChild(li);
      });
    }

    if (level3Photos) {
      level3Photos.innerHTML = '';
      const photos = ensemble.photos || [];
      if (photos.length === 0) {
        level3Photos.innerHTML = `<p class="text-xs text-slate-500 col-span-2">Brak materiałów archiwalnych.</p>`;
      } else {
        photos.slice(0, 4).forEach((p) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.setAttribute('data-lightbox-src', p);
          btn.setAttribute('data-lightbox-alt', `${ensemble.name} — fotografia`);
          btn.className = 'group relative aspect-[16/10] overflow-hidden rounded-lg border border-white/10 bg-[#070d1a] focus:outline-none focus:ring-2 focus:ring-sky-400 text-left';
          btn.innerHTML = `
            <img src="${p}" alt="${ensemble.name}" class="w-full h-full object-cover opacity-85 group-hover:opacity-100 group-hover:scale-105 transition-all duration-300" loading="lazy" />
            <span class="absolute inset-0 bg-sky-500/10 opacity-0 group-hover:opacity-100 transition-opacity"></span>
          `;
          level3Photos.appendChild(btn);
        });
      }
    }

    // Transitions
    level2.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
    level2.classList.add('opacity-0', 'scale-110', 'pointer-events-none');

    level3.classList.remove('opacity-0', 'scale-90', 'pointer-events-none');
    level3.classList.add('opacity-100', 'scale-100', 'pointer-events-auto');

    physicsNodes = [];
  }

  // Category buttons click in Level 1
  document.querySelectorAll('.category-orb-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const catId = btn.getAttribute('data-cat-id');
      if (catId) goToLevel2(catId);
    });
  });

  if (btnBackTo1) btnBackTo1.addEventListener('click', goToLevel1);
  if (btnLevel3ToRoot) btnLevel3ToRoot.addEventListener('click', goToLevel1);
  if (btnBackTo2) {
    btnBackTo2.addEventListener('click', () => {
      if (activeCategory) {
        if (level3) {
          level3.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
          level3.classList.add('opacity-0', 'scale-90', 'pointer-events-none');
        }
        if (level2) {
          level2.classList.remove('opacity-0', 'scale-110', 'pointer-events-none');
          level2.classList.add('opacity-100', 'scale-100', 'pointer-events-auto');
        }
        currentLevel = 2;
        setTimeout(initPhysicsForCurrentLevel, 50);
      } else {
        goToLevel1();
      }
    });
  }

  // Mobile Tabs
  const mobileCatBtns = document.querySelectorAll('[data-mobile-cat-btn]');
  const mobileCards = document.querySelectorAll('[data-mobile-cat-parent]');

  mobileCatBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const catId = btn.getAttribute('data-mobile-cat-btn');
      if (!catId) return;

      mobileCatBtns.forEach((b) => {
        b.classList.remove('bg-sky-600', 'border-sky-400', 'text-white', 'shadow-md', 'shadow-sky-600/30');
        b.classList.add('bg-sky-950/40', 'border-sky-400/20', 'text-slate-300');
      });

      btn.classList.remove('bg-sky-950/40', 'border-sky-400/20', 'text-slate-300');
      btn.classList.add('bg-sky-600', 'border-sky-400', 'text-white', 'shadow-md', 'shadow-sky-600/30');

      mobileCards.forEach((card) => {
        const parent = card.getAttribute('data-mobile-cat-parent');
        if (parent === catId) {
          card.classList.remove('hidden');
          card.classList.add('block');
        } else {
          card.classList.remove('block');
          card.classList.add('hidden');
        }
      });
    });
  });
</script>
