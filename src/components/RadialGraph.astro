                    {ens.data.concertCount}
                  </span>
                </div>

                <h3 class="font-display font-bold text-xl sm:text-2xl text-white group-hover:text-sky-300 transition-colors leading-snug">
                  {ens.data.name}
                </h3>

                <p class="text-sm text-slate-300 font-sans font-light leading-relaxed">
                  {ens.body}
                </p>

                <!-- Highlights on Mobile -->
                {ens.data.highlights && ens.data.highlights.length > 0 && (
                  <ul class="pt-2 border-t border-white/10 space-y-1.5 text-sm text-slate-300">
                    {ens.data.highlights.slice(0, 2).map((h) => (
                      <li class="flex items-start gap-2">
                        <span class="text-sky-400 font-bold">✦</span>
                        <span>{h}</span>
                      </li>
