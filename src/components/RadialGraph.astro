              <!-- Photos Grid on Mobile -->
              {ens.data.photos && ens.data.photos.length > 0 && (
                <div class="mt-4 pt-3 border-t border-white/10 grid grid-cols-2 gap-2">
                  {ens.data.photos.slice(0, 2).map((p) => {
                    const fullPhotoUrl = p.startsWith('/') ? `${base}${p}` : p;
                    return (
                      <button
                        type="button"
                        data-lightbox-src={fullPhotoUrl}
                        data-lightbox-alt={`${ens.data.name} — kadr`}
