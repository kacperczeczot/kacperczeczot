---
import { getCollection } from 'astro:content';
import {
  Sparkles,
  Music,
  Mic,
  Drama,
  Radio,
  ArrowLeft,
  ArrowUpRight,
  Maximize2,
  Calendar,
  Award,
  Users,
} from 'lucide-astro';
import { base } from '../utils/cms';

// Fetch all verified ensembles from Content Collections
const allEnsembles = await getCollection('ensembles');

// Group ensembles by category
const orkiestry = allEnsembles.filter(e => e.data.pillar === 'orkiestry').sort((a, b) => a.data.order - b.data.order);
const chory = allEnsembles.filter(e => e.data.pillar === 'chory').sort((a, b) => a.data.order - b.data.order);
const teatr = allEnsembles.filter(e => e.data.pillar === 'teatr').sort((a, b) => a.data.order - b.data.order);
const estrada = allEnsembles.filter(e => e.data.pillar === 'estrada').sort((a, b) => a.data.order - b.data.order);

// 4 Main Categories
function countLabel(n: number, one: string, few: string, many: string) {
  const mod10 = n % 10;
  const mod100 = n % 100;
  if (n === 1) return `1 ${one}`;
  if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) return `${n} ${few}`;
  return `${n} ${many}`;
}

const categories = [
  {
    id: 'orkiestry',
    name: 'Orkiestry',
    subtitle: 'Składy dęte i symfoniczne',
    count: countLabel(orkiestry.length, 'formacja', 'formacje', 'formacji'),
    pos: { x: 25, y: 28 },
    ensembles: orkiestry,
  },
  {
    id: 'chory',
    name: 'Chóry & Zespoły',
    subtitle: 'Składy wokalne & polifonia',
    count: countLabel(chory.length, 'skład', 'składy', 'składów'),
    pos: { x: 75, y: 28 },
    ensembles: chory,
  },
  {
    id: 'teatr',
    name: 'Scena & Teatr',
    subtitle: 'Operetka & musical',
    count: countLabel(teatr.length, 'produkcja', 'produkcje', 'produkcji'),
    pos: { x: 75, y: 72 },
    ensembles: teatr,
  },
  {
    id: 'estrada',
    name: 'Kameralistyka & Estrada',
    subtitle: 'Live sound & składy estradowe',
    count: countLabel(estrada.length, 'zespół', 'zespoły', 'zespołów'),
    pos: { x: 25, y: 72 },
    ensembles: estrada,
  },
];

// Clean JSON payload for client-side zoom transitions
const categoriesPayload = categories.map(cat => ({
  id: cat.id,
  name: cat.name,
  subtitle: cat.subtitle,
  count: cat.count,
  ensembles: cat.ensembles.map(ens => ({
    slug: ens.slug,
    name: ens.data.name,
    categoryName: cat.name,
    role: ens.data.role,
    years: ens.data.years || '',
    concertCount: ens.data.concertCount || '',
    highlights: ens.data.highlights,
    body: ens.body,
    photos: (ens.data.photos || []).filter(Boolean).map(p => (p.startsWith('/') ? `${base}${p}` : p)),
  })),
}));
---

<section id="drzewo-radialne" class="relative pt-24 pb-6 lg:pb-8 overflow-hidden bg-ocean-950 select-none">
  
  <!-- Ambient background glow spots -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[70vmin] h-[70vmin] bg-sky-500/10 rounded-full blur-[140px] pointer-events-none"></div>
  <div class="absolute top-1/4 left-1/4 w-[40vmin] h-[40vmin] bg-blue-600/10 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-1/4 right-1/4 w-[45vmin] h-[45vmin] bg-cyan-500/10 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="w-full max-w-[100rem] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div id="radial-graph-header" class="text-center max-w-3xl mx-auto mb-6 lg:mb-8 space-y-3">
      <div class="inline-flex items-center gap-2.5 text-sky-200 text-xs font-sans uppercase tracking-[0.28em]">
        <Sparkles class="w-3.5 h-3.5 text-sky-400" />
        <span>Działalność Zespołowa</span>
      </div>
      
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-white tracking-tight leading-tight">
        Działalność Sceniczna i <span class="text-blue-gradient">Zespołowa</span>
      </h1>
      
      <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto font-sans font-light leading-relaxed">
        Orkiestry dęte i symfoniczne, chóry akademickie i kameralne, teatr muzyczny i operetka oraz zespoły estradowe.
      </p>
    </div>

    <!-- ======================================================= -->
    <!-- DESKTOP INTERACTIVE ZOOM CANVAS (>= 1024px)             -->
    <!-- ======================================================= -->
    <div
      id="zoomable-canvas-container"
      class="hidden lg:block relative w-full mx-auto rounded-3xl border border-white/10 bg-gradient-to-b from-ocean-900/90 via-ocean-950/95 to-ocean-900/90 backdrop-blur-2xl overflow-hidden shadow-2xl shadow-sky-950/50"
    >
      <!-- Soft ambient backdrop rings -->
      <div id="canvas-backdrop-rings" class="absolute inset-0 flex items-center justify-center pointer-events-none transition-opacity duration-500">
        <div class="w-[70%] max-h-[70%] aspect-square rounded-full border border-sky-400/10"></div>
        <div class="absolute w-[46%] max-h-[46%] aspect-square rounded-full border border-sky-400/15"></div>
        <div class="absolute w-[28%] max-h-[28%] aspect-square rounded-full bg-sky-500/10 blur-2xl"></div>
      </div>

      <!-- ========================================== -->
      <!-- LEVEL 1: CATEGORIES OVERVIEW               -->
      <!-- ========================================== -->
      <div id="canvas-level-1" class="absolute inset-0 transition-all duration-500 opacity-100 scale-100 pointer-events-auto">
        
        <!-- 1. Central Orb -->
        <div
          id="bubble-center"
          data-physics-bubble
          data-base-x="50"
          data-base-y="50"
          style="left: 50%; top: 50%;"
          class="interactive-bubble absolute -translate-x-1/2 -translate-y-1/2 z-20"
        >
          <div class="orb-center relative flex flex-col items-center justify-center rounded-full backdrop-blur-xl bg-gradient-to-br from-sky-900/70 via-sky-950/85 to-ocean-950/95 border-2 border-sky-400/45 shadow-[0_0_35px_rgba(14,165,233,0.25)]">
            <span class="text-xs sm:text-[13px] font-sans font-bold uppercase tracking-[0.2em] text-sky-300 mb-1.5">
              Dorobek Sceniczny
            </span>
            <span class="font-display font-extrabold text-4xl sm:text-5xl text-blue-gradient tracking-tight">
              300+
            </span>
            <span class="text-sm sm:text-base font-display font-bold text-slate-100 uppercase tracking-wider text-center px-4 leading-tight mt-1.5">
              Występów
            </span>
          </div>
        </div>

        <!-- 2. Four Category Orbs -->
        {categories.map((cat) => {
          let IconComponent = Music;
          if (cat.id === 'chory') IconComponent = Mic;
          if (cat.id === 'teatr') IconComponent = Drama;
          if (cat.id === 'estrada') IconComponent = Radio;

          return (
            <div
              id={`cat-bubble-${cat.id}`}
              data-cat-id={cat.id}
              data-physics-bubble
              data-base-x={cat.pos.x}
              data-base-y={cat.pos.y}
              role="button"
              tabindex="0"
              style={`left: ${cat.pos.x}%; top: ${cat.pos.y}%;`}
              class="interactive-bubble category-orb-btn absolute -translate-x-1/2 -translate-y-1/2 z-20 cursor-pointer group focus:outline-none"
            >
              <div class="orb-category relative flex flex-col items-center justify-center rounded-full backdrop-blur-md bg-gradient-to-br from-sky-900/50 via-sky-950/75 to-ocean-950/90 border border-sky-400/35 hover:border-sky-300 hover:scale-105 shadow-lg shadow-sky-950/60 hover:shadow-[0_0_35px_rgba(14,165,233,0.4)] transition-all duration-300 p-4 text-center">
                
                <span class="p-3.5 rounded-full bg-sky-950/80 border border-sky-400/30 text-sky-300 mb-2.5 shadow-inner group-hover:text-white group-hover:border-sky-300 transition-all">
                  <IconComponent class="w-7 h-7" />
                </span>

                <span class="font-display font-bold text-base sm:text-lg text-slate-100 leading-tight group-hover:text-sky-200 transition-colors px-2">
                  {cat.name}
                </span>
              </div>
            </div>
          );
        })}

      </div>

      <!-- ========================================== -->
      <!-- LEVEL 2: EXPANDED CATEGORY ENSEMBLES       -->
      <!-- ========================================== -->
      <div
        id="canvas-level-2"
        class="absolute inset-0 transition-all duration-500 opacity-0 scale-90 pointer-events-none z-30 flex flex-col px-9 py-8"
      >
        <!-- Level 2 Navigation Bar -->
        <div id="level-2-toolbar" class="flex items-center justify-between pb-4 border-b border-white/10 flex-shrink-0 z-40 gap-4">
          <button
            id="btn-back-to-level-1"
            type="button"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-sky-950/80 border border-sky-400/30 text-sky-200 hover:text-white hover:border-sky-300 text-sm font-sans uppercase tracking-wider font-semibold transition-all focus:outline-none flex-shrink-0"
          >
            <ArrowLeft class="w-4 h-4" />
            <span>Wszystkie kategorie</span>
          </button>

          <h3 id="level-2-cat-title" class="font-display font-bold text-2xl text-white tracking-tight truncate">
            Nazwa kategorii
          </h3>
        </div>

        <!-- Level 2 Floating Ensembles Organic Cluster -->
        <div id="level-2-bubbles-container" class="relative flex-1 w-full h-full overflow-hidden">
          <!-- Dynamically populated ensemble bubbles in constellation layout -->
        </div>
      </div>

      <!-- ========================================== -->
      <!-- LEVEL 3: EXPANDED ENSEMBLE FULL VIEW       -->
      <!-- ========================================== -->
      <div
        id="canvas-level-3"
        class="absolute inset-0 transition-all duration-500 opacity-0 scale-90 pointer-events-none z-40 flex flex-col px-9 py-8 bg-gradient-to-b from-ocean-900 via-ocean-950 to-ocean-900"
      >
        <!-- Level 3 Navigation Bar -->
        <div class="flex items-center justify-between pb-4 border-b border-white/10 flex-shrink-0 z-50 gap-4">
          <button
            id="btn-back-to-level-2"
            type="button"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-sky-950/80 border border-sky-400/30 text-sky-200 hover:text-white hover:border-sky-300 text-sm font-sans uppercase tracking-wider font-semibold transition-all focus:outline-none"
          >
            <ArrowLeft class="w-4 h-4" />
            <span id="btn-back-to-level-2-text">Wróć do listy zespołów</span>
          </button>

          <button
            id="btn-level-3-to-root"
            type="button"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-sky-950/80 border border-sky-400/30 text-sky-200 hover:text-white hover:border-sky-300 text-sm font-sans uppercase tracking-wider font-semibold transition-all focus:outline-none"
          >
            <span>Wszystkie kategorie</span>
          </button>
        </div>

        <!-- Level 3 Content Grid -->
        <div class="flex-1 overflow-y-auto pt-6 space-y-6 scrollbar-none pr-1">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- Left Column: Details & Highlights -->
            <div class="lg:col-span-7 space-y-6">
              <div>
                <span id="level-3-role-badge" class="px-3.5 py-1 rounded-full text-xs sm:text-sm font-sans font-bold uppercase tracking-wider bg-sky-950/80 text-sky-300 border border-sky-400/30">
                  Rola
                </span>
                <h3 id="level-3-ensemble-name" class="text-3xl sm:text-4xl font-display font-bold text-white tracking-tight mt-3 leading-tight">
                  Nazwa Zespołu
                </h3>
              </div>

              <!-- Highlights -->
              <div class="space-y-2.5">
                <h4 class="text-sm font-sans font-bold uppercase tracking-[0.2em] text-sky-400">
                  Kluczowe osiągnięcia i projekty
                </h4>
                <ul id="level-3-highlights-list" class="space-y-2.5 text-base text-slate-300 font-sans font-light leading-relaxed">
                  <!-- Highlights items -->
                </ul>
              </div>

              <!-- Description -->
              <div class="space-y-2.5">
                <h4 class="text-sm font-sans font-bold uppercase tracking-[0.2em] text-slate-400">
                  Profil działalności
                </h4>
                <p id="level-3-description-text" class="text-base text-slate-300 font-sans font-light leading-relaxed">
                  Opis formacji...
                </p>
              </div>
            </div>

            <!-- Right Column: Photos Grid & Metadata Tiles -->
            <div class="lg:col-span-5 space-y-5">
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <h4 class="text-sm font-sans font-bold uppercase tracking-[0.2em] text-sky-400">
                    Kadry i materiały archiwalne
                  </h4>
                </div>
                <div id="level-3-photos-grid" class="grid grid-cols-2 gap-3">
                  <!-- Dynamic photos with lightbox support -->
                </div>
              </div>

              <!-- Metryka działalności formacji -->
              <div class="pt-4 border-t border-white/10 space-y-2.5">
                <h4 class="text-xs font-sans font-bold uppercase tracking-[0.2em] text-slate-400">
                  Metryka działalności
                </h4>
                <div class="grid grid-cols-2 gap-2 text-xs font-sans">
                  <div class="p-3 rounded-xl bg-sky-950/40 border border-white/10 space-y-1">
                    <span class="text-slate-400 block text-[10px] uppercase tracking-wider font-semibold">Okres współpracy</span>
                    <span id="level-3-meta-years" class="text-slate-100 font-medium text-xs block truncate">—</span>
                  </div>
                  <div class="p-3 rounded-xl bg-sky-950/40 border border-white/10 space-y-1">
                    <span class="text-slate-400 block text-[10px] uppercase tracking-wider font-semibold">Występy / Dorobek</span>
                    <span id="level-3-meta-concerts" class="text-sky-300 font-medium text-xs block truncate">—</span>
                  </div>
                </div>
              </div>

            </div>

          </div>
        </div>

      </div>

    </div>

    <!-- ======================================================= -->
    <!-- MOBILE / TABLET TOUCH SECTION (< 1024px)                -->
    <!-- ======================================================= -->
    <div class="block lg:hidden space-y-6">
      
      <!-- Mobile Overview Header -->
      <div class="flex items-center justify-between p-5 rounded-2xl backdrop-blur-md bg-gradient-to-r from-sky-950/60 to-ocean-950 border border-sky-400/30 shadow-lg">
        <div class="space-y-1">
          <span class="text-xs font-sans uppercase tracking-widest text-sky-300 font-semibold">
            Dorobek Artystyczny
          </span>
          <h3 class="text-2xl sm:text-3xl font-display font-bold text-white tracking-tight">
            300+ Występów
          </h3>
          <p class="text-sm text-slate-300 font-sans">
            W 4 kategoriach wykonawczych i dyrygenckich
          </p>
        </div>
        <div class="w-12 h-12 rounded-full bg-sky-500/20 border border-sky-400/40 flex items-center justify-center flex-shrink-0">
          <Sparkles class="w-6 h-6 text-sky-300" />
        </div>
      </div>

      <!-- Mobile Category Tabs -->
      <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none snap-x" id="mobile-cat-ribbon">
        {categories.map((cat, idx) => {
          let IconComponent = Music;
          if (cat.id === 'chory') IconComponent = Mic;
          if (cat.id === 'teatr') IconComponent = Drama;
          if (cat.id === 'estrada') IconComponent = Radio;

          return (
            <button
              type="button"
              data-mobile-cat-btn={cat.id}
              class={`mobile-cat-tab-btn flex items-center gap-2.5 px-5 py-3.5 rounded-full border text-sm font-sans tracking-wide uppercase font-semibold whitespace-nowrap transition-all snap-start flex-shrink-0 backdrop-blur-md ${
                idx === 0
                  ? 'bg-sky-600 border-sky-400 text-white shadow-md shadow-sky-600/30'
                  : 'bg-sky-950/40 border-sky-400/20 text-slate-300 hover:text-white'
              }`}
            >
              <IconComponent class="w-4 h-4" />
              <span>{cat.name}</span>
            </button>
          );
        })}
      </div>

      <!-- Mobile Ensembles Grid -->
      <div id="mobile-ensembles-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {categories.map((cat, cIdx) => (
          cat.ensembles.map((ens) => (
            <div
              data-mobile-cat-parent={cat.id}
              class={`mobile-ensemble-card p-6 rounded-2xl backdrop-blur-md bg-gradient-to-b from-sky-950/40 to-ocean-950 border border-sky-400/25 hover:border-sky-300 transition-all flex flex-col justify-between group shadow-lg ${
                cIdx === 0 ? 'block' : 'hidden'
              }`}
            >
              <div class="space-y-4">
                <div class="flex items-center justify-between gap-2">
                  <span class="px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-sky-950/80 text-sky-300 border border-sky-400/30 font-sans">
                    {ens.data.role}
                  </span>
                  <span class="text-xs sm:text-sm text-sky-200/80 font-medium font-sans">
                    {[ens.data.years, ens.data.concertCount].filter(Boolean).join(' · ')}
                  </span>
                </div>

                <h3 class="font-display font-bold text-xl sm:text-2xl text-white group-hover:text-sky-300 transition-colors leading-snug">
                  {ens.data.name}
                </h3>

                <p class="text-sm text-slate-300 font-sans font-light leading-relaxed">
                  {ens.body}
                </p>

                <!-- Highlights on Mobile -->
                {ens.data.highlights && ens.data.highlights.length > 0 && (
                  <ul class="pt-2 border-t border-white/10 space-y-1.5 text-sm text-slate-300">
                    {ens.data.highlights.slice(0, 2).map((h) => (
                      <li class="flex items-start gap-2">
                        <span class="text-sky-400 font-bold">✦</span>
                        <span>{h}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>

              <!-- Photos Grid on Mobile -->
              {ens.data.photos && ens.data.photos.length > 0 && (
                <div class="mt-4 pt-3 border-t border-white/10 grid grid-cols-2 gap-2">
                  {ens.data.photos.slice(0, 2).map((p) => {
                    const fullPhotoUrl = p.startsWith('/') ? `${base}${p}` : p;
                    return (
                      <button
                        type="button"
                        data-lightbox-src={fullPhotoUrl}
                        data-lightbox-alt={`${ens.data.name} — kadr`}
                        class="aspect-[16/10] overflow-hidden rounded-lg border border-white/10 bg-ocean-900 focus:outline-none focus:ring-2 focus:ring-sky-400"
                      >
                        <img src={fullPhotoUrl} alt={ens.data.name} class="w-full h-full object-cover opacity-85 hover:opacity-100 transition-opacity" loading="lazy" />
                      </button>
                    );
                  })}
                </div>
              )}
            </div>
          ))
        ))}
      </div>

    </div>

  </div>
</section>

<!-- Scoped Styles -->
<style>
  .interactive-bubble {
    will-change: transform;
  }

  #zoomable-canvas-container {
    --tile-scale: 1;
    height: calc(100dvh - 13.5rem);
    min-height: 32rem;
  }

  #zoomable-canvas-container .orb-center {
    width: calc(14rem * var(--tile-scale));
    height: calc(14rem * var(--tile-scale));
  }

  #zoomable-canvas-container .orb-category {
    width: calc(12rem * var(--tile-scale));
    height: calc(12rem * var(--tile-scale));
  }
</style>

<!-- Client Script for 3-Level Interactive Zoom and True Individual Proximity Physics -->
<script define:vars={{ categoriesPayload }}>
  const container = document.getElementById('zoomable-canvas-container');
  const level1 = document.getElementById('canvas-level-1');
  const level2 = document.getElementById('canvas-level-2');
  const level3 = document.getElementById('canvas-level-3');
  const backdropRings = document.getElementById('canvas-backdrop-rings');

  function setBackdropRingsVisible(visible) {
    if (!backdropRings) return;
    backdropRings.classList.toggle('opacity-0', !visible);
  }

  const btnBackTo1 = document.getElementById('btn-back-to-level-1');
  const btnBackTo2 = document.getElementById('btn-back-to-level-2');
  const btnBackTo2Text = document.getElementById('btn-back-to-level-2-text');
  const btnLevel3ToRoot = document.getElementById('btn-level-3-to-root');

  const level2CatTitle = document.getElementById('level-2-cat-title');
  const level2BubblesContainer = document.getElementById('level-2-bubbles-container');

  const level3RoleBadge = document.getElementById('level-3-role-badge');
  const level3Name = document.getElementById('level-3-ensemble-name');
  const level3ConcertCount = document.getElementById('level-3-concert-count');
  const level3Highlights = document.getElementById('level-3-highlights-list');
  const level3Desc = document.getElementById('level-3-description-text');
  const level3Photos = document.getElementById('level-3-photos-grid');

  let currentLevel = 1;
  let activeCategory = null;
  let activeEnsemble = null;
  let level2Interactive = false;

  // Magnetic Parallax Physics State
  let mouseClientX = -9999;
  let mouseClientY = -9999;
  let isMouseInside = false;

  let physicsNodes = [];

  function currentTileScale() {
    if (!container) return 1;
    const raw = getComputedStyle(container).getPropertyValue('--tile-scale');
    const parsed = parseFloat(raw);
    return Number.isFinite(parsed) && parsed > 0 ? parsed : 1;
  }

  function syncCanvasToWindow() {
    if (!container) return;
    if (window.matchMedia('(max-width: 1023px)').matches) {
      container.style.height = '';
      container.style.removeProperty('--tile-scale');
      return;
    }

    const section = document.getElementById('drzewo-radialne');
    const header = document.getElementById('radial-graph-header');
    const sectionStyles = section ? getComputedStyle(section) : null;
    const padTop = sectionStyles ? parseFloat(sectionStyles.paddingTop) || 0 : 0;
    const padBottom = sectionStyles ? parseFloat(sectionStyles.paddingBottom) || 0 : 0;
    const headerH = header ? header.offsetHeight : 0;
    const headerMb = header ? parseFloat(getComputedStyle(header).marginBottom) || 0 : 0;
    const height = Math.max(520, window.innerHeight - padTop - padBottom - headerH - headerMb);
    container.style.height = `${height}px`;

    const basis = Math.min(container.clientWidth, height);
    const scale = Math.max(0.9, Math.min(1.65, basis / 720));
    container.style.setProperty('--tile-scale', scale.toFixed(3));
  }

  function registerPhysicsNodes(elements, containerRect) {
    physicsNodes = [];
    if (!elements || elements.length === 0 || !containerRect) return;

    elements.forEach((el, index) => {
      const rect = el.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;

      physicsNodes.push({
        element: el,
        baseCenterX: centerX,
        baseCenterY: centerY,
        currentX: 0,
        currentY: 0,
        targetX: 0,
        targetY: 0,
        // Individual spring speed and magnetic depth per bubble
        lerpFactor: 0.065 + (index % 3) * 0.015,
        parallaxDepth: el.id === 'bubble-center' ? 6 : (8 + (index % 3) * 2),
        maxMagneticPull: el.id === 'bubble-center' ? 12 : (18 + (index % 3) * 3),
      });
    });
  }

  function initPhysicsForCurrentLevel() {
    if (!container) return;
    const containerRect = container.getBoundingClientRect();

    if (currentLevel === 1 && level1) {
      const elements = level1.querySelectorAll('[data-physics-bubble]');
      registerPhysicsNodes(elements, containerRect);
    } else if (currentLevel === 2 && level2BubblesContainer) {
      const elements = level2BubblesContainer.querySelectorAll('[data-ensemble-bubble]');
      registerPhysicsNodes(elements, containerRect);
    } else {
      physicsNodes = [];
    }
  }

  // Continuous Magnetic Attraction & Parallax Loop
  const MAGNETIC_RADIUS_BASE = 380;

  function updatePhysicsLoop() {
    if (physicsNodes.length > 0 && container) {
      const containerRect = container.getBoundingClientRect();
      const containerCenterX = containerRect.left + containerRect.width / 2;
      const containerCenterY = containerRect.top + containerRect.height / 2;
      const magneticRadius = MAGNETIC_RADIUS_BASE * currentTileScale();

      // Normalized mouse offset from canvas center (-1 to 1)
      const normX = Math.max(-1, Math.min(1, (mouseClientX - containerCenterX) / (containerRect.width / 2)));
      const normY = Math.max(-1, Math.min(1, (mouseClientY - containerCenterY) / (containerRect.height / 2)));

      physicsNodes.forEach((node) => {
        if (isMouseInside) {
          // 1. Continuous Parallax Float across entire canvas
          const globalX = normX * node.parallaxDepth;
          const globalY = normY * node.parallaxDepth;

          // 2. Local Magnetic Pull towards cursor as it gets closer
          const dx = mouseClientX - node.baseCenterX;
          const dy = mouseClientY - node.baseCenterY;
          const dist = Math.hypot(dx, dy);

          let magneticX = 0;
          let magneticY = 0;

          if (dist < magneticRadius && dist > 1) {
            // Smooth quadratic falloff towards cursor
            const falloff = Math.pow(1 - dist / magneticRadius, 1.8);
            const pull = falloff * node.maxMagneticPull;
            const angle = Math.atan2(dy, dx);
            magneticX = Math.cos(angle) * pull;
            magneticY = Math.sin(angle) * pull;
          }

          node.targetX = globalX + magneticX;
          node.targetY = globalY + magneticY;
        } else {
          node.targetX = 0;
          node.targetY = 0;
        }

        // Smooth standard spring damping (lerp)
        node.currentX += (node.targetX - node.currentX) * node.lerpFactor;
        node.currentY += (node.targetY - node.currentY) * node.lerpFactor;

        node.element.style.transform = `translate(calc(-50% + ${node.currentX.toFixed(2)}px), calc(-50% + ${node.currentY.toFixed(2)}px))`;
      });
    }

    requestAnimationFrame(updatePhysicsLoop);
  }

  if (container) {
    container.addEventListener('mousemove', (e) => {
      mouseClientX = e.clientX;
      mouseClientY = e.clientY;
      isMouseInside = true;
    });

    container.addEventListener('mouseenter', (e) => {
      mouseClientX = e.clientX;
      mouseClientY = e.clientY;
      isMouseInside = true;
      initPhysicsForCurrentLevel();
    });

    container.addEventListener('mouseleave', () => {
      isMouseInside = false;
      mouseClientX = -9999;
      mouseClientY = -9999;
    });

    window.addEventListener('resize', () => {
      syncCanvasToWindow();
      if (currentLevel === 2 && activeCategory) {
        goToLevel2(activeCategory.id);
      } else {
        initPhysicsForCurrentLevel();
      }
    });

    syncCanvasToWindow();
    requestAnimationFrame(updatePhysicsLoop);
    setTimeout(() => {
      syncCanvasToWindow();
      initPhysicsForCurrentLevel();
    }, 200);
  }

  // Level 1 -> Level 2: Expand Category into Organic Constellation
  function goToLevel2(catId) {
    const category = categoriesPayload.find((c) => c.id === catId);
    if (!category || !level1 || !level2 || !level2BubblesContainer) return;

    activeCategory = category;
    currentLevel = 2;

    level2CatTitle.textContent = category.name;
    if (btnBackTo2Text) btnBackTo2Text.textContent = `Wróć do: ${category.name}`;

    // Zigzag across the full canvas, then charge-repulsion packing
    level2BubblesContainer.innerHTML = '';
    const ensembles = category.ensembles;
    const count = ensembles.length;

    const positions = (() => {
      const w = Math.max(level2BubblesContainer.clientWidth || container?.clientWidth || 800, 320);
      const h = Math.max(level2BubblesContainer.clientHeight || (container?.clientHeight ?? 0) - 96, 280);
      const size = Math.round(Math.max(110, Math.min(
        210,
        Math.min(w / Math.max(count, 1) * 1.15, h * 0.42),
        Math.sqrt((w * h) / count) * 0.5
      )));
      const margin = size / 2 + 18;
      const minDist = size * 1.32;

      const pts = [];
      if (count === 1) {
        pts.push({ x: w * 0.5, y: h * 0.5 });
      } else {
        const startLow = count % 2 === 1;
        for (let i = 0; i < count; i++) {
          const t = (i + 0.5) / count;
          const x = margin + t * (w - 2 * margin);
          const high = startLow ? (i % 2 === 1) : (i % 2 === 0);
          const y = high ? h * 0.32 : h * 0.68;
          pts.push({ x, y });
        }
      }

      for (let iter = 0; iter < 180; iter++) {
        const damp = 0.18 * (1 - iter / 180);
        for (let i = 0; i < pts.length; i++) {
          let fx = 0;
          let fy = 0;
          for (let j = 0; j < pts.length; j++) {
            if (i === j) continue;
            const dx = pts[i].x - pts[j].x;
            const dy = pts[i].y - pts[j].y;
            const d = Math.hypot(dx, dy) || 0.01;
            if (d < minDist * 2.2) {
              const push = ((minDist * minDist) / (d * d)) * 14;
              fx += (dx / d) * push;
              fy += (dy / d) * push;
            }
          }
          fx += 28 / Math.max(pts[i].x - margin, 6);
          fx -= 28 / Math.max(w - margin - pts[i].x, 6);
          fy += 28 / Math.max(pts[i].y - margin, 6);
          fy -= 28 / Math.max(h - margin - pts[i].y, 6);

          pts[i].x += fx * damp;
          pts[i].y += fy * damp;
          pts[i].x = Math.min(w - margin, Math.max(margin, pts[i].x));
          pts[i].y = Math.min(h - margin, Math.max(margin, pts[i].y));
        }
      }

      return pts.map((p) => ({
        left: `${p.x}px`,
        top: `${p.y}px`,
        size: `${size}px`,
      }));
    })();

    ensembles.forEach((ens, index) => {
      const pos = positions[index] || { left: '50%', top: '50%', size: 'w-48 h-48' };
      const bubble = document.createElement('div');
      bubble.setAttribute('data-ensemble-bubble', ens.slug);
      bubble.setAttribute('role', 'button');
      bubble.setAttribute('tabindex', '0');
      bubble.className = 'interactive-bubble absolute cursor-pointer group z-30 focus:outline-none';
      bubble.style.left = pos.left;
      bubble.style.top = pos.top;
      bubble.style.transform = 'translate(-50%, -50%)';

      const nameSize = count > 6 ? 'text-xs sm:text-sm' : 'text-sm sm:text-base';
      bubble.innerHTML = `
        <div class="relative flex items-center justify-center rounded-full backdrop-blur-xl bg-gradient-to-br from-sky-900/70 via-sky-950/85 to-ocean-950/95 border-2 border-sky-400/40 hover:border-sky-300 hover:scale-105 shadow-[0_0_30px_rgba(14,165,233,0.3)] hover:shadow-[0_0_45px_rgba(56,189,248,0.55)] transition-all duration-300 p-4 text-center" style="width:${pos.size};height:${pos.size}">
          <span class="${nameSize} font-bold text-white font-sans leading-snug text-balance text-center px-2 group-hover:text-sky-200 transition-colors">
            ${ens.name}
          </span>
        </div>
      `;

      bubble.addEventListener('click', (event) => {
        event.stopPropagation();
        if (!level2Interactive) return;
        goToLevel3(ens);
      });

      level2BubblesContainer.appendChild(bubble);
    });

    // Smooth level transitions
    level1.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
    level1.classList.add('opacity-0', 'scale-110', 'pointer-events-none');

    level2.classList.remove('opacity-0', 'scale-90', 'pointer-events-auto');
    level2.classList.add('opacity-100', 'scale-100', 'pointer-events-none');

    setBackdropRingsVisible(false);

    level2Interactive = false;
    const unlockLevel2 = () => {
      if (currentLevel !== 2) return;
      level2Interactive = true;
      level2.classList.remove('pointer-events-none');
      level2.classList.add('pointer-events-auto');
    };
    window.addEventListener('pointerup', unlockLevel2, { once: true });
    setTimeout(unlockLevel2, 400);

    setTimeout(initPhysicsForCurrentLevel, 50);
  }

  function goToLevel1() {
    currentLevel = 1;
    activeCategory = null;

    if (level2) {
      level2.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
      level2.classList.add('opacity-0', 'scale-90', 'pointer-events-none');
    }

    if (level3) {
      level3.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
      level3.classList.add('opacity-0', 'scale-90', 'pointer-events-none');
    }

    if (level1) {
      level1.classList.remove('opacity-0', 'scale-110', 'pointer-events-none');
      level1.classList.add('opacity-100', 'scale-100', 'pointer-events-auto');
    }

    setBackdropRingsVisible(true);

    setTimeout(initPhysicsForCurrentLevel, 50);
  }

  function goToLevel3(ensemble) {
    if (!level2 || !level3 || !ensemble) return;
    if (!level2Interactive) return;
    activeEnsemble = ensemble;
    currentLevel = 3;

    if (level3RoleBadge) level3RoleBadge.textContent = ensemble.role;
    if (level3Name) level3Name.textContent = ensemble.name;
    if (level3Desc) level3Desc.textContent = ensemble.body || 'Działalność wykonawcza i dyrygencka.';

    const metaYears = document.getElementById('level-3-meta-years');
    const metaConcerts = document.getElementById('level-3-meta-concerts');
    if (metaYears) metaYears.textContent = ensemble.years || 'Współpraca bieżąca';
    if (metaConcerts) metaConcerts.textContent = ensemble.concertCount || 'Działalność sceniczna';

    if (level3Highlights) {
      level3Highlights.innerHTML = '';
      (ensemble.highlights || []).forEach((h) => {
        const li = document.createElement('li');
        li.className = 'flex items-start gap-2.5 text-slate-300';
        li.innerHTML = `<span class="text-sky-400 font-bold mt-0.5">✦</span><span>${h}</span>`;
        level3Highlights.appendChild(li);
      });
    }

    if (level3Photos) {
      level3Photos.innerHTML = '';
      const photos = ensemble.photos || [];
      if (photos.length === 0) {
        level3Photos.innerHTML = `<p class="text-xs text-slate-500 col-span-2">Brak materiałów archiwalnych dla tej formacji.</p>`;
      } else {
        photos.slice(0, 4).forEach((p, pIdx) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.setAttribute('data-lightbox-src', p);
          btn.setAttribute('data-lightbox-alt', `${ensemble.name} — fotografia archiwalna`);
          btn.className = 'group relative aspect-[16/10] overflow-hidden rounded-xl border border-white/15 bg-ocean-900 focus:outline-none focus:ring-2 focus:ring-sky-400 text-left shadow-lg';
          btn.innerHTML = `
            <img src="${p}" alt="${ensemble.name}" class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-ocean-950/90 via-transparent to-black/30 flex flex-col justify-between p-2.5">
              <span class="self-start text-[9px] font-sans font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-black/60 backdrop-blur-md text-sky-300 border border-white/10">
                Kadr ${pIdx + 1}
              </span>
              <div class="flex items-center gap-1.5 text-xs text-white font-medium opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                <svg class="w-3.5 h-3.5 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                <span>Powiększ</span>
              </div>
            </div>
          `;
          level3Photos.appendChild(btn);
        });
      }
    }

    // Transitions
    level2.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
    level2.classList.add('opacity-0', 'scale-110', 'pointer-events-none');

    level3.classList.remove('opacity-0', 'scale-90', 'pointer-events-none');
    level3.classList.add('opacity-100', 'scale-100', 'pointer-events-auto');

    physicsNodes = [];
  }

  // Category buttons click in Level 1
  document.querySelectorAll('.category-orb-btn').forEach((btn) => {
    btn.addEventListener('click', (event) => {
      event.stopPropagation();
      const catId = btn.getAttribute('data-cat-id');
      if (catId) goToLevel2(catId);
    });
  });

  if (btnBackTo1) btnBackTo1.addEventListener('click', goToLevel1);
  if (btnLevel3ToRoot) btnLevel3ToRoot.addEventListener('click', goToLevel1);
  if (btnBackTo2) {
    btnBackTo2.addEventListener('click', () => {
      if (activeCategory) {
        if (level3) {
          level3.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
          level3.classList.add('opacity-0', 'scale-90', 'pointer-events-none');
        }
        if (level2) {
          level2.classList.remove('opacity-0', 'scale-110', 'pointer-events-none');
          level2.classList.add('opacity-100', 'scale-100', 'pointer-events-auto');
        }
        currentLevel = 2;
        level2Interactive = true;
        setTimeout(initPhysicsForCurrentLevel, 50);
      } else {
        goToLevel1();
      }
    });
  }

  // Mobile Tabs
  const mobileCatBtns = document.querySelectorAll('[data-mobile-cat-btn]');
  const mobileCards = document.querySelectorAll('[data-mobile-cat-parent]');

  mobileCatBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const catId = btn.getAttribute('data-mobile-cat-btn');
      if (!catId) return;

      mobileCatBtns.forEach((b) => {
        b.classList.remove('bg-sky-600', 'border-sky-400', 'text-white', 'shadow-md', 'shadow-sky-600/30');
        b.classList.add('bg-sky-950/40', 'border-sky-400/20', 'text-slate-300');
      });

      btn.classList.remove('bg-sky-950/40', 'border-sky-400/20', 'text-slate-300');
      btn.classList.add('bg-sky-600', 'border-sky-400', 'text-white', 'shadow-md', 'shadow-sky-600/30');

      mobileCards.forEach((card) => {
        const parent = card.getAttribute('data-mobile-cat-parent');
        if (parent === catId) {
          card.classList.remove('hidden');
          card.classList.add('block');
        } else {
          card.classList.remove('block');
          card.classList.add('hidden');
        }
      });
    });
  });
</script>
