---
import { getCollection } from 'astro:content';
import {
  Sparkles,
  Users,
  Compass,
  RotateCcw,
  Music,
  Mic,
  Drama,
  Radio,
  ChevronRight,
  Maximize2,
} from 'lucide-astro';

// Fetch all 9 verified ensembles from Content Collections
const allEnsembles = await getCollection('ensembles');

// Group ensembles by pillar
const orkiestry = allEnsembles.filter(e => e.data.pillar === 'orkiestry').sort((a, b) => a.data.order - b.data.order);
const chory = allEnsembles.filter(e => e.data.pillar === 'chory').sort((a, b) => a.data.order - b.data.order);
const teatr = allEnsembles.filter(e => e.data.pillar === 'teatr').sort((a, b) => a.data.order - b.data.order);
const estrada = allEnsembles.filter(e => e.data.pillar === 'estrada').sort((a, b) => a.data.order - b.data.order);

// 4 Main Pillars with mathematically symmetric geometry (viewBox 900 x 680, Center 450, 340)
const pillars = [
  {
    id: 'orkiestry',
    name: 'Orkiestry',
    count: '3 zespoły',
    icon: Music,
    cx: 250,
    cy: 180,
    ensembles: orkiestry,
  },
  {
    id: 'chory',
    name: 'Chóry',
    count: '2 zespoły',
    icon: Mic,
    cx: 650,
    cy: 180,
    ensembles: chory,
  },
  {
    id: 'teatr',
    name: 'Teatr & Scena',
    count: '2 produkcje',
    icon: Drama,
    cx: 650,
    cy: 500,
    ensembles: teatr,
  },
  {
    id: 'estrada',
    name: 'Estrada',
    count: '2 składy',
    icon: Radio,
    cx: 250,
    cy: 500,
    ensembles: estrada,
  },
];
---

<section id="drzewo-radialne" class="relative py-28 md:py-36 overflow-hidden bg-[#070d1a] border-t border-white/10">

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Title -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2.5 text-sky-200 text-xs font-sans uppercase tracking-[0.28em]">
        <Sparkles class="w-3.5 h-3.5 text-sky-400" />
        <span>Działalność Zespołowa</span>
      </div>
      
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-white tracking-tight">
        Cztery Filary Działalności <span class="text-blue-gradient">Scenicznej</span>
      </h2>
      
      <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto font-normal leading-relaxed">
        Orkiestry dęte i symfoniczne, chóry akademickie i kameralne, teatr muzyczny i operetka oraz zespoły estradowe.
      </p>

      <div class="flex items-center justify-center gap-3 pt-1 opacity-50">
        <div class="w-12 h-[1.5px] bg-gradient-to-r from-transparent to-sky-400"></div>
        <span class="text-sky-400 text-xs">✦</span>
        <div class="w-12 h-[1.5px] bg-gradient-to-l from-transparent to-sky-400"></div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- DESKTOP RADIAL CONSTELLATION (>= 1024px) -->
    <!-- ========================================== -->
    <div class="hidden lg:block relative w-full max-w-5xl mx-auto aspect-[900/680] rounded-none border border-white/10 bg-[#0b1528]/90 p-4 overflow-hidden" id="radial-container">
      
      <!-- SVG Orbital Lines (Exact 900x680 geometry) -->
      <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 900 680" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <radialGradient id="azureGlow" cx="450" cy="340" r="320" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.15" />
            <stop offset="60%" stop-color="#0284c7" stop-opacity="0.02" />
            <stop offset="100%" stop-color="#070d1a" stop-opacity="0" />
          </radialGradient>

          <linearGradient id="azureSpoke" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.7"/>
            <stop offset="100%" stop-color="#0284c7" stop-opacity="0.2"/>
          </linearGradient>
        </defs>

        <circle cx="450" cy="340" r="300" fill="url(#azureGlow)"/>

        <!-- Concentric Orbital Rings centered at 450, 340 -->
        <circle cx="450" cy="340" r="130" stroke="rgba(56, 189, 248, 0.2)" stroke-width="1.5" stroke-dasharray="4 6" class="animate-orbit-slow origin-[450px_340px]" />
        <circle cx="450" cy="340" r="255" stroke="rgba(56, 189, 248, 0.3)" stroke-width="1.5" stroke-dasharray="6 8" class="animate-spin-reverse-slow origin-[450px_340px]" />
        <circle cx="450" cy="340" r="365" stroke="rgba(56, 189, 248, 0.1)" stroke-width="1" />

        <!-- Symmetrical Spokes from center (450, 340) to pillars -->
        <line x1="450" y1="340" x2="250" y2="180" stroke="url(#azureSpoke)" stroke-width="1.5" stroke-dasharray="4 4" />
        <line x1="450" y1="340" x2="650" y2="180" stroke="url(#azureSpoke)" stroke-width="1.5" stroke-dasharray="4 4" />
        <line x1="450" y1="340" x2="650" y2="500" stroke="url(#azureSpoke)" stroke-width="1.5" stroke-dasharray="4 4" />
        <line x1="450" y1="340" x2="250" y2="500" stroke="url(#azureSpoke)" stroke-width="1.5" stroke-dasharray="4 4" />

        <!-- Dynamic Satellite Connector Lines -->
        <g id="svg-satellite-lines"></g>
      </svg>

      <!-- 1. CENTRAL MEDALLION (Exactly at left: 50%, top: 50%) -->
      <div
        id="central-node"
        role="button"
        tabindex="0"
        title="Widok ogólny"
        style="left: 50%; top: 50%;"
        class="absolute -translate-x-1/2 -translate-y-1/2 z-30 cursor-pointer group focus:outline-none"
      >
        <div class="relative flex flex-col items-center justify-center w-44 h-44 rounded-full bg-[#0f1d38] border border-sky-400/50 group-hover:scale-105 transition-all duration-300">
          
          <!-- Outer Pulsing Halo -->
          <div class="absolute -inset-2.5 rounded-full border border-sky-400/30 animate-pulse"></div>
          
          <span class="text-sky-300 text-xs font-semibold uppercase tracking-wider font-display mb-0.5">Dorobek</span>

          <span class="font-display font-bold text-3xl text-blue-gradient tracking-tight">
            300+
          </span>
          <span class="text-xs font-bold text-slate-100 uppercase tracking-wider text-center px-2 leading-tight font-display">
            Występów<br />Scenicznych
          </span>
        </div>
      </div>

      <!-- 2. ORBIT 1: 4 PILLAR MEDALLIONS (Percentages aligned perfectly with SVG) -->
      {pillars.map((pillar) => {
        const Icon = pillar.icon;
        const leftPercent = (pillar.cx / 900) * 100;
        const topPercent = (pillar.cy / 680) * 100;
        return (
          <div
            id={`pillar-node-${pillar.id}`}
            data-pillar-id={pillar.id}
            role="button"
            tabindex="0"
            style={`left: ${leftPercent}%; top: ${topPercent}%;`}
            class={`pillar-btn absolute -translate-x-1/2 -translate-y-1/2 z-20 cursor-pointer group focus:outline-none transition-all duration-300`}
          >
            <div class="relative flex flex-col items-center justify-center w-36 h-36 rounded-sm bg-[#0f1d38]/90 border border-white/10 hover:border-sky-400 transition-all duration-300 group-hover:scale-105">
              
              <span class="p-2.5 rounded-sm bg-[#070d1a] border border-white/10 text-sky-400 mb-1.5 transition-all">
                <Icon class="w-5 h-5" />
              </span>

              <span class="font-display font-bold text-sm text-slate-100 text-center px-2 leading-tight group-hover:text-sky-300 transition-colors">
                {pillar.name}
              </span>
              
              <span class="text-[11px] text-sky-200/60 font-medium mt-0.5">
                {pillar.count}
              </span>

              <span class="absolute -bottom-2.5 px-3 py-0.5 rounded-sm bg-[#070d1a] border border-white/10 text-sky-200 text-[10px] font-sans uppercase tracking-wider group-hover:border-sky-400 transition-all">
                Formacje
              </span>
            </div>
          </div>
        );
      })}

      <!-- 3. ORBIT 2: SATELLITES LAYER -->
      <div id="satellite-nodes-layer" class="absolute inset-0 z-20 pointer-events-none"></div>

      <!-- Footer Info -->
      <div class="absolute bottom-4 right-6 text-xs text-slate-400 font-medium flex items-center gap-2">
        <span>Orkiestry • Chóry • Teatr • Estrada</span>
      </div>

    </div>

    <!-- ========================================== -->
    <!-- MOBILE VIEW (< 1024px) -->
    <!-- ========================================== -->
    <div class="block lg:hidden space-y-6">
      
      <!-- Mobile Pillar Tabs -->
      <div class="flex items-center gap-2.5 overflow-x-auto pb-3 scrollbar-none snap-x" id="mobile-pillar-tabs">
        {pillars.map((pillar, idx) => {
          const Icon = pillar.icon;
          return (
            <button
              type="button"
              data-mobile-pillar={pillar.id}
              class={`mobile-tab-btn flex items-center gap-2.5 px-5 py-3.5 rounded-sm border text-xs font-sans tracking-wider uppercase font-semibold whitespace-nowrap transition-all snap-start flex-shrink-0 ${
                idx === 0
                  ? 'bg-sky-600 border-sky-400 text-white'
                  : 'bg-[#0f1d38] border-white/10 text-slate-300 hover:text-white'
              }`}
            >
              <Icon class="w-4 h-4" />
              <span>{pillar.name}</span>
              <span class="text-[10px] opacity-80 font-normal">({pillar.ensembles.length})</span>
            </button>
          );
        })}
      </div>

      <!-- Mobile Ensemble Cards -->
      <div id="mobile-ensembles-container" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {pillars.map((pillar, pIdx) => (
          pillar.ensembles.map((ens) => (
            <div
              data-pillar-parent={pillar.id}
              class={`mobile-ensemble-card ocean-card p-6 rounded-sm border border-white/10 hover:border-sky-400/40 transition-all flex flex-col justify-between group ${
                pIdx === 0 ? 'block' : 'hidden'
              }`}
            >
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <span class="px-3 py-1 rounded-sm text-[10px] font-bold uppercase tracking-wider bg-[#070d1a] text-sky-300 border border-white/10 font-sans">
                    {ens.data.role}
                  </span>
                  <span class="text-xs text-sky-200/60 font-medium">
                    {ens.data.concertCount}
                  </span>
                </div>

                <h3 class="font-display font-bold text-lg text-white group-hover:text-sky-300 transition-colors">
                  {ens.data.name}
                </h3>

                <p class="text-xs text-slate-300 font-sans line-clamp-2">
                  {ens.body}
                </p>
              </div>

              <button
                type="button"
                data-open-drawer={ens.slug}
                class="mt-5 w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-sm bg-[#070d1a] border border-white/15 hover:border-sky-400 text-sky-200 hover:text-white transition-all text-xs font-sans uppercase tracking-wider font-semibold"
              >
                <span>Szczegóły</span>
                <Maximize2 class="w-3.5 h-3.5 text-sky-400" />
              </button>
            </div>
          ))
        ))}
      </div>

    </div>

  </div>
</section>

<!-- Radial Graph Script -->
<script define:vars={{ pillarsData: pillars }}>
  let activePillarId = null;
  const container = document.getElementById('radial-container');
  const satellitesLayer = document.getElementById('satellite-nodes-layer');
  const svgLinesLayer = document.getElementById('svg-satellite-lines');
  const centralNode = document.getElementById('central-node');
  const pillarBtns = document.querySelectorAll('.pillar-btn');

  // Mathematically balanced satellite offsets
  const satelliteOffsets = {
    orkiestry: [
      { dx: -135, dy: -55 },
      { dx: -135, dy: 55 },
      { dx: 0, dy: -125 },
    ],
    chory: [
      { dx: 135, dy: -50 },
      { dx: 0, dy: -125 },
    ],
    teatr: [
      { dx: 135, dy: 50 },
      { dx: 0, dy: 125 },
    ],
    estrada: [
      { dx: -135, dy: 50 },
      { dx: 0, dy: 125 },
    ],
  };

  function selectPillar(pillarId) {
    if (activePillarId === pillarId) {
      clearSatellites();
      activePillarId = null;
      return;
    }

    activePillarId = pillarId;
    renderSatellites(pillarId);
  }

  function clearSatellites() {
    if (satellitesLayer) satellitesLayer.innerHTML = '';
    if (svgLinesLayer) svgLinesLayer.innerHTML = '';

    pillarBtns.forEach((btn) => {
      const card = btn.querySelector('div');
      if (card) {
        card.classList.remove('border-sky-400', 'scale-105', 'bg-[#142548]');
      }
      const badge = btn.querySelector('span.absolute');
      if (badge) {
        badge.textContent = 'Formacje';
        badge.classList.remove('bg-sky-500', 'text-white');
      }
    });
  }

  function renderSatellites(pillarId) {
    clearSatellites();

    const pillar = pillarsData.find((p) => p.id === pillarId);
    if (!pillar) return;

    // Highlight selected pillar card
    const activeBtn = document.getElementById(`pillar-node-${pillarId}`);
    if (activeBtn) {
      const card = activeBtn.querySelector('div');
      if (card) {
        card.classList.add('border-sky-400', 'scale-105', 'bg-[#142548]');
      }
      const badge = activeBtn.querySelector('span.absolute');
      if (badge) {
        badge.textContent = 'Aktywny';
        badge.classList.add('bg-sky-500', 'text-white');
      }
    }

    const offsets = satelliteOffsets[pillarId] || [];

    pillar.ensembles.forEach((ens, index) => {
      const offset = offsets[index] || { dx: (index + 1) * 60, dy: (index + 1) * 40 };
      const satX = pillar.cx + offset.dx;
      const satY = pillar.cy + offset.dy;

      // 1. Draw SVG connection line in 900x680 coordinate space
      if (svgLinesLayer) {
        const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        line.setAttribute('x1', pillar.cx.toString());
        line.setAttribute('y1', pillar.cy.toString());
        line.setAttribute('x2', satX.toString());
        line.setAttribute('y2', satY.toString());
        line.setAttribute('stroke', '#38bdf8');
        line.setAttribute('stroke-width', '1.5');
        line.setAttribute('stroke-dasharray', '3 3');
        line.setAttribute('opacity', '0.8');
        line.classList.add('transition-all', 'duration-500');
        svgLinesLayer.appendChild(line);
      }

      // 2. Create interactive Satellite Node with exact percentage positioning
      if (satellitesLayer) {
        const satNode = document.createElement('div');
        satNode.className = 'satellite-node absolute -translate-x-1/2 -translate-y-1/2 pointer-events-auto cursor-pointer group z-30 transition-all duration-300 hover:scale-105';
        
        const satLeftPercent = (satX / 900) * 100;
        const satTopPercent = (satY / 680) * 100;
        satNode.style.left = `${satLeftPercent}%`;
        satNode.style.top = `${satTopPercent}%`;

        satNode.innerHTML = `
          <div class="relative p-3.5 rounded-sm bg-[#0f1d38] border border-white/15 hover:border-sky-400 w-48 text-left transition-all duration-300">
            <div class="flex items-center justify-between gap-1 mb-1">
              <span class="text-[9px] font-bold uppercase tracking-wider text-sky-300 px-2 py-0.5 rounded-sm bg-[#070d1a] border border-white/10 truncate font-sans">
                ${ens.data.role}
              </span>
              <span class="text-[9px] text-sky-200/60 font-semibold font-sans flex-shrink-0">
                ${ens.data.concertCount}
              </span>
            </div>
            <h4 class="font-display font-bold text-xs text-white group-hover:text-sky-300 transition-colors leading-snug line-clamp-2">
              ${ens.data.name}
            </h4>
            <div class="mt-2 pt-1.5 border-t border-sky-500/15 flex items-center justify-between text-[9px] text-sky-300 font-bold uppercase tracking-wider">
              <span>Szczegóły</span>
              <span class="text-sky-400 group-hover:translate-x-0.5 transition-transform">→</span>
            </div>
          </div>
        `;

        satNode.addEventListener('click', () => {
          window.dispatchEvent(
            new CustomEvent('open-ensemble-drawer', {
              detail: { ensembleSlug: ens.slug },
            })
          );
        });

        satellitesLayer.appendChild(satNode);
      }
    });
  }

  // Initialize Desktop Event Listeners
  pillarBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const pillarId = btn.getAttribute('data-pillar-id');
      if (pillarId) selectPillar(pillarId);
    });
  });

  if (centralNode) {
    centralNode.addEventListener('click', () => {
      clearSatellites();
      activePillarId = null;
    });
  }

  // Auto-open first pillar on desktop load
  if (window.innerWidth >= 1024) {
    setTimeout(() => {
      selectPillar('orkiestry');
    }, 400);
  }

  // Initialize Mobile Tabs
  const mobileTabs = document.querySelectorAll('.mobile-tab-btn');
  const mobileCards = document.querySelectorAll('.mobile-ensemble-card');

  mobileTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const pillarId = tab.getAttribute('data-mobile-pillar');
      if (!pillarId) return;

      mobileTabs.forEach((t) => {
        t.classList.remove('bg-sky-600', 'border-sky-400', 'text-white');
        t.classList.add('bg-[#0f1d38]', 'border-sky-500/20', 'text-slate-300');
      });

      tab.classList.remove('bg-[#0f1d38]', 'border-sky-500/20', 'text-slate-300');
      tab.classList.add('bg-sky-600', 'border-sky-400', 'text-white');

      mobileCards.forEach((card) => {
        const parentPillar = card.getAttribute('data-pillar-parent');
        if (parentPillar === pillarId) {
          card.classList.remove('hidden');
          card.classList.add('block');
        } else {
          card.classList.remove('block');
          card.classList.add('hidden');
        }
      });
    });
  });

  // Mobile Drawer Click Triggers
  document.querySelectorAll('[data-open-drawer]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const slug = btn.getAttribute('data-open-drawer');
      if (slug) {
        window.dispatchEvent(
          new CustomEvent('open-ensemble-drawer', {
            detail: { ensembleSlug: slug },
          })
        );
      }
    });
  });
</script>
