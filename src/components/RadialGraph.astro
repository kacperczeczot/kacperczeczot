---
import { getCollection } from 'astro:content';
import { Music2, Users, Theater, Sparkles, Award, RotateCcw, ChevronRight } from 'lucide-astro';

const allEnsembles = await getCollection('ensembles');
const sortedEnsembles = allEnsembles.sort((a, b) => a.data.order - b.data.order);

const pillars = [
  {
    id: 'orkiestry',
    name: 'Orkiestry',
    subtitle: 'Dęte & Symfoniczne',
    count: '3 formacje',
    icon: Music2,
    color: '#e2ba64',
    cx: 260,
    cy: 180,
  },
  {
    id: 'chory',
    name: 'Chóry & Wokal',
    subtitle: 'Akademia & Muzyka Dawna',
    count: '2 zespoły',
    icon: Users,
    color: '#e2ba64',
    cx: 640,
    cy: 180,
  },
  {
    id: 'teatr',
    name: 'Scena & Teatr',
    subtitle: 'Operetka & Musical',
    count: '2 produkcje',
    icon: Theater,
    color: '#e2ba64',
    cx: 640,
    cy: 500,
  },
  {
    id: 'estrada',
    name: 'Kameralistyka & Estrada',
    subtitle: 'Live Show & Jazz',
    count: '2 formacje',
    icon: Sparkles,
    color: '#e2ba64',
    cx: 260,
    cy: 500,
  },
];

const ensemblesData = sortedEnsembles.map(e => ({
  id: e.slug,
  name: e.data.name,
  pillar: e.data.pillar,
  role: e.data.role,
  concertCount: e.data.concertCount,
  highlights: e.data.highlights,
  photos: e.data.photos,
  order: e.data.order,
  bodyText: e.body,
}));
---

<section id="drzewo-radialne" class="relative py-24 bg-[#070709] overflow-hidden border-t border-[#e2ba64]/15">
  
  <!-- Subtle Gold Radial Atmosphere -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[850px] h-[850px] bg-gradient-radial from-[#e2ba64]/8 via-transparent to-transparent blur-3xl pointer-events-none -z-10"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title in Prestigious Editorial Style -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border border-[#e2ba64]/30 bg-[#15141a] text-[#f6d289] text-xs font-display tracking-widest uppercase">
        <Sparkles class="w-3.5 h-3.5 text-[#e2ba64]" />
        <span>Konstelacja Sceniczna</span>
      </div>
      
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-white tracking-tight">
        Orbita Działalności <span class="text-gold">Zespołowej</span>
      </h2>
      
      <p class="text-zinc-300 font-serif italic text-base sm:text-lg max-w-2xl mx-auto font-light">
        Wybierz jeden z czterech filarów scenicznych, aby odkryć poszczególne orkiestry, chóry, produkcje teatralne oraz składy estradowe.
      </p>

      <div class="flex items-center justify-center gap-3 pt-1 opacity-60">
        <div class="w-12 h-[1px] bg-gradient-to-r from-transparent to-[#e2ba64]"></div>
        <span class="text-[#e2ba64] text-xs font-serif">✦</span>
        <div class="w-12 h-[1px] bg-gradient-to-l from-transparent to-[#e2ba64]"></div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- DESKTOP RADIAL CONSTELLATION (>= 1024px) -->
    <!-- ========================================== -->
    <div class="hidden lg:block relative w-full max-w-5xl mx-auto aspect-[900/680] rounded-3xl border border-[#e2ba64]/20 bg-[#0e0e12]/90 backdrop-blur-2xl p-4 shadow-2xl overflow-hidden" id="radial-container">
      
      <!-- SVG Armillary / Orbital Lines -->
      <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 900 680" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <radialGradient id="theatreGlow" cx="450" cy="340" r="320" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#e2ba64" stop-opacity="0.12" />
            <stop offset="50%" stop-color="#e2ba64" stop-opacity="0.02" />
            <stop offset="100%" stop-color="#000000" stop-opacity="0" />
          </radialGradient>

          <linearGradient id="goldBeam" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#f6d289" stop-opacity="0.7"/>
            <stop offset="100%" stop-color="#b88a32" stop-opacity="0.2"/>
          </linearGradient>
        </defs>

        <circle cx="450" cy="340" r="300" fill="url(#theatreGlow)"/>

        <!-- Refined Golden Armillary Concentric Rings -->
        <circle cx="450" cy="340" r="130" stroke="rgba(226, 186, 100, 0.15)" stroke-width="1" stroke-dasharray="3 5" class="animate-orbit-slow origin-[450px_340px]" />
        <circle cx="450" cy="340" r="255" stroke="rgba(226, 186, 100, 0.2)" stroke-width="1.5" stroke-dasharray="6 8" class="animate-spin-reverse-slow origin-[450px_340px]" />
        <circle cx="450" cy="340" r="375" stroke="rgba(226, 186, 100, 0.08)" stroke-width="1" />

        <!-- Diagonal Acoustic Spokes -->
        <line x1="450" y1="340" x2="260" y2="180" stroke="url(#goldBeam)" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.6" />
        <line x1="450" y1="340" x2="640" y2="180" stroke="url(#goldBeam)" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.6" />
        <line x1="450" y1="340" x2="640" y2="500" stroke="url(#goldBeam)" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.6" />
        <line x1="450" y1="340" x2="260" y2="500" stroke="url(#goldBeam)" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.6" />

        <!-- Dynamic Satellite Connector Lines -->
        <g id="svg-satellite-lines"></g>
      </svg>

      <!-- 1. CENTRAL MEDALLION: 300+ WYSTĘPÓW (Seal / Home) -->
      <div
        id="central-node"
        role="button"
        tabindex="0"
        title="Kliknij, aby zresetować widok"
        class="absolute top-[340px] left-[450px] -translate-x-1/2 -translate-y-1/2 z-30 cursor-pointer group focus:outline-none"
      >
        <div class="relative flex flex-col items-center justify-center w-44 h-44 rounded-full bg-[#121118]/95 border-2 border-[#e2ba64] shadow-gold-glow group-hover:shadow-gold-glow-lg group-hover:scale-105 transition-all duration-400 backdrop-blur-md">
          
          <!-- Outer Golden Laurel Ring -->
          <div class="absolute -inset-2.5 rounded-full border border-[#e2ba64]/30 animate-pulse-subtle"></div>
          
          <span class="text-[#f6d289] text-xs font-serif italic mb-0.5">Dorobek</span>

          <span class="font-display font-extrabold text-3xl text-gold tracking-tight">
            300+
          </span>
          <span class="text-[11px] font-display font-semibold text-[#faecd0] uppercase tracking-wider text-center px-2 leading-tight">
            Występów<br />Scenicznych
          </span>

          <span class="text-[9px] font-serif italic text-zinc-400 mt-1">
            Kliknij, by zresetować
          </span>
        </div>
      </div>

      <!-- 2. ORBIT 1: 4 PILLAR MEDALLIONS -->
      {pillars.map((pillar) => {
        const Icon = pillar.icon;
        return (
          <div
            id={`pillar-node-${pillar.id}`}
            data-pillar-id={pillar.id}
            role="button"
            tabindex="0"
            style={`top: ${pillar.cy}px; left: ${pillar.cx}px;`}
            class={`pillar-btn absolute -translate-x-1/2 -translate-y-1/2 z-20 cursor-pointer group focus:outline-none transition-all duration-300`}
          >
            <div class="relative flex flex-col items-center justify-center w-36 h-36 rounded-3xl bg-[#15141a]/95 border border-[#e2ba64]/30 hover:border-[#e2ba64] shadow-subtle-card backdrop-blur-md transition-all duration-300 group-hover:scale-105 group-hover:shadow-gold-glow">
              
              <span class="p-2 rounded-xl bg-[#070709] border border-[#e2ba64]/25 text-[#f6d289] mb-1.5 transition-all">
                <Icon class="w-5 h-5" />
              </span>

              <span class="font-display font-bold text-sm text-zinc-100 text-center px-2 leading-tight group-hover:text-[#f6d289] transition-colors">
                {pillar.name}
              </span>
              
              <span class="text-[10px] font-serif italic text-zinc-400 mt-0.5">
                {pillar.count}
              </span>

              <span class="absolute -bottom-2.5 px-3 py-0.5 rounded-full bg-[#070709] border border-[#e2ba64]/30 text-[9px] font-display uppercase tracking-wider text-[#e2ba64] group-hover:bg-[#e2ba64] group-hover:text-[#070709] transition-all font-semibold">
                Odkryj +
              </span>
            </div>
          </div>
        );
      })}

      <!-- 3. ORBIT 2: SATELLITES LAYER -->
      <div id="satellite-nodes-layer" class="absolute inset-0 z-20 pointer-events-none"></div>

      <!-- Quick Guidance -->
      <div class="absolute bottom-4 right-6 text-xs text-zinc-400 font-serif italic flex items-center gap-2">
        <RotateCcw class="w-3.5 h-3.5 text-[#e2ba64]" />
        <span>Wybierz filar, by rozwinąć formacje • Kliknij zespół, by otworzyć partyturę działalności</span>
      </div>

    </div>

    <!-- ========================================== -->
    <!-- MOBILE VIEW (< 1024px) -->
    <!-- ========================================== -->
    <div class="block lg:hidden space-y-6">
      
      <!-- Mobile Pillar Tabs (Refined Gilded Carousel) -->
      <div class="flex items-center gap-2.5 overflow-x-auto pb-3 scrollbar-none snap-x" id="mobile-pillar-tabs">
        {pillars.map((pillar, idx) => {
          const Icon = pillar.icon;
          return (
            <button
              type="button"
              data-mobile-pillar={pillar.id}
              class={`mobile-tab-btn flex items-center gap-2.5 px-5 py-3.5 rounded-2xl border text-xs font-display tracking-wider uppercase font-semibold whitespace-nowrap transition-all snap-start flex-shrink-0 ${
                idx === 0
                  ? 'bg-[#1e1c24] border-[#e2ba64] text-[#faecd0] shadow-gold-glow'
                  : 'bg-[#15141a] border-[#e2ba64]/20 text-zinc-400 hover:text-zinc-200'
              }`}
            >
              <Icon class="w-4 h-4 text-[#e2ba64]" />
              <span>{pillar.name}</span>
              <span class="px-2 py-0.5 rounded-full bg-[#070709] text-[10px] text-[#e2ba64] border border-[#e2ba64]/20">
                {pillar.count.split(' ')[0]}
              </span>
            </button>
          );
        })}
      </div>

      <!-- Mobile Ensemble Cards Cascading Grid -->
      <div id="mobile-ensembles-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      </div>

    </div>

  </div>
</section>

<script define:vars={{ ensemblesData }}>
  const ensembles = ensemblesData;

  const pillarCoords = {
    orkiestry: { cx: 260, cy: 180 },
    chory: { cx: 640, cy: 180 },
    teatr: { cx: 640, cy: 500 },
    estrada: { cx: 260, cy: 500 },
  };

  const satelliteOffsets = {
    orkiestry: [
      { dx: -140, dy: -60 },
      { dx: -145, dy: 65 },
      { dx: 0, dy: -125 },
    ],
    chory: [
      { dx: 140, dy: -50 },
      { dx: 140, dy: 60 },
    ],
    teatr: [
      { dx: 140, dy: -40 },
      { dx: 140, dy: 60 },
    ],
    estrada: [
      { dx: -140, dy: -40 },
      { dx: -140, dy: 60 },
    ],
  };

  let activePillarId = null;

  function initRadialGraph() {
    const container = document.getElementById('radial-container');
    const satelliteLayer = document.getElementById('satellite-nodes-layer');
    const svgLines = document.getElementById('svg-satellite-lines');
    const centralNode = document.getElementById('central-node');
    const pillarButtons = document.querySelectorAll('.pillar-btn');

    const mobileTabs = document.querySelectorAll('.mobile-tab-btn');
    const mobileGrid = document.getElementById('mobile-ensembles-grid');

    if (!container || !satelliteLayer || !svgLines) return;

    function resetGraph() {
      activePillarId = null;
      satelliteLayer.innerHTML = '';
      svgLines.innerHTML = '';
      
      pillarButtons.forEach((btn) => {
        btn.classList.remove('ring-2', 'ring-[#e2ba64]', 'scale-105');
        const badge = btn.querySelector('span:last-child');
        if (badge) {
          badge.textContent = 'Odkryj +';
          badge.className = 'absolute -bottom-2.5 px-3 py-0.5 rounded-full bg-[#070709] border border-[#e2ba64]/30 text-[9px] font-display uppercase tracking-wider text-[#e2ba64] group-hover:bg-[#e2ba64] group-hover:text-[#070709] transition-all font-semibold';
        }
      });
    }

    if (centralNode) {
      centralNode.addEventListener('click', resetGraph);
    }

    function expandPillar(pillarId) {
      if (activePillarId === pillarId) {
        resetGraph();
        return;
      }

      resetGraph();
      activePillarId = pillarId;

      const activeBtn = document.getElementById(`pillar-node-${pillarId}`);
      if (activeBtn) {
        activeBtn.classList.add('ring-2', 'ring-[#e2ba64]', 'scale-105');
        const badge = activeBtn.querySelector('span:last-child');
        if (badge) {
          badge.textContent = 'Aktywny ✓';
          badge.className = 'absolute -bottom-2.5 px-3 py-0.5 rounded-full bg-[#e2ba64] text-[#070709] font-bold text-[9px] font-display uppercase tracking-wider shadow-gold-glow';
        }
      }

      const pCoord = pillarCoords[pillarId];
      const offsets = satelliteOffsets[pillarId] || [];
      const pillarEnsembles = ensembles.filter(e => e.pillar === pillarId);

      pillarEnsembles.forEach((ens, idx) => {
        const offset = offsets[idx] || { dx: (idx + 1) * 60, dy: (idx + 1) * 40 };
        const satX = pCoord.cx + offset.dx;
        const satY = pCoord.cy + offset.dy;

        const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        line.setAttribute('x1', String(pCoord.cx));
        line.setAttribute('y1', String(pCoord.cy));
        line.setAttribute('x2', String(satX));
        line.setAttribute('y2', String(satY));
        line.setAttribute('stroke', '#e2ba64');
        line.setAttribute('stroke-width', '1.5');
        line.setAttribute('stroke-dasharray', '3 3');
        line.setAttribute('class', 'animate-pulse');
        svgLines.appendChild(line);

        const satEl = document.createElement('div');
        satEl.className = 'absolute pointer-events-auto cursor-pointer group focus:outline-none -translate-x-1/2 -translate-y-1/2 transition-all duration-400 transform scale-0';
        satEl.style.left = `${satX}px`;
        satEl.style.top = `${satY}px`;

        satEl.innerHTML = `
          <div class="relative flex items-center gap-3 px-4 py-3 rounded-2xl bg-[#15141a]/95 border border-[#e2ba64]/40 hover:border-[#e2ba64] hover:bg-[#1e1c24] shadow-xl backdrop-blur-md transition-all duration-300 group-hover:scale-105 group-hover:shadow-gold-glow max-w-[220px]">
            <div class="w-2 h-2 rounded-full bg-[#e2ba64] flex-shrink-0 animate-pulse"></div>
            <div class="min-w-0">
              <h4 class="text-xs font-display font-bold text-zinc-100 truncate group-hover:text-[#f6d289] transition-colors">
                ${ens.name}
              </h4>
              <p class="text-[10px] font-serif italic text-zinc-400 truncate">
                ${ens.role}
              </p>
              <div class="flex items-center gap-1 text-[10px] font-display text-[#e2ba64] mt-0.5 font-semibold">
                <span>✦</span>
                <span>${ens.concertCount}</span>
              </div>
            </div>
          </div>
        `;

        satEl.addEventListener('click', () => {
          window.dispatchEvent(new CustomEvent('open-ensemble-drawer', { detail: ens }));
        });

        satelliteLayer.appendChild(satEl);

        requestAnimationFrame(() => {
          satEl.classList.remove('scale-0');
          satEl.classList.add('scale-100');
        });
      });
    }

    pillarButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const pId = btn.getAttribute('data-pillar-id');
        if (pId) expandPillar(pId);
      });
    });

    setTimeout(() => {
      if (!activePillarId) expandPillar('orkiestry');
    }, 400);

    function renderMobileGrid(pillarId) {
      if (!mobileGrid) return;
      mobileGrid.innerHTML = '';

      const pillarEnsembles = ensembles.filter(e => e.pillar === pillarId);

      pillarEnsembles.forEach((ens) => {
        const card = document.createElement('div');
        card.className = 'theatre-card p-6 rounded-2xl border border-[#e2ba64]/20 hover:border-[#e2ba64]/60 transition-all cursor-pointer group active:scale-[0.98]';
        card.innerHTML = `
          <div class="flex items-start justify-between gap-3 mb-3">
            <span class="px-3 py-1 rounded-full text-[10px] font-display tracking-wider uppercase bg-[#070709] text-[#f6d289] border border-[#e2ba64]/30 font-semibold">
              ${ens.role}
            </span>
            <span class="text-xs font-serif italic text-zinc-300 flex items-center gap-1">
              <span>✦</span>
              <span>${ens.concertCount}</span>
            </span>
          </div>
          <h3 class="font-display font-bold text-base text-zinc-100 group-hover:text-[#f6d289] transition-colors mb-2">
            ${ens.name}
          </h3>
          <ul class="space-y-1.5 mb-4 text-xs text-zinc-400 font-sans">
            ${(ens.highlights || []).slice(0, 2).map(h => `<li class="flex items-start gap-2"><span class="text-[#e2ba64] mt-0.5">•</span><span>${h}</span></li>`).join('')}
          </ul>
          <div class="flex items-center justify-between text-xs font-display tracking-wider uppercase text-[#e2ba64] pt-3 border-t border-[#e2ba64]/15 font-semibold">
            <span>Szczegóły formacji</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        `;

        card.addEventListener('click', () => {
          window.dispatchEvent(new CustomEvent('open-ensemble-drawer', { detail: ens }));
        });

        mobileGrid.appendChild(card);
      });
    }

    mobileTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const pId = tab.getAttribute('data-mobile-pillar');
        if (!pId) return;

        mobileTabs.forEach((t) => {
          t.classList.remove('bg-[#1e1c24]', 'border-[#e2ba64]', 'text-[#faecd0]', 'shadow-gold-glow');
          t.classList.add('bg-[#15141a]', 'border-[#e2ba64]/20', 'text-zinc-400');
        });

        tab.classList.remove('bg-[#15141a]', 'border-[#e2ba64]/20', 'text-zinc-400');
        tab.classList.add('bg-[#1e1c24]', 'border-[#e2ba64]', 'text-[#faecd0]', 'shadow-gold-glow');

        renderMobileGrid(pId);
      });
    });

    renderMobileGrid('orkiestry');
  }

  initRadialGraph();
  document.addEventListener('astro:page-load', initRadialGraph);
</script>
