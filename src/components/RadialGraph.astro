---
import { getCollection } from 'astro:content';
import {
  Sparkles,
  Music,
  Mic,
  Drama,
  Radio,
  ArrowUpRight,
  ChevronRight,
  Layers,
} from 'lucide-astro';

// Fetch all ensembles from Content Collections
const allEnsembles = await getCollection('ensembles');

// Group ensembles by pillar
const orkiestry = allEnsembles.filter(e => e.data.pillar === 'orkiestry').sort((a, b) => a.data.order - b.data.order);
const chory = allEnsembles.filter(e => e.data.pillar === 'chory').sort((a, b) => a.data.order - b.data.order);
const teatr = allEnsembles.filter(e => e.data.pillar === 'teatr').sort((a, b) => a.data.order - b.data.order);
const estrada = allEnsembles.filter(e => e.data.pillar === 'estrada').sort((a, b) => a.data.order - b.data.order);

// 4 Pillars definition
const pillars = [
  {
    id: 'orkiestry',
    name: 'Orkiestry',
    subtitle: 'Składy dęte i symfoniczne',
    count: '3 formacje',
    icon: Music,
    pos: { x: 24, y: 28 }, // percent coords
    floatClass: 'animate-float-1',
    ensembles: orkiestry,
  },
  {
    id: 'chory',
    name: 'Chóry & Zespoły',
    subtitle: 'Składy wokalne & polifonia',
    count: '2 składy',
    icon: Mic,
    pos: { x: 76, y: 28 },
    floatClass: 'animate-float-2',
    ensembles: chory,
  },
  {
    id: 'teatr',
    name: 'Scena & Teatr',
    subtitle: 'Operetka & musical',
    count: '2 produkcje',
    icon: Drama,
    pos: { x: 76, y: 72 },
    floatClass: 'animate-float-3',
    ensembles: teatr,
  },
  {
    id: 'estrada',
    name: 'Kameralistyka & Estrada',
    subtitle: 'Live sound & formacje estradowe',
    count: '2 zespoły',
    icon: Radio,
    pos: { x: 24, y: 72 },
    floatClass: 'animate-float-4',
    ensembles: estrada,
  },
];
---

<section id="drzewo-radialne" class="relative py-28 md:py-36 overflow-hidden bg-[#070d1a] border-t border-white/10 select-none">
  
  <!-- Ambient background glow spots -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-sky-500/10 rounded-full blur-[140px] pointer-events-none"></div>
  <div class="absolute top-1/4 left-1/4 w-[400px] h-[400px] bg-blue-600/10 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-1/4 right-1/4 w-[450px] h-[450px] bg-cyan-500/10 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20 space-y-4">
      <div class="inline-flex items-center gap-2.5 text-sky-200 text-xs font-sans uppercase tracking-[0.28em]">
        <Sparkles class="w-3.5 h-3.5 text-sky-400" />
        <span>Działalność Zespołowa</span>
      </div>
      
      <h2 class="text-4xl sm:text-5xl font-display font-bold text-white tracking-tight leading-tight">
        Cztery Filary Działalności <span class="text-blue-gradient">Scenicznej</span>
      </h2>
      
      <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto font-sans font-light leading-relaxed">
        Orkiestry dęte i symfoniczne, chóry akademickie i kameralne, teatr muzyczny i operetka oraz zespoły estradowe.
      </p>

      <div class="flex items-center justify-center gap-3 pt-1 opacity-50">
        <div class="w-12 h-[1.5px] bg-gradient-to-r from-transparent to-sky-400"></div>
        <span class="text-sky-400 text-xs">✦</span>
        <div class="w-12 h-[1.5px] bg-gradient-to-l from-transparent to-sky-400"></div>
      </div>
    </div>

    <!-- ======================================================= -->
    <!-- DESKTOP FLOATING BUBBLES CONSTELLATION (>= 1024px)     -->
    <!-- ======================================================= -->
    <div
      id="floating-constellation-container"
      class="hidden lg:block relative w-full max-w-5xl mx-auto h-[660px] rounded-3xl border border-white/10 bg-gradient-to-b from-[#0b1528]/80 via-[#070d1a]/90 to-[#0b1528]/80 backdrop-blur-xl p-6 overflow-hidden shadow-2xl shadow-sky-950/40"
    >
      <!-- Soft ambient backdrop rings -->
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
        <div class="w-[520px] h-[520px] rounded-full border border-sky-400/10 animate-spin-reverse-slow"></div>
        <div class="absolute w-[320px] h-[320px] rounded-full border border-sky-400/15 animate-pulse"></div>
        <div class="absolute w-[180px] h-[180px] rounded-full bg-sky-500/10 blur-2xl"></div>
      </div>

      <!-- Connecting SVG Lines Canvas for smooth dynamic links -->
      <svg
        id="bubble-connections-svg"
        class="absolute inset-0 w-full h-full pointer-events-none z-10"
        viewBox="0 0 1000 660"
        preserveAspectRatio="none"
      >
        <defs>
          <linearGradient id="bubbleBeamGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#0284c7" stop-opacity="0.2" />
          </linearGradient>
        </defs>
        <g id="satellite-svg-lines"></g>
      </svg>

      <!-- 1. CENTRAL HERO BUBBLE (50%, 50%) -->
      <div
        id="center-main-bubble"
        role="button"
        tabindex="0"
        title="Dorobek sceniczny"
        style="left: 50%; top: 50%;"
        class="absolute -translate-x-1/2 -translate-y-1/2 z-30 cursor-pointer group focus:outline-none animate-float-center"
      >
        <div class="relative flex flex-col items-center justify-center w-52 h-52 rounded-full backdrop-blur-xl bg-gradient-to-br from-sky-900/70 via-sky-950/80 to-[#070d1a]/95 border-2 border-sky-400/50 shadow-[0_0_40px_rgba(14,165,233,0.3)] group-hover:shadow-[0_0_55px_rgba(56,189,248,0.5)] group-hover:border-sky-300 group-hover:scale-105 transition-all duration-500">
          
          <!-- Outer Pulsing Halo -->
          <div class="absolute -inset-2.5 rounded-full border border-sky-400/30 animate-pulse pointer-events-none"></div>
          <div class="absolute -inset-5 rounded-full border border-sky-400/15 animate-ping opacity-25 pointer-events-none"></div>
          
          <span class="text-[10px] font-sans font-bold uppercase tracking-[0.22em] text-sky-300 mb-1">
            Dorobek Sceniczny
          </span>

          <span class="font-display font-extrabold text-4xl sm:text-5xl text-blue-gradient tracking-tight drop-shadow-sm">
            300+
          </span>

          <span class="text-xs font-display font-semibold text-slate-100 uppercase tracking-wider text-center px-4 leading-tight mt-1">
            Występów<br />Scenicznych
          </span>

          <span class="mt-2 text-[9px] font-sans font-medium uppercase tracking-widest text-sky-300/80 px-2.5 py-0.5 rounded-full bg-sky-950/80 border border-sky-400/20 group-hover:border-sky-400/50 transition-colors">
            4 Filary
          </span>
        </div>
      </div>

      <!-- 2. FOUR PILLAR FLOATING BUBBLES -->
      {pillars.map((pillar) => {
        const Icon = pillar.icon;
        return (
          <div
            id={`pillar-bubble-${pillar.id}`}
            data-pillar-id={pillar.id}
            data-pos-x={pillar.pos.x}
            data-pos-y={pillar.pos.y}
            role="button"
            tabindex="0"
            style={`left: ${pillar.pos.x}%; top: ${pillar.pos.y}%;`}
            class={`pillar-bubble-btn absolute -translate-x-1/2 -translate-y-1/2 z-20 cursor-pointer group focus:outline-none ${pillar.floatClass}`}
          >
            <div class="relative flex flex-col items-center justify-center w-40 h-40 rounded-full backdrop-blur-md bg-gradient-to-br from-sky-900/50 via-sky-950/70 to-[#070d1a]/90 border border-sky-400/30 hover:border-sky-300 hover:scale-110 shadow-lg shadow-sky-950/60 hover:shadow-[0_0_35px_rgba(14,165,233,0.4)] transition-all duration-300 p-4 text-center">
              
              <!-- Icon with glow -->
              <span class="p-2.5 rounded-full bg-sky-950/80 border border-sky-400/30 text-sky-300 mb-1.5 shadow-inner group-hover:text-white group-hover:border-sky-300 transition-all">
                <Icon class="w-5 h-5" />
              </span>

              <!-- Title -->
              <span class="font-display font-bold text-sm text-slate-100 leading-tight group-hover:text-sky-200 transition-colors px-2">
                {pillar.name}
              </span>
              
              <!-- Count -->
              <span class="text-[11px] font-sans text-sky-300/80 font-medium mt-0.5">
                {pillar.count}
              </span>

              <!-- Status Tag -->
              <span class="pillar-status-badge absolute -bottom-2.5 px-3 py-0.5 rounded-full bg-[#070d1a] border border-sky-400/30 text-sky-200 text-[10px] font-sans uppercase tracking-wider group-hover:border-sky-400 transition-all shadow-md">
                Formacje
              </span>
            </div>
          </div>
        );
      })}

      <!-- 3. DYNAMIC SATELLITE BUBBLES LAYER -->
      <div id="satellite-bubbles-container" class="absolute inset-0 z-25 pointer-events-none"></div>

      <!-- Info Badge bottom right -->
      <div class="absolute bottom-4 right-6 text-xs text-slate-400 font-sans font-medium flex items-center gap-2 bg-[#070d1a]/80 px-4 py-1.5 rounded-full border border-white/10 backdrop-blur-sm">
        <span>Orkiestry • Chóry • Teatr • Estrada</span>
      </div>

    </div>

    <!-- ======================================================= -->
    <!-- MOBILE / TABLET TOUCH RIBBON & CAROUSEL (< 1024px)      -->
    <!-- ======================================================= -->
    <div class="block lg:hidden space-y-6">
      
      <!-- Mobile Center Highlight Card -->
      <div class="flex items-center justify-between p-5 rounded-2xl backdrop-blur-md bg-gradient-to-r from-sky-950/60 to-[#070d1a] border border-sky-400/30 shadow-lg">
        <div class="space-y-1">
          <span class="text-[10px] font-sans uppercase tracking-widest text-sky-300 font-semibold">
            Dorobek Artystyczny
          </span>
          <h3 class="text-2xl font-display font-bold text-white tracking-tight">
            300+ Występów Scenicznych
          </h3>
          <p class="text-xs text-slate-300 font-sans">
            W 4 filarach wykonawczych i dyrygenckich
          </p>
        </div>
        <div class="w-12 h-12 rounded-full bg-sky-500/20 border border-sky-400/40 flex items-center justify-center flex-shrink-0">
          <Sparkles class="w-6 h-6 text-sky-300" />
        </div>
      </div>

      <!-- Mobile Pillar Switcher Pills (Horizontal Scroll) -->
      <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none snap-x" id="mobile-pillar-ribbon">
        {pillars.map((pillar, idx) => {
          const Icon = pillar.icon;
          return (
            <button
              type="button"
              data-mobile-pillar-btn={pillar.id}
              class={`mobile-pillar-btn flex items-center gap-2 px-4 py-3 rounded-full border text-xs font-sans tracking-wide uppercase font-semibold whitespace-nowrap transition-all snap-start flex-shrink-0 backdrop-blur-md ${
                idx === 0
                  ? 'bg-sky-600 border-sky-400 text-white shadow-md shadow-sky-600/30'
                  : 'bg-sky-950/40 border-sky-400/20 text-slate-300 hover:text-white'
              }`}
            >
              <Icon class="w-4 h-4" />
              <span>{pillar.name}</span>
              <span class="text-[10px] opacity-80 font-normal">({pillar.ensembles.length})</span>
            </button>
          );
        })}
      </div>

      <!-- Mobile Ensembles Carousel / Grid -->
      <div id="mobile-ensembles-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {pillars.map((pillar, pIdx) => (
          pillar.ensembles.map((ens) => (
            <div
              data-mobile-pillar-parent={pillar.id}
              class={`mobile-ensemble-card p-6 rounded-2xl backdrop-blur-md bg-gradient-to-b from-sky-950/40 to-[#070d1a] border border-sky-400/25 hover:border-sky-300 transition-all flex flex-col justify-between group shadow-lg ${
                pIdx === 0 ? 'block' : 'hidden'
              }`}
            >
              <div class="space-y-3">
                <div class="flex items-center justify-between gap-2">
                  <span class="px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-sky-950/80 text-sky-300 border border-sky-400/30 font-sans">
                    {ens.data.role}
                  </span>
                  <span class="text-xs text-sky-200/70 font-medium font-sans">
                    {ens.data.concertCount}
                  </span>
                </div>

                <h3 class="font-display font-bold text-xl text-white group-hover:text-sky-300 transition-colors leading-snug">
                  {ens.data.name}
                </h3>

                <p class="text-xs text-slate-300 font-sans font-light line-clamp-3 leading-relaxed">
                  {ens.body}
                </p>
              </div>

              <button
                type="button"
                data-open-drawer={ens.slug}
                class="mt-5 w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-sky-900/40 hover:bg-sky-600/80 border border-sky-400/30 hover:border-sky-300 text-sky-200 hover:text-white transition-all text-xs font-sans uppercase tracking-wider font-semibold group/btn"
              >
                <span>Szczegóły</span>
                <ArrowUpRight class="w-4 h-4 text-sky-400 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5 transition-transform" />
              </button>
            </div>
          ))
        ))}
      </div>

    </div>

  </div>
</section>

<!-- Scoped CSS for organic floating bubbles & animations -->
<style>
  @keyframes float-center {
    0%, 100% {
      transform: translate(-50%, -50%) rotate(0deg);
    }
    33% {
      transform: translate(-50%, calc(-50% - 6px)) rotate(0.5deg);
    }
    66% {
      transform: translate(-50%, calc(-50% + 5px)) rotate(-0.5deg);
    }
  }

  @keyframes float-1 {
    0%, 100% {
      transform: translate(-50%, -50%) translate(0px, 0px);
    }
    33% {
      transform: translate(-50%, -50%) translate(8px, -10px);
    }
    66% {
      transform: translate(-50%, -50%) translate(-6px, 8px);
    }
  }

  @keyframes float-2 {
    0%, 100% {
      transform: translate(-50%, -50%) translate(0px, 0px);
    }
    33% {
      transform: translate(-50%, -50%) translate(-8px, 10px);
    }
    66% {
      transform: translate(-50%, -50%) translate(7px, -7px);
    }
  }

  @keyframes float-3 {
    0%, 100% {
      transform: translate(-50%, -50%) translate(0px, 0px);
    }
    33% {
      transform: translate(-50%, -50%) translate(9px, 8px);
    }
    66% {
      transform: translate(-50%, -50%) translate(-8px, -9px);
    }
  }

  @keyframes float-4 {
    0%, 100% {
      transform: translate(-50%, -50%) translate(0px, 0px);
    }
    33% {
      transform: translate(-50%, -50%) translate(-7px, -9px);
    }
    66% {
      transform: translate(-50%, -50%) translate(8px, 6px);
    }
  }

  @keyframes satellite-pop {
    0% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.3);
    }
    70% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.08);
    }
    100% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
  }

  .animate-float-center {
    animation: float-center 8s ease-in-out infinite;
  }

  .animate-float-1 {
    animation: float-1 7s ease-in-out infinite;
  }

  .animate-float-2 {
    animation: float-2 8.5s ease-in-out infinite 0.5s;
  }

  .animate-float-3 {
    animation: float-3 7.8s ease-in-out infinite 1s;
  }

  .animate-float-4 {
    animation: float-4 8.2s ease-in-out infinite 1.5s;
  }

  .animate-satellite-in {
    animation: satellite-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }
</style>

<!-- Client Script for Interactive Orbit & Bubbles -->
<script define:vars={{ pillarsData: pillars }}>
  let activePillarId = null;
  const container = document.getElementById('floating-constellation-container');
  const satellitesLayer = document.getElementById('satellite-bubbles-container');
  const svgLinesLayer = document.getElementById('satellite-svg-lines');
  const centerBubble = document.getElementById('center-main-bubble');
  const pillarBtns = document.querySelectorAll('.pillar-bubble-btn');

  // Relative percentage offsets for satellite bubbles surrounding each pillar
  const satelliteOffsets = {
    orkiestry: [
      { dx: -13.5, dy: -5.5 }, // top left
      { dx: -13.0, dy: 6.5 },  // bottom left
      { dx: 1.0, dy: -13.0 },  // top right
    ],
    chory: [
      { dx: 13.5, dy: -5.5 },  // top right
      { dx: -1.0, dy: -13.0 }, // top left
    ],
    teatr: [
      { dx: 13.5, dy: 5.5 },   // bottom right
      { dx: -1.0, dy: 13.0 },  // bottom left
    ],
    estrada: [
      { dx: -13.5, dy: 5.5 },  // bottom left
      { dx: 1.0, dy: 13.0 },   // bottom right
    ],
  };

  function selectPillar(pillarId) {
    if (activePillarId === pillarId) {
      clearSatellites();
      activePillarId = null;
      return;
    }

    activePillarId = pillarId;
    renderSatellites(pillarId);
  }

  function clearSatellites() {
    if (satellitesLayer) satellitesLayer.innerHTML = '';
    if (svgLinesLayer) svgLinesLayer.innerHTML = '';

    pillarBtns.forEach((btn) => {
      const card = btn.querySelector('div');
      if (card) {
        card.classList.remove('border-sky-300', 'scale-110', 'shadow-[0_0_35px_rgba(14,165,233,0.6)]', 'bg-sky-900/70');
      }
      const badge = btn.querySelector('.pillar-status-badge');
      if (badge) {
        badge.textContent = 'Formacje';
        badge.classList.remove('bg-sky-500', 'text-white', 'border-sky-300');
      }
    });
  }

  function renderSatellites(pillarId) {
    clearSatellites();

    const pillar = pillarsData.find((p) => p.id === pillarId);
    if (!pillar) return;

    // Highlight selected pillar bubble
    const activeBtn = document.getElementById(`pillar-bubble-${pillarId}`);
    if (activeBtn) {
      const card = activeBtn.querySelector('div');
      if (card) {
        card.classList.add('border-sky-300', 'scale-110', 'shadow-[0_0_35px_rgba(14,165,233,0.6)]', 'bg-sky-900/70');
      }
      const badge = activeBtn.querySelector('.pillar-status-badge');
      if (badge) {
        badge.textContent = 'Aktywny';
        badge.classList.add('bg-sky-500', 'text-white', 'border-sky-300');
      }
    }

    const offsets = satelliteOffsets[pillarId] || [];

    pillar.ensembles.forEach((ens, index) => {
      const offset = offsets[index] || { dx: (index + 1) * 8, dy: (index + 1) * 6 };
      const satXPercent = pillar.pos.x + offset.dx;
      const satYPercent = pillar.pos.y + offset.dy;

      // 1. Draw SVG Connecting Beam
      if (svgLinesLayer) {
        const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        line.setAttribute('x1', (pillar.pos.x * 10).toString());
        line.setAttribute('y1', (pillar.pos.y * 6.6).toString());
        line.setAttribute('x2', (satXPercent * 10).toString());
        line.setAttribute('y2', (satYPercent * 6.6).toString());
        line.setAttribute('stroke', 'url(#bubbleBeamGrad)');
        line.setAttribute('stroke-width', '2');
        line.setAttribute('stroke-dasharray', '4 4');
        line.setAttribute('opacity', '0.85');
        svgLinesLayer.appendChild(line);
      }

      // 2. Create Floating Satellite Bubble
      if (satellitesLayer) {
        const satBubble = document.createElement('div');
        satBubble.className = 'satellite-bubble absolute -translate-x-1/2 -translate-y-1/2 pointer-events-auto cursor-pointer group z-30 animate-satellite-in';
        satBubble.style.left = `${satXPercent}%`;
        satBubble.style.top = `${satYPercent}%`;
        satBubble.style.animationDelay = `${index * 80}ms`;

        satBubble.innerHTML = `
          <div class="relative flex flex-col items-center justify-center w-36 h-36 sm:w-40 sm:h-40 rounded-full backdrop-blur-xl bg-gradient-to-br from-sky-900/80 via-sky-950/90 to-[#070d1a]/95 border-2 border-sky-400/40 hover:border-sky-300 hover:scale-110 shadow-[0_0_25px_rgba(14,165,233,0.3)] hover:shadow-[0_0_40px_rgba(56,189,248,0.6)] transition-all duration-300 p-3 text-center">
            
            <span class="text-[9px] font-sans font-bold uppercase tracking-wider text-sky-300 px-2.5 py-0.5 rounded-full bg-[#070d1a]/90 border border-sky-400/30 mb-1 max-w-[90%] truncate">
              ${ens.data.role}
            </span>

            <h4 class="font-display font-bold text-xs sm:text-[13px] text-white group-hover:text-sky-200 transition-colors leading-tight line-clamp-2 px-1">
              ${ens.data.name}
            </h4>

            <span class="text-[10px] font-sans text-sky-200/70 font-medium mt-1">
              ${ens.data.concertCount}
            </span>

            <div class="mt-1 flex items-center gap-1 text-[9px] font-sans font-bold uppercase tracking-wider text-sky-300 group-hover:text-white">
              <span>Szczegóły</span>
              <span class="text-sky-400 group-hover:translate-x-0.5 transition-transform">→</span>
            </div>
          </div>
        `;

        // Directly open the full ensemble drawer on click
        satBubble.addEventListener('click', () => {
          window.dispatchEvent(
            new CustomEvent('open-ensemble-drawer', {
              detail: { id: ens.slug, slug: ens.slug, ensembleSlug: ens.slug },
            })
          );
        });

        satellitesLayer.appendChild(satBubble);
      }
    });
  }

  // Desktop Event Listeners
  pillarBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const pillarId = btn.getAttribute('data-pillar-id');
      if (pillarId) selectPillar(pillarId);
    });
  });

  if (centerBubble) {
    centerBubble.addEventListener('click', () => {
      // Toggle or reset
      if (activePillarId) {
        clearSatellites();
        activePillarId = null;
      } else {
        selectPillar('orkiestry');
      }
    });
  }

  // Auto-activate first pillar on load for desktop
  if (window.innerWidth >= 1024) {
    setTimeout(() => {
      selectPillar('orkiestry');
    }, 450);
  }

  // Mobile Ribbon Tabs Logic
  const mobilePillarBtns = document.querySelectorAll('[data-mobile-pillar-btn]');
  const mobileCards = document.querySelectorAll('[data-mobile-pillar-parent]');

  mobilePillarBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const pillarId = btn.getAttribute('data-mobile-pillar-btn');
      if (!pillarId) return;

      mobilePillarBtns.forEach((b) => {
        b.classList.remove('bg-sky-600', 'border-sky-400', 'text-white', 'shadow-md', 'shadow-sky-600/30');
        b.classList.add('bg-sky-950/40', 'border-sky-400/20', 'text-slate-300');
      });

      btn.classList.remove('bg-sky-950/40', 'border-sky-400/20', 'text-slate-300');
      btn.classList.add('bg-sky-600', 'border-sky-400', 'text-white', 'shadow-md', 'shadow-sky-600/30');

      mobileCards.forEach((card) => {
        const parentPillar = card.getAttribute('data-mobile-pillar-parent');
        if (parentPillar === pillarId) {
          card.classList.remove('hidden');
          card.classList.add('block');
        } else {
          card.classList.remove('block');
          card.classList.add('hidden');
        }
      });
    });
  });

  // Mobile Open Drawer Buttons
  document.querySelectorAll('[data-open-drawer]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const slug = btn.getAttribute('data-open-drawer');
      if (slug) {
        window.dispatchEvent(
          new CustomEvent('open-ensemble-drawer', {
            detail: { id: slug, slug: slug, ensembleSlug: slug },
          })
        );
      }
    });
  });
</script>
