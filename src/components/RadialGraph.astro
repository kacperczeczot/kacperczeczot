                <!-- Dynamic photos with lightbox support -->
              </div>
            </div>

          </div>
        </div>

      </div>
                <!-- Dynamic photos with lightbox support -->
              </div>
            </div>

          </div>
        </div>

      </div>

    </div>

    <!-- ======================================================= -->
    <!-- MOBILE / TABLET TOUCH SECTION (< 1024px)                -->
    <!-- ======================================================= -->
    <div class="block lg:hidden space-y-6">
      
      <!-- Mobile Overview Header -->
      <div class="flex items-center justify-between p-5 rounded-2xl backdrop-blur-md bg-gradient-to-r from-sky-950/60 to-[#070d1a] border border-sky-400/30 shadow-lg">
        <div class="space-y-1">
          <span class="text-xs font-sans uppercase tracking-widest text-sky-300 font-semibold">
            Dorobek Artystyczny
          </span>
          <h3 class="text-2xl sm:text-3xl font-display font-bold text-white tracking-tight">
            300+ Występów Scenicznych
          </h3>
          <p class="text-sm text-slate-300 font-sans">
            W 4 kategoriach wykonawczych i dyrygenckich
          </p>
        </div>
        <div class="w-12 h-12 rounded-full bg-sky-500/20 border border-sky-400/40 flex items-center justify-center flex-shrink-0">
          <Sparkles class="w-6 h-6 text-sky-300" />
        </div>
      </div>

      <!-- Mobile Category Tabs -->
      <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none snap-x" id="mobile-cat-ribbon">
        {categories.map((cat, idx) => {
          let IconComponent = Music;
          if (cat.id === 'chory') IconComponent = Mic;
          if (cat.id === 'teatr') IconComponent = Drama;
          if (cat.id === 'estrada') IconComponent = Radio;

          return (
            <button
              type="button"
              data-mobile-cat-btn={cat.id}
              class={`mobile-cat-tab-btn flex items-center gap-2.5 px-5 py-3.5 rounded-full border text-sm font-sans tracking-wide uppercase font-semibold whitespace-nowrap transition-all snap-start flex-shrink-0 backdrop-blur-md ${
                idx === 0
                  ? 'bg-sky-600 border-sky-400 text-white shadow-md shadow-sky-600/30'
                  : 'bg-sky-950/40 border-sky-400/20 text-slate-300 hover:text-white'
              }`}
            >
              <IconComponent class="w-4 h-4" />
              <span>{cat.name}</span>
              <span class="text-xs opacity-80 font-normal">({cat.ensembles.length})</span>
            </button>
          );
        })}
      </div>

      <!-- Mobile Ensembles Grid -->
      <div id="mobile-ensembles-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {categories.map((cat, cIdx) => (
          cat.ensembles.map((ens) => (
