---
import { Github, Mail, Copy, Check, Youtube } from 'lucide-astro';
import homeData from '../data/home.json';

const currentYear = new Date().getFullYear();
const contactEmail = homeData.contactEmail || 'kacperczeczot7@gmail.com';
const contactInvitation = homeData.contactInvitation || 'Projekty orkiestrowe, opracowania partytur oraz współpraca koncertowa.';
const githubUrl = homeData.githubUrl || 'https://github.com/kacperczeczot';
const youtubeUrl = homeData.youtubeUrl || 'https://youtube.com/@kacperczeczot3530';
---

<footer id="kontakt" class="relative border-t border-white/10 bg-[#070d1a] py-16 sm:py-20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-8">
    
    <!-- Nagłówek i zaproszenie do współpracy -->
    <div class="space-y-3">
      <p class="text-xs font-semibold tracking-widest text-sky-400 font-sans uppercase">
        KONTAKT
      </p>
      <p class="text-base sm:text-lg text-slate-300 font-sans font-light max-w-xl mx-auto leading-relaxed">
        {contactInvitation}
      </p>
    </div>

    <!-- Boks adresu e-mail z kopiowaniem i kliknięciem -->
    <div class="max-w-md mx-auto">
      <div class="flex items-center justify-between p-2.5 pl-5 border border-white/15 bg-[#0b1528] hover:border-sky-400/50 transition-all shadow-lg">
        <a
          href={`mailto:${contactEmail}`}
          class="flex items-center gap-3 text-sm font-sans font-medium text-slate-200 hover:text-sky-300 transition-colors truncate"
        >
          <Mail class="w-4 h-4 text-sky-400 flex-shrink-0" />
          <span id="footer-email-text" class="truncate">{contactEmail}</span>
        </a>
        
        <button
          id="copy-email-btn"
          type="button"
          aria-label="Kopiuj adres e-mail"
          class="p-2.5 bg-[#070d1a] hover:bg-sky-500 hover:text-white text-sky-300 transition-all focus:outline-none border border-white/15 ml-3 flex-shrink-0"
          title="Kopiuj adres e-mail"
        >
          <Copy id="copy-icon" class="w-4 h-4" />
          <Check id="check-icon" class="w-4 h-4 hidden text-emerald-400" />
        </button>
      </div>

      <p id="copy-feedback" class="text-xs text-sky-300 mt-2 hidden font-semibold text-center">
        ✓ Skopiowano adres e-mail do schowka
      </p>
    </div>

    <!-- Rząd minimalistycznych linków społecznościowych -->
    <div class="flex items-center justify-center gap-4 pt-2">
      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Profil GitHub Kacpra Czeczota"
        class="inline-flex items-center gap-2 px-4 py-2 border border-white/15 text-slate-300 hover:text-sky-300 hover:border-sky-400/40 transition-all text-xs font-semibold font-sans bg-[#0b1528]"
      >
        <Github class="w-4 h-4 text-sky-400" />
        <span>GitHub</span>
      </a>

      <a
        href={youtubeUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Kanał YouTube"
        class="inline-flex items-center gap-2 px-4 py-2 border border-white/15 text-slate-300 hover:text-sky-300 hover:border-sky-400/40 transition-all text-xs font-semibold font-sans bg-[#0b1528]"
      >
        <Youtube class="w-4 h-4 text-sky-400" />
        <span>YouTube</span>
      </a>
    </div>

    <!-- Dolny pasek praw autorskich -->
    <div class="border-t border-white/10 pt-8 mt-12 text-center text-xs text-slate-400 font-sans">
      <p>© {currentYear} Kacper Czeczot. Wszelkie prawa zastrzeżone.</p>
    </div>

  </div>
</footer>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const copyIcon = document.getElementById('copy-icon');
  const checkIcon = document.getElementById('check-icon');
  const feedback = document.getElementById('copy-feedback');
  const emailText = document.getElementById('footer-email-text')?.textContent || '';

  if (copyBtn && copyIcon && checkIcon && feedback) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(emailText.trim());
        copyIcon.classList.add('hidden');
        checkIcon.classList.remove('hidden');
        feedback.classList.remove('hidden');

        setTimeout(() => {
          copyIcon.classList.remove('hidden');
          checkIcon.classList.add('hidden');
          feedback.classList.add('hidden');
        }, 3000);
      } catch (err) {
        console.error('Nie udało się skopiować e-maila:', err);
      }
    });
  }
</script>
