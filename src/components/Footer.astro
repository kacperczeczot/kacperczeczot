---
import { Github, Mail, Copy, Check, ArrowUpRight } from 'lucide-astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentYear = new Date().getFullYear();
const contactEmail = 'kacperczeczot7@gmail.com';
---

<footer id="kontakt" class="relative border-t border-white/10 bg-[#070d1a] pt-20 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 pb-14 border-b border-white/10">
      
      <div class="md:col-span-5 space-y-5">
        <div class="flex items-center gap-3.5">
          <div class="w-11 h-11 border border-white/15 flex items-center justify-center text-white font-display font-semibold text-lg">
            KC
          </div>
          <div>
            <h3 class="font-display font-bold text-white text-lg tracking-tight">Kacper Czeczot</h3>
            <p class="text-xs text-sky-400 font-semibold uppercase tracking-wider font-display">DYRYGENT • MUZYK • REŻYSER DŹWIĘKU</p>
          </div>
        </div>

        <p class="text-slate-300 font-sans text-base leading-relaxed max-w-md font-normal">
          Dyscyplina dyrygentury symfoniczno-chóralnej, wykonawstwo instrumentalne oraz realizacja dźwięku.
        </p>

        <!-- Social Media Links (Verified) -->
        <div class="flex items-center gap-3 pt-2">
          <a
            href="https://github.com/kacperczeczot"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Profil GitHub"
            class="flex items-center gap-2 px-4 py-2.5 border border-white/15 text-slate-300 hover:text-sky-300 hover:border-sky-400/40 transition-all text-xs font-semibold"
          >
            <Github class="w-4 h-4 text-sky-400" />
            <span>GitHub</span>
          </a>
        </div>
      </div>

      <!-- Quick Navigation Links -->
      <div class="md:col-span-3 space-y-4">
        <h4 class="text-xs font-bold text-sky-300 uppercase tracking-wider font-display">Nawigacja</h4>
        <ul class="space-y-2.5 text-sm text-slate-300 font-medium">
          <li>
            <a href={`${base}/`} class="hover:text-sky-300 transition-colors flex items-center gap-1 group">
              <span>Scena & Zespoły</span>
              <ArrowUpRight class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-opacity text-sky-400" />
            </a>
          </li>
          <li>
            <a href={`${base}/projekty-autorskie`} class="hover:text-sky-300 transition-colors flex items-center gap-1 group">
              <span>Dzieła Autorskie</span>
              <ArrowUpRight class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-opacity text-sky-400" />
            </a>
          </li>
          <li>
            <a href={`${base}/bio`} class="hover:text-sky-300 transition-colors flex items-center gap-1 group">
              <span>Bio & Edukacja</span>
              <ArrowUpRight class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-opacity text-sky-400" />
            </a>
          </li>
        </ul>
      </div>

      <!-- Direct Contact & Copy Email Box -->
      <div class="md:col-span-4 space-y-4">
        <h4 class="text-xs font-bold text-sky-300 uppercase tracking-wider font-display">Kontakt Bezpośredni</h4>
        <p class="text-sm text-slate-300 font-normal leading-relaxed">
          Projekty dyrygenckie, aranżacje partytur, produkcja muzyczna oraz współpraca sceniczna.
        </p>

        <div class="pt-1">
          <div class="flex items-center justify-between p-2 pl-4 border border-white/15 hover:border-sky-400/40 transition-all">
            <div class="flex items-center gap-2.5 text-sm text-slate-200">
              <Mail class="w-4 h-4 text-sky-400" />
              <span id="footer-email-text" class="font-semibold text-xs sm:text-sm text-sky-100">{contactEmail}</span>
            </div>
            <button
              id="copy-email-btn"
              type="button"
              class="p-2.5 bg-[#070d1a] hover:bg-sky-500 hover:text-white text-sky-300 transition-all focus:outline-none border border-white/15"
              title="Kopiuj adres e-mail"
            >
              <Copy id="copy-icon" class="w-4 h-4" />
              <Check id="check-icon" class="w-4 h-4 hidden text-emerald-400" />
            </button>
          </div>
          <p id="copy-feedback" class="text-xs text-sky-300 mt-2 hidden font-semibold">
            ✓ Skopiowano adres e-mail do schowka
          </p>
        </div>
      </div>

    </div>

    <!-- Copyright and Credits -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400 font-medium">
      <p>© {currentYear} Kacper Czeczot. Wszelkie prawa zastrzeżone.</p>
      <p class="flex items-center gap-2 text-slate-400">
        <span>Portfolio Artystyczne</span>
        <span class="text-sky-400">✦</span>
        <span>Dyrygentura & Muzyka</span>
      </p>
    </div>
  </div>
</footer>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const copyIcon = document.getElementById('copy-icon');
  const checkIcon = document.getElementById('check-icon');
  const feedback = document.getElementById('copy-feedback');
  const emailText = document.getElementById('footer-email-text')?.textContent || '';

  if (copyBtn && copyIcon && checkIcon && feedback) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(emailText.trim());
        copyIcon.classList.add('hidden');
        checkIcon.classList.remove('hidden');
        feedback.classList.remove('hidden');

        setTimeout(() => {
          copyIcon.classList.remove('hidden');
          checkIcon.classList.add('hidden');
          feedback.classList.add('hidden');
        }, 3000);
      } catch (err) {
        console.error('Nie udało się skopiować e-maila:', err);
      }
    });
  }
</script>
