---
import { Play, Film } from 'lucide-astro';

interface Props {
  youtubeId: string;
  title: string;
  partNumber?: number;
  featured?: boolean;
}

const { youtubeId, title, partNumber, featured = false } = Astro.props;
---

<div class={`group relative rounded-2xl overflow-hidden border border-zinc-800 bg-zinc-900/60 shadow-xl transition-all duration-300 hover:border-amber-500/40 hover:shadow-glow-amber ${featured ? 'p-1' : ''}`}>
  <!-- Video Header Bar -->
  <div class="px-4 py-3 bg-zinc-950/80 border-b border-zinc-800/80 flex items-center justify-between gap-3">
    <div class="flex items-center gap-2.5 min-w-0">
      <span class="flex items-center justify-center w-6 h-6 rounded-lg bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-mono font-semibold flex-shrink-0">
        {partNumber ? `0${partNumber}` : <Film class="w-3.5 h-3.5" />}
      </span>
      <h3 class="text-sm font-medium text-zinc-200 truncate group-hover:text-amber-300 transition-colors">
        {title}
      </h3>
    </div>
    <span class="text-[10px] font-mono text-zinc-400 uppercase tracking-wider flex items-center gap-1.5 flex-shrink-0">
      <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
      YouTube
    </span>
  </div>

  <!-- Video Iframe Container (16:9 Aspect Ratio) -->
  <div class="relative w-full aspect-video bg-black overflow-hidden">
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${youtubeId}?rel=0&modestbranding=1`}
      title={title}
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
      loading="lazy"
      class="absolute inset-0 w-full h-full border-0"
    ></iframe>
  </div>
</div>
