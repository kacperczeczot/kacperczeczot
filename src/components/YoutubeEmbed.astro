---
import { Film } from 'lucide-astro';

interface Props {
  youtubeId?: string;
  title: string;
  partNumber?: number;
  featured?: boolean;
}

const { youtubeId = '', title, partNumber, featured = false } = Astro.props;
const hasValidVideo = youtubeId && youtubeId.trim().length > 0 && youtubeId !== 'dQw4w9WgXcQ';
---

<div class={`group relative overflow-hidden border border-white/10 bg-[#0b1528] transition-all duration-300 hover:border-sky-400/40 ${featured ? 'p-1' : ''}`}>
  <!-- Video Header Bar -->
  <div class="px-5 py-3.5 bg-[#070d1a] border-b border-sky-500/15 flex items-center justify-between gap-3">
    <div class="flex items-center gap-3 min-w-0">
      <span class="flex items-center justify-center w-7 h-7 border border-white/15 text-sky-300 text-xs font-display font-semibold flex-shrink-0">
        {partNumber ? `0${partNumber}` : <Film class="w-3.5 h-3.5 text-sky-400" />}
      </span>
      <h3 class="text-xs sm:text-sm font-display font-semibold text-white truncate group-hover:text-sky-300 transition-colors">
        {title}
      </h3>
    </div>
    <span class="text-[10px] font-display uppercase tracking-wider text-sky-400 flex items-center gap-1.5 flex-shrink-0 font-semibold">
      <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
      Wideo
    </span>
  </div>

  <!-- Video Container (16:9) -->
  <div class="relative w-full aspect-video bg-[#070d1a] overflow-hidden flex items-center justify-center">
    {hasValidVideo ? (
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${youtubeId}?rel=0&modestbranding=1`}
        title={title}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy"
        class="absolute inset-0 w-full h-full border-0"
      ></iframe>
    ) : (
      <div class="p-8 text-center space-y-3 max-w-md mx-auto">
        <div class="w-12 h-12 border border-white/15 flex items-center justify-center text-sky-400 mx-auto">
          <Film class="w-6 h-6 text-sky-400" />
        </div>
        <div class="space-y-1">
          <p class="font-display font-bold text-sm text-slate-100">{title}</p>
          <p class="text-xs text-slate-400">Rejestracja Koncertowa / Studyjna</p>
        </div>
      </div>
    )}
  </div>
</div>
