---
import { X, Award, Calendar, CheckCircle2, Image as ImageIcon, Sparkles, ExternalLink } from 'lucide-astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!-- Accessible Slide-over Drawer / Bottom Sheet -->
<aside
  id="ensemble-drawer"
  class="fixed inset-0 z-50 pointer-events-none transition-all duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="drawer-ensemble-name"
  aria-hidden="true"
>
  <!-- Backdrop Overlay -->
  <div
    id="drawer-backdrop"
    class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm opacity-0 transition-opacity duration-300 pointer-events-none"
  ></div>

  <!-- Drawer Container -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none flex justify-end">
    <div
      id="drawer-panel"
      class="pointer-events-auto w-full md:max-w-xl h-full bg-white border-l border-slate-200 shadow-2xl flex flex-col transform translate-x-full md:translate-x-full transition-transform duration-300 ease-out z-10"
    >
      
      <!-- Top Header -->
      <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between gap-4 bg-slate-50/80 backdrop-blur-md">
        <div class="flex items-center gap-3">
          <span id="drawer-pillar-badge" class="px-3.5 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-sky-50 text-sky-700 border border-sky-200">
            Filar Sceniczny
          </span>
        </div>
        <button
          id="drawer-close-btn"
          type="button"
          aria-label="Zamknij panel szczegółów"
          class="p-2 rounded-xl text-slate-400 hover:text-slate-700 bg-white border border-slate-200 hover:border-slate-300 transition-all focus:outline-none focus:ring-2 focus:ring-sky-500"
        >
          <X class="w-5 h-5" />
        </button>
      </div>

      <!-- Scrollable Body Content -->
      <div class="flex-1 overflow-y-auto px-6 sm:px-8 py-7 space-y-7">
        
        <!-- Ensemble Title & Role Header -->
        <div class="space-y-4">
          <h3 id="drawer-ensemble-name" class="text-2xl sm:text-3xl font-display font-bold text-slate-900 leading-tight">
            Nazwa Formacji
          </h3>
          
          <div class="flex flex-wrap items-center gap-3 pt-1">
            <!-- Role Badge -->
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-slate-100 border border-slate-200 text-xs sm:text-sm font-semibold text-slate-800">
              <Sparkles class="w-4 h-4 text-sky-600" />
              <span id="drawer-role-text">Rola w zespole</span>
            </div>

            <!-- Concert Count Pill -->
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-sky-50 border border-sky-200 text-xs sm:text-sm font-bold text-sky-800">
              <Calendar class="w-4 h-4 text-sky-600" />
              <span id="drawer-concert-count">Występy</span>
            </div>
          </div>
        </div>

        <!-- Highlights Section -->
        <div class="space-y-3 pt-2">
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center gap-2">
            <Award class="w-4 h-4 text-sky-600" />
            <span>Kluczowe Osiągnięcia & Rola</span>
          </h4>
          <ul id="drawer-highlights-list" class="space-y-2.5">
            <!-- Dynamically populated -->
          </ul>
        </div>

        <!-- Description / Markdown Content -->
        <div class="space-y-2 pt-4 border-t border-slate-100">
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500">
            Charakterystyka & Działalność
          </h4>
          <div id="drawer-description" class="text-sm font-sans text-slate-600 leading-relaxed space-y-3">
            <!-- Dynamically populated -->
          </div>
        </div>

        <!-- Photo Gallery (Lightbox-enabled) -->
        <div class="space-y-3 pt-4 border-t border-slate-100">
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center justify-between">
            <span class="flex items-center gap-2">
              <ImageIcon class="w-4 h-4 text-sky-600" />
              <span>Archiwum Fotograficzne</span>
            </span>
            <span class="text-[11px] text-slate-400 font-normal">kliknij, aby powiększyć</span>
          </h4>

          <div id="drawer-photos-grid" class="grid grid-cols-2 gap-3.5">
            <!-- Dynamically populated photo thumbnails -->
          </div>
        </div>

      </div>

      <!-- Drawer Footer -->
      <div class="p-6 border-t border-slate-100 bg-slate-50 flex items-center justify-between gap-3">
        <a
          href={`${base}/projekty-autorskie`}
          class="flex items-center gap-2 text-xs uppercase tracking-wider font-bold text-sky-600 hover:text-sky-700 transition-colors"
        >
          <span>Zobacz dzieła autorskie</span>
          <ExternalLink class="w-3.5 h-3.5" />
        </a>
        <button
          id="drawer-bottom-close-btn"
          type="button"
          class="px-5 py-2.5 rounded-xl text-xs uppercase tracking-wider font-semibold text-slate-700 bg-white border border-slate-200 hover:border-slate-300 transition-all shadow-xs"
        >
          Zamknij
        </button>
      </div>

    </div>
  </div>
</aside>

<script>
  interface EnsembleData {
    name: string;
    pillar: string;
    role: string;
    concertCount: string;
    highlights: string[];
    photos: string[];
    bodyText?: string;
  }

  function setupDrawer() {
    const drawer = document.getElementById('ensemble-drawer');
    const backdrop = document.getElementById('drawer-backdrop');
    const panel = document.getElementById('drawer-panel');
    const closeBtn = document.getElementById('drawer-close-btn');
    const bottomCloseBtn = document.getElementById('drawer-bottom-close-btn');

    const pillarBadge = document.getElementById('drawer-pillar-badge');
    const nameEl = document.getElementById('drawer-ensemble-name');
    const roleEl = document.getElementById('drawer-role-text');
    const countEl = document.getElementById('drawer-concert-count');
    const highlightsEl = document.getElementById('drawer-highlights-list');
    const descEl = document.getElementById('drawer-description');
    const photosGrid = document.getElementById('drawer-photos-grid');

    if (!drawer || !backdrop || !panel || !closeBtn) return;

    const pillarLabels: Record<string, string> = {
      orkiestry: 'Orkiestry Dęte & Symfoniczne',
      chory: 'Chóry & Zespoły Wokalne',
      teatr: 'Scena Teatralna & Musical',
      estrada: 'Kameralistyka & Estrada',
    };

    function openDrawer(data: EnsembleData) {
      if (!drawer || !backdrop || !panel) return;

      const label = pillarLabels[data.pillar] || 'Formacja Sceniczna';
      if (pillarBadge) {
        pillarBadge.textContent = label;
      }

      if (nameEl) nameEl.textContent = data.name;
      if (roleEl) roleEl.textContent = data.role;
      if (countEl) countEl.textContent = data.concertCount;

      if (highlightsEl) {
        highlightsEl.innerHTML = '';
        (data.highlights || []).forEach((item) => {
          const li = document.createElement('li');
          li.className = 'flex items-start gap-2.5 text-sm text-slate-700 font-sans';
          li.innerHTML = `
            <span class="w-2 h-2 rounded-full bg-sky-500 mt-1.5 flex-shrink-0"></span>
            <span>${item}</span>
          `;
          highlightsEl.appendChild(li);
        });
      }

      if (descEl) {
        descEl.innerHTML = data.bodyText
          ? `<p>${data.bodyText}</p>`
          : `<p>Działalność wykonawcza i dyrygencka w ramach repertuaru klasycznego, teatralnego i estradowego.</p>`;
      }

      if (photosGrid) {
        photosGrid.innerHTML = '';
        const photos = data.photos || [];
        if (photos.length === 0) {
          photosGrid.innerHTML = `<p class="text-xs text-slate-400 col-span-2">Brak materiałów archiwalnych.</p>`;
        } else {
          photos.forEach((photoUrl, idx) => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.setAttribute('data-lightbox-src', photoUrl);
            btn.setAttribute('data-lightbox-alt', `${data.name} — Fotografia archiwalna ${idx + 1}`);
            btn.className = 'group relative rounded-xl overflow-hidden border border-slate-200 hover:border-sky-400 aspect-[16/10] bg-slate-100 transition-all focus:outline-none focus:ring-2 focus:ring-sky-500 shadow-xs';
            btn.innerHTML = `
              <img src="${photoUrl}" alt="${data.name} — Zdjęcie ${idx + 1}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
              <div class="absolute inset-0 bg-slate-900/30 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                <span class="px-2.5 py-1 rounded-lg bg-white text-slate-900 text-xs font-semibold shadow-md">Powiększ</span>
              </div>
            `;
            photosGrid.appendChild(btn);
          });
        }
      }

      drawer.classList.remove('pointer-events-none');
      drawer.setAttribute('aria-hidden', 'false');
      
      backdrop.classList.remove('pointer-events-none');
      backdrop.classList.add('opacity-100', 'pointer-events-auto');

      panel.classList.remove('translate-x-full');
      panel.classList.add('translate-x-0');

      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      if (!drawer || !backdrop || !panel) return;

      backdrop.classList.remove('opacity-100', 'pointer-events-auto');
      backdrop.classList.add('opacity-0', 'pointer-events-none');

      panel.classList.remove('translate-x-0');
      panel.classList.add('translate-x-full');

      drawer.setAttribute('aria-hidden', 'true');

      setTimeout(() => {
        drawer.classList.add('pointer-events-none');
        document.body.style.overflow = '';
      }, 300);
    }

    closeBtn.addEventListener('click', closeDrawer);
    if (bottomCloseBtn) bottomCloseBtn.addEventListener('click', closeDrawer);
    backdrop.addEventListener('click', closeDrawer);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.getAttribute('aria-hidden') === 'false') {
        closeDrawer();
      }
    });

    window.addEventListener('open-ensemble-drawer', (e: Event) => {
      const customEvent = e as CustomEvent<EnsembleData>;
      if (customEvent.detail) {
        openDrawer(customEvent.detail);
      }
    });
  }

  setupDrawer();
  document.addEventListener('astro:page-load', setupDrawer);
</script>
