---
import { getCollection } from 'astro:content';
import { X } from 'lucide-astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const coverBySlug: Record<string, string> = {
  opinogora: `${base}/images/ensemble-opinogora.svg`,
  rebowo: `${base}/images/ensemble-rebowo.svg`,
  'chor-wawrzyczek': `${base}/images/ensemble-wawrzyczek.svg`,
  'zakrecony-band': `${base}/images/ensemble-band.svg`,
};

const captionBySrc: Record<string, string> = {
  [`${base}/images/ensemble-opinogora.svg`]: 'Opinogóra Górna · 2026',
  [`${base}/images/ensembles/opinogora-1.svg`]: 'Opinogóra Górna · Koncert galowy',
  [`${base}/images/ensembles/opinogora-2.svg`]: 'Opinogóra Górna · Festiwal',
  [`${base}/images/ensemble-rebowo.svg`]: 'Rębowo · 2024–2026',
  [`${base}/images/ensembles/rebowo-1.svg`]: 'Rębowo · Próba sekcyjna',
  [`${base}/images/ensembles/rebowo-2.svg`]: 'Rębowo · Przegląd OSP',
  [`${base}/images/ensemble-wawrzyczek.svg`]: 'Olsztyn · Chór UWM',
  [`${base}/images/ensembles/wawrzyczek-1.svg`]: 'Olsztyn · Dzieła oratoryjne · 2024',
  [`${base}/images/ensembles/wawrzyczek-2.svg`]: 'Tournées · Hiszpania / Litwa · 2025',
  [`${base}/images/ensemble-band.svg`]: 'Estrada · Realizacja na żywo',
  [`${base}/images/ensembles/zakrecony-1.svg`]: 'Zakręcony Band · Koncert',
  [`${base}/images/ensembles/zakrecony-2.svg`]: 'Zakręcony Band · Live sound',
  [`${base}/images/ensembles/chorzele-1.svg`]: 'Chorzele · 2022–',
  [`${base}/images/ensembles/chorzele-2.svg`]: 'Chorzele · Oprawa i estrada',
  [`${base}/images/ensembles/arsvocale-1.svg`]: 'Ars Vocale · 2023',
  [`${base}/images/ensembles/arsvocale-2.svg`]: 'Ars Vocale · Kameralistyka',
  [`${base}/images/ensembles/operetka-1.svg`]: 'Mława · Gala operetkowa',
  [`${base}/images/ensembles/operetka-2.svg`]: 'Mława · Strauss / Kálmán',
  [`${base}/images/ensembles/porajeziora-1.svg`]: 'Filharmonia Warmińsko-Mazurska · 2022',
  [`${base}/images/ensembles/porajeziora-2.svg`]: 'Opera Krakowska · 2022',
  [`${base}/images/ensembles/czteryglosy-1.svg`]: 'Cztery Głosy · Sesja wokalna',
  [`${base}/images/ensembles/czteryglosy-2.svg`]: 'Cztery Głosy · Close harmony',
};

const ensemblesPayload = (await getCollection('ensembles')).map((e) => {
  const cover = coverBySlug[e.slug];
  const photos = [...(cover ? [cover] : []), ...e.data.photos.map((p) => (p.startsWith('/') ? `${base}${p}` : p))];
  const uniquePhotos = [...new Set(photos)];
  return {
    slug: e.slug,
    name: e.data.name,
    pillar: e.data.pillar,
    role: e.data.role,
    concertCount: e.data.concertCount,
    highlights: e.data.highlights,
    photos: uniquePhotos,
    captions: uniquePhotos.map((src) => captionBySrc[src] || captionBySrc[e.data.photos.find((p) => src.endsWith(p)) || ''] || `${e.data.name}`),
    bodyText: e.body,
  };
});
---

<aside
  id="ensemble-drawer"
  class="fixed inset-0 z-50 pointer-events-none transition-all duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="drawer-ensemble-name"
  aria-hidden="true"
>
  <div
    id="drawer-backdrop"
    class="absolute inset-0 bg-black/75 opacity-0 transition-opacity duration-300 pointer-events-none"
  ></div>

  <div class="absolute inset-0 overflow-hidden pointer-events-none flex justify-end">
    <div
      id="drawer-panel"
      class="pointer-events-auto w-full md:max-w-xl h-full bg-[#070d1a] border-l border-white/10 flex flex-col transform translate-x-full transition-transform duration-300 ease-out z-10"
    >
      <div class="relative h-52 sm:h-64 flex-shrink-0 border-b border-white/10">
        <img
          id="drawer-cover-image"
          src={`${base}/images/ensemble-opinogora.svg`}
          alt=""
          class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#070d1a] via-[#070d1a]/55 to-transparent"></div>
        <div class="absolute top-4 right-4 z-10">
          <button
            id="drawer-close-btn"
            type="button"
            aria-label="Zamknij panel szczegółów"
            class="p-2 border border-white/15 bg-[#070d1a]/80 text-slate-300 hover:text-white hover:border-sky-400/40 transition-all focus:outline-none focus:ring-2 focus:ring-sky-400"
          >
            <X class="w-5 h-5" />
          </button>
        </div>
        <div class="absolute bottom-5 left-6 right-6">
          <p id="drawer-pillar-badge" class="text-[11px] font-sans uppercase tracking-[0.22em] text-sky-400 mb-2">
            Filar sceniczny
          </p>
          <h3 id="drawer-ensemble-name" class="text-2xl sm:text-3xl font-display font-semibold text-white leading-tight">
            Nazwa formacji
          </h3>
        </div>
      </div>

      <div class="flex-1 overflow-y-auto px-6 sm:px-8 py-7 space-y-8">
        <dl class="border-y border-white/10 divide-y divide-white/10">
          <div class="flex items-baseline justify-between gap-4 py-3.5">
            <dt class="text-[11px] font-sans uppercase tracking-widest text-slate-500">Rola</dt>
            <dd id="drawer-role-text" class="text-sm font-sans font-medium text-slate-200 text-right">Rola w zespole</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-3.5">
            <dt class="text-[11px] font-sans uppercase tracking-widest text-slate-500">Występy</dt>
            <dd id="drawer-concert-count" class="text-sm font-sans text-sky-200 text-right">—</dd>
          </div>
        </dl>

        <div class="space-y-3">
          <h4 class="text-[11px] font-sans uppercase tracking-[0.22em] text-sky-400">Kluczowe momenty</h4>
          <ul id="drawer-highlights-list" class="divide-y divide-white/10 border-t border-b border-white/10">
          </ul>
        </div>

        <div class="space-y-2">
          <h4 class="text-[11px] font-sans uppercase tracking-[0.22em] text-slate-500">Charakterystyka</h4>
          <div id="drawer-description" class="text-sm font-sans font-light text-slate-300 leading-relaxed space-y-3">
          </div>
        </div>

        <div class="space-y-3">
          <div class="flex items-end justify-between gap-4">
            <h4 class="text-[11px] font-sans uppercase tracking-[0.22em] text-sky-400">Kadry i występy</h4>
            <span class="text-[10px] text-slate-500 font-sans tracking-wider uppercase">Powiększ</span>
          </div>
          <div id="drawer-photos-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-px bg-white/10">
          </div>
        </div>
      </div>

      <div class="p-5 border-t border-white/10 bg-[#070d1a] flex items-center justify-between gap-3">
        <a
          href={`${base}/projekty-autorskie`}
          class="text-[11px] uppercase tracking-[0.2em] font-sans text-sky-400 hover:text-sky-300 transition-colors"
        >
          Dzieła autorskie →
        </a>
        <button
          id="drawer-bottom-close-btn"
          type="button"
          class="px-5 py-2.5 text-[11px] uppercase tracking-[0.18em] font-sans text-slate-300 border border-white/15 hover:border-sky-400/40 hover:text-white transition-all"
        >
          Zamknij
        </button>
      </div>
    </div>
  </div>
</aside>

<script define:vars={{ ensemblesPayload }}>
  function setupDrawer() {
    const drawer = document.getElementById('ensemble-drawer');
    const backdrop = document.getElementById('drawer-backdrop');
    const panel = document.getElementById('drawer-panel');
    const closeBtn = document.getElementById('drawer-close-btn');
    const bottomCloseBtn = document.getElementById('drawer-bottom-close-btn');
    const coverEl = document.getElementById('drawer-cover-image');
    const pillarBadge = document.getElementById('drawer-pillar-badge');
    const nameEl = document.getElementById('drawer-ensemble-name');
    const roleEl = document.getElementById('drawer-role-text');
    const countEl = document.getElementById('drawer-concert-count');
    const highlightsEl = document.getElementById('drawer-highlights-list');
    const descEl = document.getElementById('drawer-description');
    const photosGrid = document.getElementById('drawer-photos-grid');

    if (!drawer || !backdrop || !panel || !closeBtn) return;

    const pillarLabels = {
      orkiestry: 'Orkiestry dęte & symfoniczne',
      chory: 'Chóry & zespoły wokalne',
      teatr: 'Scena teatralna & musical',
      estrada: 'Kameralistyka & estrada',
    };

    function resolveEnsemble(detail) {
      if (!detail) return null;
      if (typeof detail === 'string') {
        return ensemblesPayload.find((e) => e.slug === detail) || null;
      }
      const slug = detail.id || detail.slug || detail.ensembleSlug;
      if (slug) {
        return ensemblesPayload.find((e) => e.slug === slug) || null;
      }
      return detail;
    }

    function openDrawer(raw) {
      const data = resolveEnsemble(raw);
      if (!drawer || !backdrop || !panel || !data) return;

      const label = pillarLabels[data.pillar] || 'Formacja sceniczna';
      if (pillarBadge) pillarBadge.textContent = label;
      if (nameEl) nameEl.textContent = data.name;
      if (roleEl) roleEl.textContent = data.role;
      if (countEl) countEl.textContent = data.concertCount;

      const photos = data.photos || [];
      if (coverEl) {
        coverEl.src = photos[0] || '';
        coverEl.alt = `${data.name} — kadr zespołu`;
      }

      if (highlightsEl) {
        highlightsEl.innerHTML = '';
        (data.highlights || []).forEach((item) => {
          const li = document.createElement('li');
          li.className = 'py-3 text-sm text-slate-300 font-sans font-light leading-relaxed';
          li.textContent = item;
          highlightsEl.appendChild(li);
        });
      }

      if (descEl) {
        descEl.innerHTML = data.bodyText
          ? `<p>${data.bodyText}</p>`
          : `<p>Działalność wykonawcza i dyrygencka w repertuarze klasycznym, teatralnym i estradowym.</p>`;
      }

      if (photosGrid) {
        photosGrid.innerHTML = '';
        if (photos.length === 0) {
          photosGrid.innerHTML = `<p class="text-xs text-slate-400 col-span-2 p-4 bg-[#070d1a]">Brak materiałów archiwalnych.</p>`;
        } else {
          photos.forEach((photoUrl, idx) => {
            const caption = (data.captions && data.captions[idx]) || `${data.name}`;
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.setAttribute('data-lightbox-src', photoUrl);
            btn.setAttribute('data-lightbox-alt', caption);
            btn.className = 'group relative overflow-hidden aspect-[16/10] bg-[#0b1528] text-left focus:outline-none focus:ring-2 focus:ring-sky-400';
            btn.innerHTML = `
              <img src="${photoUrl}" alt="${caption}" class="w-full h-full object-cover opacity-85 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500" loading="lazy" />
              <span class="absolute inset-x-0 bottom-0 px-2 py-1.5 bg-gradient-to-t from-[#070d1a] to-transparent text-[10px] font-sans tracking-wide text-slate-300">${caption}</span>
            `;
            photosGrid.appendChild(btn);
          });
        }
      }

      drawer.classList.remove('pointer-events-none');
      drawer.setAttribute('aria-hidden', 'false');
      backdrop.classList.remove('pointer-events-none');
      backdrop.classList.add('opacity-100', 'pointer-events-auto');
      panel.classList.remove('translate-x-full');
      panel.classList.add('translate-x-0');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      if (!drawer || !backdrop || !panel) return;
      backdrop.classList.remove('opacity-100', 'pointer-events-auto');
      backdrop.classList.add('opacity-0', 'pointer-events-none');
      panel.classList.remove('translate-x-0');
      panel.classList.add('translate-x-full');
      drawer.setAttribute('aria-hidden', 'true');
      setTimeout(() => {
        drawer.classList.add('pointer-events-none');
        document.body.style.overflow = '';
      }, 300);
    }

    closeBtn.addEventListener('click', closeDrawer);
    if (bottomCloseBtn) bottomCloseBtn.addEventListener('click', closeDrawer);
    backdrop.addEventListener('click', closeDrawer);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.getAttribute('aria-hidden') === 'false') {
        closeDrawer();
      }
    });

    window.addEventListener('open-ensemble-drawer', (e) => {
      if (e.detail) openDrawer(e.detail);
    });
  }

  setupDrawer();
  document.addEventListener('astro:page-load', setupDrawer);
</script>
