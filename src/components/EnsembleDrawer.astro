---
import { X, Sparkles, Calendar, Award, Maximize2, ArrowUpRight } from 'lucide-astro';
---

<div
  id="ensemble-drawer"
  class="fixed inset-0 z-50 pointer-events-none transition-all duration-300 opacity-0"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <!-- Backdrop -->
  <div
    id="ensemble-drawer-backdrop"
    class="absolute inset-0 bg-black/75 backdrop-blur-sm transition-opacity duration-300 opacity-0 cursor-pointer"
  ></div>

  <!-- Drawer Container -->
  <aside
    id="ensemble-drawer-panel"
    class="absolute right-0 top-0 bottom-0 w-full max-w-xl bg-gradient-to-b from-[#0b1528] via-[#070d1a] to-[#0b1528] border-l border-white/10 shadow-2xl p-6 sm:p-8 flex flex-col justify-between overflow-y-auto transform translate-x-full transition-transform duration-300 ease-out z-10"
  >
    <div class="space-y-6">
      
      <!-- Top Navigation & Close Button -->
      <div class="flex items-center justify-between pb-4 border-b border-white/10">
        <div class="flex items-center gap-2">
          <span
            id="drawer-ensemble-role"
            class="px-3 py-1 rounded-full text-xs font-sans font-bold uppercase tracking-wider bg-sky-950/80 text-sky-300 border border-sky-400/30"
          >
            Rola
          </span>
          <span
            id="drawer-ensemble-category"
            class="text-xs font-sans text-slate-400 uppercase tracking-widest hidden sm:inline"
          >
            Obszar działalności
          </span>
        </div>

        <button
          id="btn-close-ensemble-drawer"
          type="button"
          aria-label="Zamknij panel"
          class="p-2 rounded-full border border-white/10 bg-sky-950/40 text-slate-300 hover:text-white hover:border-sky-400/50 hover:bg-sky-900/50 transition-all focus:outline-none focus:ring-2 focus:ring-sky-400"
        >
          <X class="w-5 h-5" />
        </button>
      </div>

      <!-- Main Titles -->
      <div class="space-y-2">
        <h3
          id="drawer-ensemble-name"
          class="text-2xl sm:text-3xl font-display font-bold text-white tracking-tight leading-tight"
        >
          Nazwa formacji
        </h3>
        <p
          id="drawer-ensemble-dates"
          class="text-sm font-sans text-sky-200/90 font-medium"
        >
          Okres działalności · Występy
        </p>
      </div>

      <!-- Highlights / Osiągnięcia -->
      <div class="space-y-3 pt-2">
        <h4 class="text-xs font-sans font-bold uppercase tracking-[0.2em] text-sky-400 flex items-center gap-1.5">
          <Sparkles class="w-3.5 h-3.5" />
          <span>Kluczowe osiągnięcia</span>
        </h4>
        <ul
          id="drawer-ensemble-highlights"
          class="space-y-2.5 text-sm sm:text-base text-slate-300 font-sans font-light leading-relaxed"
        >
          <!-- Injected dynamically -->
        </ul>
      </div>

      <!-- Description / Opis działalności -->
      <div class="space-y-3 pt-2">
        <h4 class="text-xs font-sans font-bold uppercase tracking-[0.2em] text-slate-400">
          Opis działalności i profil
        </h4>
        <p
          id="drawer-ensemble-description"
          class="text-sm sm:text-base text-slate-300 font-sans font-light leading-relaxed"
        >
          Opis działalności...
        </p>
      </div>

      <!-- Photos Grid -->
      <div class="space-y-3 pt-2">
        <div class="flex items-center justify-between">
          <h4 class="text-xs font-sans font-bold uppercase tracking-[0.2em] text-sky-400">
            Kadry i materiały archiwalne
          </h4>
          <span class="text-[10px] text-slate-500 font-sans uppercase tracking-wider">Kliknij, aby powiększyć</span>
        </div>
        <div
          id="drawer-ensemble-photos"
          class="grid grid-cols-2 gap-3"
        >
          <!-- Injected dynamically -->
        </div>
      </div>

    </div>

    <!-- Bottom Footer Info -->
    <div class="pt-6 mt-6 border-t border-white/10 flex items-center justify-between text-xs text-slate-400 font-sans">
      <span>Kacper Czeczot · Portfolio Artystyczne</span>
      <span class="text-sky-400 font-mono">✦ Archiwum</span>
    </div>
  </aside>
</div>

<script>
  const drawer = document.getElementById('ensemble-drawer');
  const backdrop = document.getElementById('ensemble-drawer-backdrop');
  const panel = document.getElementById('ensemble-drawer-panel');
  const btnClose = document.getElementById('btn-close-ensemble-drawer');

  const elRole = document.getElementById('drawer-ensemble-role');
  const elCategory = document.getElementById('drawer-ensemble-category');
  const elName = document.getElementById('drawer-ensemble-name');
  const elDates = document.getElementById('drawer-ensemble-dates');
  const elHighlights = document.getElementById('drawer-ensemble-highlights');
  const elDesc = document.getElementById('drawer-ensemble-description');
  const elPhotos = document.getElementById('drawer-ensemble-photos');

  function openDrawer(detail: any) {
    if (!drawer || !backdrop || !panel) return;

    if (elRole) elRole.textContent = detail.role || 'Wykonawca / Dyrygent';
    if (elCategory) elCategory.textContent = detail.categoryName || '';
    if (elName) elName.textContent = detail.name || '';
    if (elDates) elDates.textContent = detail.concertCount || detail.dates || '';
    if (elDesc) elDesc.textContent = detail.body || detail.description || 'Działalność wykonawcza i dyrygencka.';

    if (elHighlights) {
      elHighlights.innerHTML = '';
      const highlights = detail.highlights || [];
      if (highlights.length > 0) {
        highlights.forEach((h: string) => {
          const li = document.createElement('li');
          li.className = 'flex items-start gap-2 text-slate-300';
          li.innerHTML = `<span class="text-sky-400 font-bold mt-0.5">✦</span><span>${h}</span>`;
          elHighlights.appendChild(li);
        });
      } else {
        elHighlights.innerHTML = '<li class="text-slate-500 text-xs">Brak wyszczególnionych punktów.</li>';
      }
    }

    if (elPhotos) {
      elPhotos.innerHTML = '';
      const photos = detail.photos || [];
      if (photos.length === 0) {
        elPhotos.innerHTML = '<p class="text-xs text-slate-500 col-span-2">Brak materiałów archiwalnych.</p>';
      } else {
        photos.forEach((p: string, pIdx: number) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.setAttribute('data-lightbox-src', p);
          btn.setAttribute('data-lightbox-alt', `${detail.name} — fotografia archiwalna`);
          btn.className = 'group relative aspect-[16/10] overflow-hidden rounded-xl border border-white/15 bg-[#0b1528] focus:outline-none focus:ring-2 focus:ring-sky-400 text-left shadow-md';
          btn.innerHTML = `
            <img src="${p}" alt="${detail.name}" class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#070d1a]/90 via-transparent to-black/30 flex flex-col justify-between p-2">
              <span class="self-start text-[9px] font-sans font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-black/60 backdrop-blur-md text-sky-300 border border-white/10">
                Kadr ${pIdx + 1}
              </span>
              <div class="flex items-center gap-1 text-[11px] text-white font-medium opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                <svg class="w-3.5 h-3.5 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                <span>Powiększ</span>
              </div>
            </div>
          `;
          elPhotos.appendChild(btn);
        });
      }
    }

    // Open animations
    drawer.classList.remove('pointer-events-none', 'opacity-0');
    drawer.classList.add('pointer-events-auto', 'opacity-100');
    drawer.setAttribute('aria-hidden', 'false');

    backdrop.classList.remove('opacity-0');
    backdrop.classList.add('opacity-100');

    panel.classList.remove('translate-x-full');
    panel.classList.add('translate-x-0');

    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    if (!drawer || !backdrop || !panel) return;

    panel.classList.remove('translate-x-0');
    panel.classList.add('translate-x-full');

    backdrop.classList.remove('opacity-100');
    backdrop.classList.add('opacity-0');

    setTimeout(() => {
      drawer.classList.remove('pointer-events-auto', 'opacity-100');
      drawer.classList.add('pointer-events-none', 'opacity-0');
      drawer.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }, 300);
  }

  window.addEventListener('open-ensemble-drawer', ((e: CustomEvent) => {
    if (e.detail) {
      openDrawer(e.detail);
    }
  }) as EventListener);

  if (btnClose) btnClose.addEventListener('click', closeDrawer);
  if (backdrop) backdrop.addEventListener('click', closeDrawer);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeDrawer();
    }
  });
</script>
