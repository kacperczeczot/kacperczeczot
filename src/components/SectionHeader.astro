---
interface Props {
  badge: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}

const {
  badge,
  title,
  subtitle,
  align = 'center',
} = Astro.props;
---

<div class={`space-y-4 ${align === 'center' ? 'text-center max-w-3xl mx-auto' : 'text-left max-w-2xl'}`}>
  <!-- Badge -->
  <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-sky-200 bg-sky-50 text-sky-700 text-xs font-semibold uppercase tracking-wider font-display">
    <span class="w-1.5 h-1.5 rounded-full bg-sky-500 animate-pulse"></span>
    <span>{badge}</span>
  </div>

  <!-- Heading -->
  <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold tracking-tight text-slate-900">
    {title}
  </h2>

  <!-- Subtitle -->
  {subtitle && (
    <p class="text-base sm:text-lg text-slate-600 font-normal leading-relaxed">
      {subtitle}
    </p>
  )}

  <div class={`flex items-center gap-3 pt-1 opacity-50 ${align === 'center' ? 'justify-center' : 'justify-start'}`}>
    <div class="w-10 h-[1.5px] bg-gradient-to-r from-transparent to-sky-500"></div>
    <span class="text-sky-600 text-xs">✦</span>
    <div class="w-10 h-[1.5px] bg-gradient-to-l from-transparent to-sky-500"></div>
  </div>
</div>
