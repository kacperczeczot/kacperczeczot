---
interface Props {
  badge: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}

const {
  badge,
  title,
  subtitle,
  align = 'center',
} = Astro.props;
---

<div class={`space-y-4 ${align === 'center' ? 'text-center max-w-3xl mx-auto' : 'text-left max-w-2xl'}`}>
  <p class="text-xs font-sans uppercase tracking-[0.28em] text-sky-400">
    {badge}
  </p>

  <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-semibold tracking-tight text-white">
    {title}
  </h2>

  {subtitle && (
    <p class="text-base sm:text-lg text-slate-400 font-sans font-light leading-relaxed">
      {subtitle}
    </p>
  )}

  <div class={`flex items-center gap-3 pt-1 ${align === 'center' ? 'justify-center' : 'justify-start'}`}>
    <div class="w-12 h-px bg-white/15"></div>
  </div>
</div>
