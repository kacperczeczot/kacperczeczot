---
const credentials = [
  { value: '300+', label: 'WYSTĘPÓW' },
  { value: '4', label: 'OBSZARY DZIAŁALNOŚCI' },
  { value: 'UWM', label: 'WYRÓŻNIENIE I NAGRODA' },
  { value: 'PSM', label: 'FORTEPIAN I WOKALISTYKA' },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="relative pt-28 pb-16 md:pt-36 md:pb-24 border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-end">

      <div class="lg:col-span-7 space-y-8">
        <p class="text-xs sm:text-sm font-sans tracking-[0.24em] uppercase text-sky-400 font-semibold">
          KC · Portfolio artystyczne
        </p>

        <h1 class="font-display text-5xl sm:text-6xl font-bold text-white tracking-tight leading-tight">
          Kacper Czeczot
        </h1>

        <p class="max-w-xl text-base sm:text-lg text-slate-300 font-sans font-light leading-relaxed">
          Dyrygentura symfoniczna i chóralna, wykonawstwo sceniczne oraz realizacja dźwięku.
          Warsztat łączący filharmonię, teatr muzyczny i studio nagraniowe.
        </p>

        <a
          href="#drzewo-radialne"
          class="inline-flex items-center gap-3 border border-white/15 px-7 py-3.5 text-sm font-sans uppercase tracking-[0.2em] font-semibold text-white hover:border-sky-400/50 hover:text-sky-200 editorial-hover transition-all"
        >
          <span>Eksploruj dorobek</span>
          <span aria-hidden="true" class="text-sky-400">→</span>
        </a>
      </div>

      <div class="lg:col-span-5">
        <figure class="space-y-3">
          <div class="border border-white/10 overflow-hidden bg-[#0b1528]">
            <img
              src={`${base}/images/hero-portrait.svg`}
              alt="Portret sceniczny — sylwetka dyrygenta w świetle rampy"
              class="w-full aspect-[4/5] object-cover"
            />
          </div>
          <figcaption class="flex items-baseline justify-between gap-4 text-xs font-sans tracking-wider uppercase text-slate-400">
            <span class="font-sans text-xs sm:text-sm tracking-wide text-sky-200/90 font-medium normal-case">
              Dyrygentura · Wykonawstwo Sceniczne · Realizacja Dźwięku
            </span>
            <span class="hidden sm:inline font-mono text-slate-500 text-xs">01</span>
          </figcaption>
        </figure>
      </div>
    </div>

    <!-- Pasek statystyk pod Hero -->
    <ul class="mt-16 pt-8 border-t border-white/10 grid grid-cols-2 lg:grid-cols-4">
      {credentials.map((item, idx) => (
        <li class={`py-4 px-4 sm:px-6 ${idx % 2 === 0 ? 'border-r border-white/10' : ''} lg:border-r lg:border-white/10 lg:last:border-r-0 ${idx >= 2 ? 'border-t border-white/10 lg:border-t-0' : ''}`}>
          <p class="font-display font-bold text-3xl sm:text-4xl text-white tracking-tight">{item.value}</p>
          <p class="mt-2 text-xs sm:text-sm font-sans uppercase tracking-wider text-slate-300 font-semibold">{item.label}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
