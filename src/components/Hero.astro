---
import { Music2, ChevronRight, Award, Layers, Sparkles } from 'lucide-astro';

const credentials = [
  { value: '300+', label: 'Występów Scenicznych', detail: 'Orkiestry, chóry, teatr i estrada' },
  { value: '4', label: 'Filary Wykonawcze', detail: 'Orkiestry, Chóry, Teatr, Estrada' },
  { value: 'UWM', label: 'Dyplom z Wyróżnieniem', detail: 'Dyrygentura i edukacja muzyczna' },
  { value: 'PSM I & II', label: 'Szkoły Muzyczne', detail: 'Klarnet, fortepian i teoria' },
];
---

<section class="relative pt-36 pb-20 md:pt-48 md:pb-28 overflow-hidden">
  
  <!-- Soft Azure Ambient Spotlight -->
  <div class="absolute top-12 left-1/2 -translate-x-1/2 w-[800px] h-[450px] bg-gradient-radial from-sky-200/50 via-blue-100/20 to-transparent blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    
    <!-- Artistic Subtitle Badge -->
    <div class="inline-flex items-center gap-2.5 px-5 py-2 rounded-full border border-sky-200 bg-white/90 shadow-azure-sm mb-8">
      <span class="w-2 h-2 rounded-full bg-sky-500 animate-pulse"></span>
      <span class="text-xs sm:text-sm font-semibold tracking-wide text-sky-800 uppercase font-display">
        Dyrygentura • Wykonawstwo Sceniczne • Produkcja Muzyczna
      </span>
      <span class="w-2 h-2 rounded-full bg-sky-500 animate-pulse"></span>
    </div>

    <!-- Artist Name -->
    <h1 class="text-5xl sm:text-7xl lg:text-8xl font-display font-extrabold tracking-tight text-slate-900 mb-6 leading-none">
      <span class="block text-azure">Kacper</span>
      <span class="block text-slate-900 mt-1">Czeczot</span>
    </h1>

    <!-- Decorative Philharmonic Divider -->
    <div class="flex items-center justify-center gap-4 my-6 opacity-60 max-w-xs mx-auto">
      <div class="h-[1.5px] flex-1 bg-gradient-to-r from-transparent via-sky-500 to-transparent"></div>
      <span class="text-sky-600 text-xs font-serif">✦</span>
      <div class="h-[1.5px] flex-1 bg-gradient-to-r from-transparent via-sky-500 to-transparent"></div>
    </div>

    <!-- Description -->
    <p class="text-lg sm:text-xl text-slate-600 max-w-3xl mx-auto font-sans leading-relaxed mb-12 font-normal">
      Działalność muzyczna, wykonawcza i dyrygencka: prowadzenie orkiestr i chórów, występy teatralno-musicalowe, dzieła autorskie oraz zaplecze studyjne i inżynieria dźwięku.
    </p>

    <!-- CTA Actions -->
    <div class="flex flex-wrap items-center justify-center gap-4 mb-16">
      <a
        href="#drzewo-radialne"
        class="inline-flex items-center gap-2.5 px-8 py-4 rounded-xl font-display text-sm tracking-wide font-bold text-white bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-600 hover:to-blue-700 shadow-azure-md hover:shadow-azure-lg transition-all duration-300 hover:scale-105 active:scale-95"
      >
        <Music2 class="w-4 h-4 text-white" />
        <span>Eksploruj Scenę & Zespoły</span>
      </a>
      <a
        href="/projekty-autorskie"
        class="inline-flex items-center gap-2.5 px-8 py-4 rounded-xl font-display text-sm tracking-wide font-semibold text-slate-700 bg-white border border-slate-200 hover:border-sky-300 hover:bg-sky-50/50 hover:text-sky-700 transition-all duration-300 shadow-card active:scale-95"
      >
        <span>Dzieła Autorskie & Wideo</span>
        <ChevronRight class="w-4 h-4 text-sky-600" />
      </a>
    </div>

    <!-- Credentials Grid (High Contrast Azure Cards) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 max-w-5xl mx-auto pt-6 border-t border-slate-200">
      {credentials.map((item) => (
        <div class="azure-card p-6 rounded-2xl text-center group hover:border-sky-300 transition-all duration-300">
          <div class="font-display font-extrabold text-2xl sm:text-3xl text-azure mb-1 group-hover:scale-105 transition-transform">
            {item.value}
          </div>
          <div class="font-display font-bold text-xs sm:text-sm text-slate-800 tracking-wide mb-1">
            {item.label}
          </div>
          <div class="text-[12px] text-slate-500 font-sans">
            {item.detail}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
