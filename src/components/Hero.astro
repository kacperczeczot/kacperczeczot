---
import homeData from '../data/home.json';

const credentials = homeData.credentials || [
  { value: '300+', label: 'Występów scenicznych' },
  { value: '20+', label: 'Zespołów i formacji' },
  { value: '6', label: 'Krajów tras koncertowych' },
  { value: '3', label: 'Dyplomy z wyróżnieniem' },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const heroImage = homeData.heroImage ? (homeData.heroImage.startsWith('/') ? `${base}${homeData.heroImage}` : homeData.heroImage) : `${base}/images/hero-portrait.svg`;
---

<section class="relative pt-28 pb-16 md:pt-36 md:pb-24 border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-end">

      <div class="lg:col-span-7 space-y-6">
        <div>
          <h1 class="text-4xl sm:text-6xl lg:text-7xl font-bold font-sans text-white tracking-tight">
            {homeData.heroName || 'Kacper Czeczot'}
          </h1>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-sky-400 font-sans tracking-tight mt-3">
            {homeData.heroRole || 'Dyrygent · Multiinstrumentalista · Aranżer'}
          </h2>
        </div>

        <p class="max-w-xl text-base sm:text-lg text-slate-300 font-sans font-light leading-relaxed">
          {homeData.heroIntro || 'Dyrygentura symfoniczna i chóralna, wykonawstwo sceniczne oraz autorskie opracowania partytur. Warsztat łączący salę koncertową, teatr muzyczny i studio nagraniowe.'}
        </p>

        <div class="pt-2">
          <a
            href="#drzewo-radialne"
            class="inline-flex items-center gap-3 border border-white/15 px-7 py-3.5 text-sm font-sans uppercase tracking-[0.2em] font-semibold text-white hover:border-sky-400/50 hover:text-sky-200 editorial-hover transition-all"
          >
            <span>Eksploruj dorobek</span>
            <span aria-hidden="true" class="text-sky-400">→</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <figure class="space-y-3">
          <div class="border border-white/10 overflow-hidden bg-[#0b1528]">
            <img
              src={heroImage}
              alt="Portret sceniczny — sylwetka dyrygenta w świetle rampy"
              class="w-full aspect-[4/5] object-cover"
            />
          </div>
          
        </figure>
      </div>
    </div>

    <!-- Pasek 4 wskaźników dorobku -->
    <ul class="mt-16 pt-8 border-t border-white/10 grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-0">
      {credentials.map((item, idx) => (
        <li class={`py-4 px-4 sm:px-6 ${idx % 2 === 0 ? 'border-r border-white/10' : ''} lg:border-r lg:border-white/10 lg:last:border-r-0 ${idx >= 2 ? 'border-t border-white/10 lg:border-t-0' : ''}`}>
          <p class="text-4xl sm:text-5xl font-extrabold text-white font-sans tracking-tight tabular-nums">
            {item.value}
          </p>
          <p class="text-[11px] sm:text-xs font-semibold uppercase tracking-widest text-slate-400 mt-2 font-sans">
            {item.label}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>
