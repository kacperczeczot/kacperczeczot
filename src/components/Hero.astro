---
const credentials = [
  { value: '300+', label: 'Występów scenicznych' },
  { value: '4', label: 'Filary działalności' },
  { value: 'UWM', label: 'Najlepszy Absolwent' },
  { value: 'PSM', label: 'Fortepian i wokalistyka' },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="relative pt-28 pb-16 md:pt-36 md:pb-24 border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-end">

      <div class="lg:col-span-7 space-y-8">
        <p class="text-xs font-sans tracking-[0.28em] uppercase text-sky-400">
          KC · Portfolio artystyczne
        </p>

        <h1 class="font-display font-semibold text-white leading-[0.92] tracking-tight text-6xl sm:text-7xl lg:text-8xl">
          <span class="italic text-sky-200/90">Kacper</span>
          <span class="block mt-1">Czeczot</span>
        </h1>

        <p class="max-w-xl text-base sm:text-lg text-slate-300 font-sans font-light leading-relaxed">
          Dyrygentura symfoniczna i chóralna, wykonawstwo sceniczne oraz realizacja dźwięku.
          Warsztat łączący filharmonię, teatr muzyczny i studio nagraniowe.
        </p>

        <a
          href="#drzewo-radialne"
          class="inline-flex items-center gap-3 border border-white/15 px-7 py-3.5 text-xs font-sans uppercase tracking-[0.22em] text-white hover:border-sky-400/50 hover:text-sky-200 editorial-hover"
        >
          <span>Eksploruj dorobek</span>
          <span aria-hidden="true" class="text-sky-400">→</span>
        </a>
      </div>

      <div class="lg:col-span-5">
        <figure class="space-y-3">
          <div class="border border-white/10 overflow-hidden bg-[#0b1528]">
            <img
              src={`${base}/images/hero-portrait.svg`}
              alt="Portret sceniczny — sylwetka dyrygenta w świetle rampy"
              class="w-full aspect-[4/5] object-cover"
            />
          </div>
          <figcaption class="flex items-baseline justify-between gap-4 text-[11px] font-sans tracking-widest uppercase text-slate-400">
            <span class="italic font-display text-sm tracking-normal normal-case text-sky-200/70">
              Dyrygentura · Wykonawstwo Sceniczne · Realizacja Dźwięku
            </span>
            <span class="hidden sm:inline">01</span>
          </figcaption>
        </figure>
      </div>
    </div>

    <ul class="mt-16 pt-8 border-t border-white/10 grid grid-cols-2 lg:grid-cols-4 gap-px bg-white/10">
      {credentials.map((item) => (
        <li class="bg-[#070d1a] px-5 py-6">
          <p class="font-display text-3xl sm:text-4xl text-white">{item.value}</p>
          <p class="mt-2 text-[11px] font-sans uppercase tracking-widest text-slate-400">{item.label}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
