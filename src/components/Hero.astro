---
import { Music, Radio, ChevronDown, Sparkles, Award, Layers, Disc3 } from 'lucide-astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const stats = [
  { value: '300+', label: 'Występów Scenicznych', icon: Award, accent: 'text-amber-400 border-amber-500/30' },
  { value: '9+', label: 'Zespołów & Instytucji', icon: Layers, accent: 'text-sky-400 border-sky-500/30' },
  { value: '20+', label: 'Lat na Scenie i w Studiu', icon: Music, accent: 'text-fuchsia-400 border-fuchsia-500/30' },
  { value: '100%', label: 'Pasji & Precyzji', icon: Sparkles, accent: 'text-emerald-400 border-emerald-500/30' },
];
---

<section class="relative pt-32 pb-16 md:pt-40 md:pb-20 overflow-hidden">
  <!-- Glowing Background Orbs -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] bg-gradient-radial from-amber-500/15 via-amber-600/5 to-transparent blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute top-1/3 left-1/4 w-[400px] h-[300px] bg-gradient-radial from-cyan-500/10 via-teal-600/5 to-transparent blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <!-- Top Identity Pill -->
    <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full border border-amber-500/30 bg-zinc-900/90 shadow-glow-amber mb-8 animate-float">
      <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
      <span class="text-xs sm:text-sm font-mono font-medium text-zinc-300">
        Dyrygentura • Wykonawstwo • Produkcja Muzyczna • Software
      </span>
    </div>

    <!-- Main Hero Heading -->
    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-display font-extrabold tracking-tight text-zinc-100 max-w-5xl mx-auto leading-[1.1] mb-6">
      Sztuka Sceniczna, <br class="hidden sm:block" />
      <span class="bg-gradient-to-r from-amber-300 via-amber-400 to-amber-600 bg-clip-text text-transparent text-glow-amber">
        Dyscyplina Symfoniczna
      </span>
      <br />
      & Precyzja Technologii
    </h1>

    <!-- Subtitle Description -->
    <p class="text-lg sm:text-xl text-zinc-400 max-w-3xl mx-auto font-sans leading-relaxed mb-10">
      Przestrzeń artystycznego dorobku dyrygenckiego, orkiestrowego i teatralnego, uzupełniona o autorskie produkcje muzyczne oraz innowacyjne zaplecze technologiczno-laboratoryjne.
    </p>

    <!-- CTA Actions -->
    <div class="flex flex-wrap items-center justify-center gap-4 mb-16">
      <a
        href="#drzewo-radialne"
        class="flex items-center gap-2.5 px-6 py-3.5 rounded-xl font-semibold text-zinc-950 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 shadow-glow-amber hover:shadow-glow-amber-lg transition-all active:scale-95"
      >
        <Disc3 class="w-5 h-5 animate-spin-reverse-slow" />
        <span>Eksploruj Drzewo Radialne</span>
      </a>
      <a
        href={`${base}/projekty-autorskie`}
        class="flex items-center gap-2.5 px-6 py-3.5 rounded-xl font-medium text-zinc-200 bg-zinc-900/90 border border-zinc-800 hover:border-zinc-700 hover:bg-zinc-850 hover:text-white transition-all shadow-md active:scale-95"
      >
        <Radio class="w-5 h-5 text-amber-400" />
        <span>Dzieła Autorskie & Wideo</span>
      </a>
    </div>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-5xl mx-auto pt-4">
      {stats.map((item) => {
        const Icon = item.icon;
        return (
          <div class="glass-card p-5 rounded-2xl border border-zinc-800/80 hover:border-zinc-700 transition-all text-center group">
            <div class="flex items-center justify-center mb-2">
              <span class={`p-2 rounded-xl bg-zinc-900 border ${item.accent} group-hover:scale-110 transition-transform`}>
                <Icon class="w-5 h-5" />
              </span>
            </div>
            <div class="font-display font-bold text-2xl sm:text-3xl text-zinc-100 mb-0.5">
              {item.value}
            </div>
            <div class="text-xs text-zinc-400 font-sans font-medium">
              {item.label}
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>
