---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import EnsembleDrawer from '../components/EnsembleDrawer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Kacper Czeczot — Dyrygent, Muzyk & Reżyser Dźwięku',
  description = 'Oficjalne portfolio artystyczne Kacpra Czeczota: dyrygentura symfoniczna i chóralna, wykonawstwo sceniczne, autorskie produkcje muzyczne oraz warsztat twórczy.',
  image = '/images/og-cover.svg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://kacperczeczot.github.io');
---

<!doctype html>
<html lang="pl" class="scroll-smooth bg-[#070709] text-zinc-100 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <!-- SEO & Metadata -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Kacper Czeczot" />
    <meta name="theme-color" content="#070709" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Google Fonts: Cormorant Garamond, Cinzel, Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800;900&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col bg-[#070709] text-[#f3f3f5] selection:bg-[#e2ba64]/30 selection:text-[#faecd0] relative overflow-x-hidden">
    
    <!-- Theatrical Spotlight Beam from Top -->
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[650px] bg-stage-spotlight pointer-events-none -z-10 animate-spotlight"></div>
    <div class="fixed -top-40 right-1/4 w-[500px] h-[500px] bg-[#e2ba64]/5 rounded-full blur-[160px] pointer-events-none -z-10"></div>
    <div class="fixed -bottom-40 left-1/4 w-[600px] h-[600px] bg-[#997327]/5 rounded-full blur-[180px] pointer-events-none -z-10"></div>

    <!-- Navigation -->
    <Navbar />

    <!-- Main Content Container -->
    <main class="flex-1 w-full relative">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Global Components -->
    <EnsembleDrawer />
    <Lightbox />
  </body>
</html>
